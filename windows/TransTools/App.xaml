<Application x:Class="TransTools.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:TransTools.Views" xmlns:experience="clr-namespace:TransTools.Services.Experience"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
 <Style x:Key="ChatSelectableText" TargetType="TextBox">
  <Setter Property="IsReadOnly" Value="True"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="0"/><Setter Property="MinHeight" Value="0"/><Setter Property="Cursor" Value="IBeam"/><Setter Property="SelectionBrush" Value="#75BBAE"/><Setter Property="VerticalContentAlignment" Value="Top"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><ScrollViewer x:Name="PART_ContentHost" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled"/></ControlTemplate></Setter.Value></Setter>
 </Style>
 <DataTemplate x:Key="ConversationBubble">
  <Border Tag="ChatBubble" CornerRadius="16" Padding="13" VerticalAlignment="Top" BorderBrush="#BDD9D0" BorderThickness="1">
   <Border.Style><Style TargetType="Border"><Setter Property="Margin" Value="0,0,48,14"/><Setter Property="Background" Value="#FAFCFB"/><Setter Property="HorizontalAlignment" Value="Left"/><Style.Triggers><DataTrigger Binding="{Binding IsUser}" Value="True"><Setter Property="Background" Value="#DCEEE8"/><Setter Property="HorizontalAlignment" Value="Right"/><Setter Property="Margin" Value="48,0,0,14"/></DataTrigger></Style.Triggers></Style></Border.Style>
   <StackPanel>
    <DockPanel Margin="0,0,0,7" LastChildFill="True">
     <TextBlock DockPanel.Dock="Right" Text="{Binding TimeString}" Foreground="#73827C" FontSize="11" VerticalAlignment="Center" Margin="16,0,0,0"/>
     <StackPanel Orientation="Horizontal">
      <Border Background="#DCEEE8" CornerRadius="20" Width="40" Height="40" Margin="0,0,7,0"><Grid>
       <Image Source="/TransTools;component/Resources/Mascot/MascotWalking.png" Width="30" Height="30"><Image.Style><Style TargetType="Image"><Style.Triggers><DataTrigger Binding="{Binding IsUser}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Image.Style></Image>
       <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="26" Foreground="#65756F" VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsUser}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
      </Grid></Border>
      <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#287568" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="{Binding DisplayName,Source={x:Static experience:AssistantIdentity.Shared}}"/><Style.Triggers><DataTrigger Binding="{Binding IsUser}" Value="True"><Setter Property="Text" Value="Bạn"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
     </StackPanel>
    </DockPanel>
    <TextBox Style="{StaticResource ChatSelectableText}" Text="{Binding Text,Mode=OneWay}" FontSize="15" Foreground="#243D35" AutomationProperties.Name="Nội dung trò chuyện"/>
    <StackPanel Margin="0,7,0,0"><StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers><DataTrigger Binding="{Binding Translation}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding DataContext.ShowVietnameseTranslation,RelativeSource={RelativeSource AncestorType=ListBox}}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding DataContext.CanShowTranslation,RelativeSource={RelativeSource AncestorType=ListBox}}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></StackPanel.Style><Border Height="1" Background="#CBDCD5" Margin="0,0,0,7"/><TextBox Style="{StaticResource ChatSelectableText}" Text="{Binding Translation,Mode=OneWay}" FontSize="14" Foreground="#65756F" AutomationProperties.Name="Bản dịch trò chuyện"/></StackPanel>
   </StackPanel>
  </Border>
 </DataTemplate>
         <Style TargetType="Window"><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontSize" Value="14"/><Setter Property="Foreground" Value="#292F2D"/></Style>
         <ui:ProviderLabelConverter x:Key="ProviderLabel"/><ui:LanguageLabelConverter x:Key="LanguageLabel"/><ui:OptionSelectionConverter x:Key="OptionSelection"/>
         <ui:LanguageFlagConverter x:Key="LanguageFlag"/>
         <DataTemplate x:Key="LanguageItem"><StackPanel Orientation="Horizontal"><Image Source="{Binding Converter={StaticResource LanguageFlag}}" Width="20" Height="14" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,7,0" IsHitTestVisible="False"/><TextBlock Text="{Binding Converter={StaticResource LanguageLabel}}" VerticalAlignment="Center"/></StackPanel></DataTemplate>
         <DataTemplate x:Key="CompactLanguageItem"><StackPanel Orientation="Horizontal"><Image Source="{Binding Converter={StaticResource LanguageFlag}}" Width="20" Height="14" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,7,0" IsHitTestVisible="False"/><TextBlock FontSize="11" FontWeight="Bold" Text="{Binding Converter={StaticResource LanguageLabel},ConverterParameter=short}" VerticalAlignment="Center"/></StackPanel></DataTemplate>
         <ui:CaptionDisplayTextConverter x:Key="CaptionDisplayText"/>
         <BooleanToVisibilityConverter x:Key="BoolVisibility"/>
         <Style TargetType="Button">
             <Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/>
             <Setter Property="FontSize" Value="12.5"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="MinHeight" Value="40"/><Setter Property="Padding" Value="16,6"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Background" Value="#287568"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#75BBAE"/><Setter Property="BorderThickness" Value="1"/>
             <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                 <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                     <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True"/>
                 </Border>
                 <ControlTemplate.Triggers><Trigger Property="MinHeight" Value="26"><Setter TargetName="Chrome" Property="CornerRadius" Value="6"/></Trigger><Trigger Property="MinHeight" Value="28"><Setter TargetName="Chrome" Property="CornerRadius" Value="8"/></Trigger><Trigger Property="MinHeight" Value="30"><Setter TargetName="Chrome" Property="CornerRadius" Value="8"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#287568"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.72"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#194F45"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers>
             </ControlTemplate></Setter.Value></Setter>
             <Style.Triggers>
                 <Trigger Property="MinHeight" Value="26"><Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="Medium"/><Setter Property="Padding" Value="10,4"/></Trigger>
                 <Trigger Property="MinHeight" Value="28"><Setter Property="FontSize" Value="12"/><Setter Property="Padding" Value="12,4"/></Trigger>
                 <Trigger Property="MinHeight" Value="30"><Setter Property="FontSize" Value="12"/><Setter Property="Padding" Value="12,4"/></Trigger>
             </Style.Triggers>
         </Style>
         <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
             <Setter Property="Background" Value="#EAF4F0"/><Setter Property="Foreground" Value="#287568"/><Setter Property="BorderBrush" Value="#A8CEC3"/>
         </Style>
         <Style x:Key="DestructiveButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
             <Setter Property="Background" Value="#FFF1F2"/><Setter Property="Foreground" Value="#DC2626"/><Setter Property="BorderBrush" Value="#FECDD3"/>
         </Style>
         <Style x:Key="PageHeading" TargetType="TextBlock"><Setter Property="FontSize" Value="20"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Foreground" Value="#292F2D"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
         <Style x:Key="PageDescription" TargetType="TextBlock"><Setter Property="FontSize" Value="12.5"/><Setter Property="Foreground" Value="#65756F"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
         <Style x:Key="TranscriptCard" TargetType="Border">
             <Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#C2DDD5"/><Setter Property="BorderThickness" Value="1"/>
             <Setter Property="CornerRadius" Value="14"/><Setter Property="Padding" Value="16"/>
             <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="BorderBrush" Value="#75BBAE"/></Trigger></Style.Triggers>
         </Style>
         <Style TargetType="ScrollBar">
             <Setter Property="Width" Value="10"/><Setter Property="Background" Value="Transparent"/>
             <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
                 <Grid Background="Transparent"><Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="{TemplateBinding Orientation}" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}">
                     <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
                     <Track.Thumb><Thumb x:Name="ScrollThumb" MinHeight="28"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#B6C9C2" CornerRadius="4" Margin="2"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
                     <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton>
                 </Track></Grid>
                 <ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0"/></Trigger></ControlTemplate.Triggers>
             </ControlTemplate></Setter.Value></Setter>
             <Style.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter Property="Width" Value="Auto"/><Setter Property="Height" Value="10"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
                 <Grid Background="Transparent"><Track x:Name="PART_Track" IsDirectionReversed="False" Orientation="{TemplateBinding Orientation}" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}">
                     <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageLeftCommand" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
                     <Track.Thumb><Thumb x:Name="ScrollThumb" MinWidth="28"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#B6C9C2" CornerRadius="4" Margin="2"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
                     <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageRightCommand" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton>
                 </Track></Grid>
                 <ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0"/></Trigger></ControlTemplate.Triggers>
             </ControlTemplate></Setter.Value></Setter></Trigger></Style.Triggers>
         </Style>

         <Style TargetType="ComboBox">
             <Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#243D35"/><Setter Property="BorderBrush" Value="#B5D2C9"/><Setter Property="MinHeight" Value="40"/><Setter Property="Padding" Value="10,6"/>
             <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
             <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
                 <Grid>
                     <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="10"/>
                     <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}" Cursor="Hand">
                         <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="Transparent"/></ControlTemplate></ToggleButton.Template>
                     </ToggleButton>
                     <ContentPresenter x:Name="SelectedLanguageContent" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" Margin="10,6,34,6" VerticalAlignment="Center"/>
                     <Border Width="24" Height="26" Background="#E0EFE9" CornerRadius="6" HorizontalAlignment="Right" Margin="0,0,5,0" IsHitTestVisible="False"><Path Data="M 0 0 L 4 4 L 8 0" Stroke="#287568" StrokeThickness="1.8" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                     <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="None">
                         <Border Background="White" BorderBrush="#75BBAE" BorderThickness="1" CornerRadius="10" MinWidth="{Binding ActualWidth,RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="{TemplateBinding MaxDropDownHeight}" Margin="0,3,0,0" Padding="4">
                             <ScrollViewer CanContentScroll="True"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
                         </Border>
                     </Popup>
                 </Grid>
                 <ControlTemplate.Triggers><Trigger Property="Tag" Value="compact-language"><Setter TargetName="SelectedLanguageContent" Property="ContentTemplate" Value="{StaticResource CompactLanguageItem}"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#75BBAE"/></Trigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#287568"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers>
             </ControlTemplate></Setter.Value></Setter>
         </Style>
         <Style TargetType="ComboBoxItem">
             <Setter Property="Padding" Value="10,7"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
             <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="ItemChrome" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemChrome" Property="Background" Value="#E0EFE9"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemChrome" Property="Background" Value="#D0E7DF"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
         </Style>
         <Style TargetType="Slider">
             <Setter Property="MinHeight" Value="28"/><Setter Property="VerticalContentAlignment" Value="Center"/>
             <Setter Property="Foreground" Value="#287568"/><Setter Property="Background" Value="#DCE9E4"/>
             <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider">
                 <Grid x:Name="SliderChrome" Background="Transparent" MinHeight="28">
                     <Border Height="3" VerticalAlignment="Center" Background="{TemplateBinding Background}" CornerRadius="1.5" Margin="9,0"/>
                     <Track x:Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" Orientation="{TemplateBinding Orientation}" IsDirectionReversed="{TemplateBinding IsDirectionReversed}">
                         <Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Height="3" Background="#287568" VerticalAlignment="Center" CornerRadius="1.5"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
                         <Track.Thumb><Thumb x:Name="SliderThumb" Width="18" Height="18" Cursor="Hand"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border x:Name="ThumbChrome" Background="White" BorderBrush="#A8CEC3" BorderThickness="1" CornerRadius="9"/><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ThumbChrome" Property="BorderBrush" Value="#287568"/></Trigger><Trigger Property="IsDragging" Value="True"><Setter TargetName="ThumbChrome" Property="Background" Value="#EAF4F0"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
                         <Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Height="3" Background="{Binding Background,RelativeSource={RelativeSource AncestorType=Slider}}" VerticalAlignment="Center" CornerRadius="1.5"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton>
                     </Track>
                     <Border x:Name="KeyboardRing" BorderBrush="#287568" BorderThickness="1" CornerRadius="7" Margin="0,1" IsHitTestVisible="False" Visibility="Collapsed"/>
                 </Grid>
                 <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="KeyboardRing" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="SliderChrome" Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers>
             </ControlTemplate></Setter.Value></Setter>
         </Style>
         <Style TargetType="TextBox">
 <Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#292F2D"/><Setter Property="BorderBrush" Value="#BDD9D2"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="12,9"/><Setter Property="MinHeight" Value="40"/><Setter Property="VerticalContentAlignment" Value="Center"/>
 <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border x:Name="InputChrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10"><ScrollViewer x:Name="PART_ContentHost" Margin="0"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="InputChrome" Property="BorderBrush" Value="#75BBAE"/></Trigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="InputChrome" Property="BorderBrush" Value="#287568"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
 </Style>
         <Style TargetType="PasswordBox"><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#292F2D"/><Setter Property="BorderBrush" Value="#BDD9D2"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="12,9"/><Setter Property="MinHeight" Value="40"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="PasswordBox"><Border x:Name="InputChrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10"><ScrollViewer x:Name="PART_ContentHost" Margin="0"/></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="InputChrome" Property="BorderBrush" Value="#287568"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="InputChrome" Property="BorderBrush" Value="#75BBAE"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
         <Style x:Key="SettingsSwitch" TargetType="CheckBox">
             <Setter Property="Cursor" Value="Hand"/>
             <Setter Property="MinHeight" Value="36"/>
             <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
                 <Grid Background="Transparent" Width="48" Height="36">
                     <Border x:Name="SwitchTrack" Height="26" CornerRadius="13" Background="#E3E9E6" BorderBrush="#BCCDC6" BorderThickness="1"/>
                     <Ellipse x:Name="SwitchThumb" Width="22" Height="22" Fill="White" Stroke="#BCCDC6" StrokeThickness="1" HorizontalAlignment="Left" Margin="2,0,0,0"/>
                 </Grid>
                 <ControlTemplate.Triggers>
                     <Trigger Property="IsChecked" Value="True"><Setter TargetName="SwitchTrack" Property="Background" Value="#287568"/><Setter TargetName="SwitchTrack" Property="BorderBrush" Value="#287568"/><Setter TargetName="SwitchThumb" Property="HorizontalAlignment" Value="Right"/><Setter TargetName="SwitchThumb" Property="Margin" Value="0,0,2,0"/></Trigger>
                     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="SwitchTrack" Property="BorderBrush" Value="#75BBAE"/></Trigger>
                     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="SwitchTrack" Property="BorderBrush" Value="#194F45"/></Trigger>
                     <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                 </ControlTemplate.Triggers>
             </ControlTemplate></Setter.Value></Setter>
         </Style>
         <Style TargetType="CheckBox">
             <Setter Property="Cursor" Value="Hand"/><Setter Property="Foreground" Value="#334B43"/>
             <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
                 <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                     <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True" Margin="0,0,10,0"/>
                     <Border x:Name="Track" Grid.Column="1" Width="40" Height="22" Background="#D8E5E1" CornerRadius="11" VerticalAlignment="Center"><Ellipse x:Name="Thumb" Width="18" Height="18" Fill="White" Margin="2" HorizontalAlignment="Left"/></Border>
                 </Grid>
                 <ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="#287568"/><Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Track" Property="BorderBrush" Value="#194F45"/><Setter TargetName="Track" Property="BorderThickness" Value="1"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers>
             </ControlTemplate></Setter.Value></Setter>
         </Style>
         <Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="SelectionChrome" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="14" Margin="0,0,0,4"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="SelectionChrome" Property="Background" Value="#DCECE6"/><Setter TargetName="SelectionChrome" Property="BorderBrush" Value="#75BBAE"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="SelectionChrome" Property="BorderBrush" Value="#75BBAE"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
         <FontFamily x:Key="AppFont">Segoe UI, Helvetica, Arial</FontFamily>

         <Style x:Key="SegmentedOption" TargetType="RadioButton"><Setter Property="Cursor" Value="Hand"/><Setter Property="Foreground" Value="#287568"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="MinHeight" Value="36"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Border x:Name="OptionChrome" Background="White" BorderBrush="#B5D2C9" BorderThickness="1" CornerRadius="7" Padding="16,8"><ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="Tag" Value="segment-first"><Setter TargetName="OptionChrome" Property="CornerRadius" Value="7,0,0,7"/></Trigger><Trigger Property="Tag" Value="segment-middle"><Setter TargetName="OptionChrome" Property="CornerRadius" Value="0"/><Setter TargetName="OptionChrome" Property="BorderThickness" Value="0,1,1,1"/></Trigger><Trigger Property="Tag" Value="segment-last"><Setter TargetName="OptionChrome" Property="CornerRadius" Value="0,7,7,0"/><Setter TargetName="OptionChrome" Property="BorderThickness" Value="0,1,1,1"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="OptionChrome" Property="Opacity" Value="0.45"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="OptionChrome" Property="BorderBrush" Value="#194F45"/></Trigger><Trigger Property="IsChecked" Value="True"><Setter TargetName="OptionChrome" Property="Background" Value="#287568"/><Setter Property="Foreground" Value="White"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="OptionChrome" Property="BorderBrush" Value="#287568"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    </Application.Resources>
</Application>
