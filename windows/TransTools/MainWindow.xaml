<Window x:Class="TransTools.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:TransTools.Views" xmlns:experience="clr-namespace:TransTools.Services.Experience" Title="Trans Tools" FontFamily="Segoe UI" FontSize="14" Foreground="#292F2D" Icon="/TransTools;component/Resources/AppIcon.ico" Height="820" Width="1280" MinHeight="640" MinWidth="1200" WindowStartupLocation="CenterScreen" Background="#F5F8F7">
 <Window.Resources>
  <Geometry x:Key="MeetingNavIcon">M2,8 L2,12 M5,5 L5,15 M8,2 L8,18 M11,6 L11,14 M14,4 L14,16 M17,8 L17,12</Geometry>
  <Geometry x:Key="NotebookNavIcon">M4,2 L15,2 Q17,2 17,4 L17,18 L5,18 Q2,18 2,15 L2,5 Q2,2 4,2 M5,2 L5,18 M5,15 L17,15</Geometry>
  <Geometry x:Key="TranslateNavIcon">M3,2 L17,2 Q19,2 19,4 L19,13 Q19,15 17,15 L8,15 L4,19 L4,15 L3,15 Q1,15 1,13 L1,4 Q1,2 3,2 M7,12 L10,5 L13,12 M8,10 L12,10</Geometry>
  <Geometry x:Key="ReaderNavIcon">M2,7 L6,7 L11,3 L11,17 L6,13 L2,13 Z M14,6 Q18,10 14,14 M17,3 Q23,10 17,17</Geometry>
  <Geometry x:Key="LearningNavIcon">M1,6 L10,2 L19,6 L10,10 Z M4,8 L4,14 Q10,19 16,14 L16,8 M19,6 L19,14</Geometry>
  <Geometry x:Key="ChatNavIcon">M2,2 L13,2 Q15,2 15,4 L15,11 L7,11 L3,15 L3,11 L1,11 L1,3 Z M7,12 L7,15 L13,15 L17,19 L17,15 L19,15 L19,7 L16,7</Geometry>
  <Geometry x:Key="SettingsNavIcon">M8,1 L12,1 L13,4 L16,4 L18,7 L16,10 L18,13 L16,16 L13,16 L12,19 L8,19 L7,16 L4,16 L2,13 L4,10 L2,7 L4,4 L7,4 Z M10,6 A4,4 0 1 1 10,14 A4,4 0 1 1 10,6</Geometry>
  <Style x:Key="NavButtonStyle" TargetType="RadioButton">
   <Setter Property="Foreground" Value="#65756F"/><Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Height" Value="40"/><Setter Property="Padding" Value="7,0"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
    <Border x:Name="Chrome" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="10" Padding="{TemplateBinding Padding}"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"><Path Data="{TemplateBinding Tag}" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="17" Height="17" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,7,0"/><ContentPresenter VerticalAlignment="Center"/></StackPanel></Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#B5D2C9"/><Setter Property="Foreground" Value="#287568"/></Trigger>
     <Trigger Property="IsChecked" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#E1EEE6"/><Setter TargetName="Chrome" Property="BorderBrush" Value="#B5D2C9"/><Setter Property="Foreground" Value="#287568"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#287568"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <ui:GardenBackground x:Name="DashboardGarden" Grid.RowSpan="2"/><Image x:Name="DashboardPhoto" Grid.RowSpan="2" Stretch="UniformToFill" IsHitTestVisible="False" Visibility="Collapsed"/><Border x:Name="PhotoVeil" Grid.RowSpan="2" Background="#65FFFFFF" IsHitTestVisible="False" Visibility="Collapsed"/><Border Background="#E8FFFFFF" BorderBrush="#D8E5E1" BorderThickness="0,0,0,1" Padding="18,10">
   <DockPanel LastChildFill="True">
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="BackgroundButton" Width="36" Height="36" MinHeight="36" Padding="0" ToolTip="Chọn nền" Style="{StaticResource SecondaryButton}" Click="ShowBackground_Click"><TextBlock Text="&#xEB9F;" FontFamily="Segoe MDL2 Assets"/><Button.ContextMenu><ContextMenu>
<MenuItem Header="Tự động theo thời gian" Tag="auto" IsCheckable="True" Click="ChooseBackground_Click"/>
<MenuItem Header="Buổi sáng" Tag="morning" IsCheckable="True" Click="ChooseBackground_Click"/>
<MenuItem Header="Buổi trưa" Tag="noon" IsCheckable="True" Click="ChooseBackground_Click"/>
<MenuItem Header="Buổi chiều" Tag="afternoon" IsCheckable="True" Click="ChooseBackground_Click"/>
<MenuItem Header="Buổi tối" Tag="night" IsCheckable="True" Click="ChooseBackground_Click"/>
<MenuItem Header="Xanh mint" Tag="mint" IsCheckable="True" Click="ChooseBackground_Click"/><Separator/>
<MenuItem Header="Chọn ảnh từ máy…" Tag="photo" IsCheckable="True" Click="ChoosePhoto_Click"/>
</ContextMenu></Button.ContextMenu></Button>
     <Button Height="36" MinHeight="36" Width="110" ToolTip="{Binding DisplayName,Source={x:Static experience:AssistantIdentity.Shared}}" Click="ToggleMascot_Click" Background="#E1EEE6" Foreground="#287568" Margin="12,0,8,0"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,7,0"/><TextBlock Text="{Binding DisplayName,Source={x:Static experience:AssistantIdentity.Shared}}" MaxWidth="72" TextTrimming="CharacterEllipsis"/></StackPanel></Button>
     <Button Height="36" MinHeight="36" Click="ToggleSubtitle_Click" Style="{StaticResource SecondaryButton}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8F2;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,7,0"/><TextBlock Text="Phụ đề"/></StackPanel></Button>
    </StackPanel>
    <Border CornerRadius="14" Background="#DFFFFFFF" BorderBrush="#BDD9D2" BorderThickness="1" Padding="4">
     <UniformGrid Columns="7">
      <RadioButton Content="Cuộc họp" Tag="{StaticResource MeetingNavIcon}" Style="{StaticResource NavButtonStyle}" IsChecked="True" Checked="NavMeeting_Checked"/>
      <RadioButton Content="Sổ tay" Tag="{StaticResource NotebookNavIcon}" Style="{StaticResource NavButtonStyle}" Checked="NavNotebook_Checked"/>
      <RadioButton x:Name="NavTranslate" Content="Dịch nhanh" Tag="{StaticResource TranslateNavIcon}" Style="{StaticResource NavButtonStyle}" Checked="NavTranslate_Checked"/>
      <RadioButton Content="Đọc văn bản" Tag="{StaticResource ReaderNavIcon}" Style="{StaticResource NavButtonStyle}" Checked="NavReader_Checked"/>
      <RadioButton Content="Học ngôn ngữ" Tag="{StaticResource LearningNavIcon}" Style="{StaticResource NavButtonStyle}" Checked="NavLearning_Checked"/>
      <RadioButton x:Name="NavConversation" Content="Trò chuyện" Tag="{StaticResource ChatNavIcon}" Style="{StaticResource NavButtonStyle}" Checked="NavConversation_Checked"/>
      <RadioButton x:Name="NavSettings" Content="Cài đặt" Tag="{StaticResource SettingsNavIcon}" Style="{StaticResource NavButtonStyle}" Checked="NavSettings_Checked"/>
     </UniformGrid>
    </Border>
   </DockPanel>
  </Border>
  <Grid x:Name="MainContentGrid" Grid.Row="1" Margin="18"/>
 </Grid>
</Window>