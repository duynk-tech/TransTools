<Window x:Class="TransTools.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:experience="clr-namespace:TransTools.Services.Experience" Title="Trans Tools" Icon="/TransTools;component/Resources/AppIcon.ico" Height="820" Width="1280" MinHeight="600" MinWidth="1000" WindowStartupLocation="CenterScreen" Background="#F5F8F7">
 <Window.Resources>
  <Style x:Key="NavButtonStyle" TargetType="RadioButton">
   <Setter Property="Foreground" Value="#65756F"/><Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Height" Value="40"/><Setter Property="Padding" Value="16,0"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
    <Border x:Name="Chrome" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="10" Padding="{TemplateBinding Padding}"><ContentPresenter VerticalAlignment="Center"/></Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#B5D2C9"/><Setter Property="Foreground" Value="#287568"/></Trigger>
     <Trigger Property="IsChecked" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#E1EEE6"/><Setter TargetName="Chrome" Property="BorderBrush" Value="#B5D2C9"/><Setter Property="Foreground" Value="#287568"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#287568"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Border Background="#F8FBFA" BorderBrush="#D8E5E1" BorderThickness="0,0,0,1" Padding="20,14">
   <DockPanel LastChildFill="False">
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
     <Button Width="130" ToolTip="{Binding DisplayName,Source={x:Static experience:AssistantIdentity.Shared}}" Click="ToggleMascot_Click" Background="#E1EEE6" Foreground="#287568" Margin="12,0,8,0"><TextBlock Text="{Binding DisplayName,Source={x:Static experience:AssistantIdentity.Shared}}" TextTrimming="CharacterEllipsis"/></Button>
     <Button Content="Phụ đề" Click="ToggleSubtitle_Click" Background="White" Foreground="#287568"/>
    </StackPanel>
    <Border CornerRadius="14" Background="White" BorderBrush="#D8E5E1" BorderThickness="1" Padding="4">
     <StackPanel Orientation="Horizontal">
      <RadioButton Content="Cuộc họp" Style="{StaticResource NavButtonStyle}" IsChecked="True" Checked="NavMeeting_Checked"/>
      <RadioButton Content="Sổ tay" Style="{StaticResource NavButtonStyle}" Checked="NavNotebook_Checked"/>
      <RadioButton x:Name="NavTranslate" Content="Dịch nhanh" Style="{StaticResource NavButtonStyle}" Checked="NavTranslate_Checked"/>
      <RadioButton Content="Học ngôn ngữ" Style="{StaticResource NavButtonStyle}" Checked="NavLearning_Checked"/>
      <RadioButton Content="Trò chuyện" Style="{StaticResource NavButtonStyle}" Checked="NavConversation_Checked"/>
      <RadioButton Content="Cài đặt" Style="{StaticResource NavButtonStyle}" Checked="NavSettings_Checked"/>
     </StackPanel>
    </Border>
   </DockPanel>
  </Border>
  <Grid x:Name="MainContentGrid" Grid.Row="1" Margin="20"/>
 </Grid>
</Window>