<Window x:Class="TransTools.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:TransTools.ViewModels"
        Title="Trans Tools • Dịch cuộc họp và luyện giao tiếp"
        Height="720" Width="1100"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="#0F172A">

    <Window.Resources>
        <!-- Nav Button Style -->
        <Style x:Key="NavButtonStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1E293B"/>
                                <Setter Property="Foreground" Value="#F8FAFC"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2563EB"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar Navigation -->
        <Border Grid.Column="0" Background="#1E293B" BorderBrush="#334155" BorderThickness="0,0,1,0" Padding="14,18">
            <DockPanel>
                <!-- App Logo & Title -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,24">
                    <Border Width="36" Height="36" CornerRadius="8" Background="#2563EB" Margin="0,0,10,0">
                        <TextBlock Text="TT" FontWeight="Bold" FontSize="16" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Trans Tools" FontWeight="Bold" FontSize="16" Foreground="#F8FAFC"/>
                        <TextBlock Text="v1.4.0 for Windows" FontSize="11" Foreground="#64748B"/>
                    </StackPanel>
                </StackPanel>

                <!-- Floating Overlays Quick Toggles -->
                <StackPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
                    <Separator Background="#334155" Margin="0,0,0,12"/>
                    <Button Content="💬 Hiện phụ đề nổi" Click="ToggleSubtitle_Click" Background="#334155" Foreground="#F8FAFC" Height="34" Margin="0,0,0,6" Cursor="Hand"/>
                    <Button Content="🐣 Mascot Chip Chip" Click="ToggleMascot_Click" Background="#334155" Foreground="#F8FAFC" Height="34" Cursor="Hand"/>
                </StackPanel>

                <!-- Navigation Tabs -->
                <StackPanel VerticalAlignment="Top">
                    <RadioButton Content="🎙️  Cuộc họp" Style="{StaticResource NavButtonStyle}" IsChecked="True" Checked="NavMeeting_Checked"/>
                    <RadioButton Content="📖  Sổ tay cuộc họp" Style="{StaticResource NavButtonStyle}" Checked="NavNotebook_Checked"/>
                    <RadioButton Content="⚡  Dịch nhanh &amp; OCR" Style="{StaticResource NavButtonStyle}" Checked="NavTranslate_Checked"/>
                    <RadioButton Content="💬  Trò chuyện AI" Style="{StaticResource NavButtonStyle}" Checked="NavConversation_Checked"/>
                    <RadioButton Content="🎓  Học ngôn ngữ" Style="{StaticResource NavButtonStyle}" Checked="NavLearning_Checked"/>
                    <RadioButton Content="⚙️  Cài đặt" Style="{StaticResource NavButtonStyle}" Checked="NavSettings_Checked"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Main Content Area -->
        <Border Grid.Column="1" Background="#0F172A" Padding="24">
            <Grid x:Name="MainContentGrid">
                <!-- Content injected dynamically via Navigation -->
            </Grid>
        </Border>
    </Grid>
</Window>
