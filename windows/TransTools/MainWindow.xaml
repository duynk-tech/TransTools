<Window x:Class="TransTools.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:TransTools.Views" xmlns:experience="clr-namespace:TransTools.Services.Experience" Title="Trans Tools" Icon="/TransTools;component/Resources/AppIcon.ico" Height="820" Width="1280" MinHeight="640" MinWidth="1200" WindowStartupLocation="CenterScreen" Background="#F5F8F7">
 <Window.Resources>
  <Style x:Key="NavButtonStyle" TargetType="RadioButton">
   <Setter Property="Foreground" Value="#65756F"/><Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Height" Value="36"/><Setter Property="Padding" Value="7,0"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
    <Border x:Name="Chrome" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="10" Padding="{TemplateBinding Padding}"><StackPanel Orientation="Horizontal"><TextBlock Text="{TemplateBinding Tag}" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/><ContentPresenter VerticalAlignment="Center"/></StackPanel></Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#B5D2C9"/><Setter Property="Foreground" Value="#287568"/></Trigger>
     <Trigger Property="IsChecked" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#E1EEE6"/><Setter TargetName="Chrome" Property="BorderBrush" Value="#B5D2C9"/><Setter Property="Foreground" Value="#287568"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#287568"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <ui:GardenBackground x:Name="DashboardGarden" Grid.RowSpan="2"/><Image x:Name="DashboardPhoto" Grid.RowSpan="2" Stretch="UniformToFill" IsHitTestVisible="False" Visibility="Collapsed"/><Border x:Name="PhotoVeil" Grid.RowSpan="2" Background="#65FFFFFF" IsHitTestVisible="False" Visibility="Collapsed"/><Border Background="#E8FFFFFF" BorderBrush="#D8E5E1" BorderThickness="0,0,0,1" Padding="18,10">
   <DockPanel LastChildFill="True">
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="BackgroundButton" Width="36" Height="36" MinHeight="36" Padding="0" ToolTip="Chọn nền" Style="{StaticResource SecondaryButton}" Click="ShowBackground_Click"><TextBlock Text="&#xEB9F;" FontFamily="Segoe MDL2 Assets"/><Button.ContextMenu><ContextMenu>
<MenuItem Header="Tự động theo thời gian" Tag="auto" IsCheckable="True" Click="ChooseBackground_Click"/>
<MenuItem Header="Buổi sáng" Tag="morning" IsCheckable="True" Click="ChooseBackground_Click"/>
<MenuItem Header="Buổi trưa" Tag="noon" IsCheckable="True" Click="ChooseBackground_Click"/>
<MenuItem Header="Buổi chiều" Tag="afternoon" IsCheckable="True" Click="ChooseBackground_Click"/>
<MenuItem Header="Buổi tối" Tag="night" IsCheckable="True" Click="ChooseBackground_Click"/>
<MenuItem Header="Xanh mint" Tag="mint" IsCheckable="True" Click="ChooseBackground_Click"/><Separator/>
<MenuItem Header="Chọn ảnh từ máy…" Tag="photo" IsCheckable="True" Click="ChoosePhoto_Click"/>
</ContextMenu></Button.ContextMenu></Button>
     <Button Height="36" MinHeight="36" Width="110" ToolTip="{Binding DisplayName,Source={x:Static experience:AssistantIdentity.Shared}}" Click="ToggleMascot_Click" Background="#E1EEE6" Foreground="#287568" Margin="12,0,8,0"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,7,0"/><TextBlock Text="{Binding DisplayName,Source={x:Static experience:AssistantIdentity.Shared}}" MaxWidth="72" TextTrimming="CharacterEllipsis"/></StackPanel></Button>
     <Button Height="36" MinHeight="36" Click="ToggleSubtitle_Click" Style="{StaticResource SecondaryButton}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8F2;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,7,0"/><TextBlock Text="Phụ đề"/></StackPanel></Button>
    </StackPanel>
    <Border CornerRadius="14" Background="#DFFFFFFF" BorderBrush="#BDD9D2" BorderThickness="1" Padding="4">
     <UniformGrid Columns="7">
      <RadioButton Content="Cuộc họp" Tag="&#xE767;" Style="{StaticResource NavButtonStyle}" IsChecked="True" Checked="NavMeeting_Checked"/>
      <RadioButton Content="Sổ tay" Tag="&#xE8F1;" Style="{StaticResource NavButtonStyle}" Checked="NavNotebook_Checked"/>
      <RadioButton x:Name="NavTranslate" Content="Dịch nhanh" Tag="&#xE8D2;" Style="{StaticResource NavButtonStyle}" Checked="NavTranslate_Checked"/>
      <RadioButton Content="Đọc văn bản" Tag="&#xE767;" Style="{StaticResource NavButtonStyle}" Checked="NavReader_Checked"/>
      <RadioButton Content="Học ngôn ngữ" Tag="&#xE7BE;" Style="{StaticResource NavButtonStyle}" Checked="NavLearning_Checked"/>
      <RadioButton Content="Trò chuyện" Tag="&#xE8F2;" Style="{StaticResource NavButtonStyle}" Checked="NavConversation_Checked"/>
      <RadioButton Content="Cài đặt" Tag="&#xE713;" Style="{StaticResource NavButtonStyle}" Checked="NavSettings_Checked"/>
     </UniformGrid>
    </Border>
   </DockPanel>
  </Border>
  <Grid x:Name="MainContentGrid" Grid.Row="1" Margin="18"/>
 </Grid>
</Window>