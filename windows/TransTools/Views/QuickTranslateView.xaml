<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="TransTools.Views.QuickTranslateView">
<DockPanel><Grid DockPanel.Dock="Top" Margin="0,4,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Dịch nhanh" FontSize="22" FontWeight="SemiBold" /><TextBlock Text="Dịch, sửa ngữ pháp và chọn cách diễn đạt phù hợp" Foreground="#65756F" Margin="0,4,0,0" /></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0" Grid.Column="1">
                    <Button Content="Sửa ngữ pháp" Command="{Binding CheckGrammarCommand}" Margin="0,0,8,0" Padding="12,8" Cursor="Hand" Style="{StaticResource SecondaryButton}" />
                    <Button Content="Chụp màn hình" Click="CaptureOcr_Click" Margin="0,0,8,0" Padding="12,8" Cursor="Hand" Style="{StaticResource SecondaryButton}" />
                    <Button Content="Dịch ngay" Command="{Binding TranslateCommand}" FontWeight="Bold" Padding="16,8" Cursor="Hand" />
                <Button x:Name="ContextButton" Grid.Column="1" Content="Ngữ cảnh &amp; Mẫu câu" Style="{StaticResource SecondaryButton}" Click="ShowContext_Click" /></StackPanel>
            </Grid>
<Grid><Grid x:Name="TranslationContent"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
<Grid Margin="0,0,0,16"><Popup x:Name="ContextPopup" PlacementTarget="{Binding ElementName=ContextButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True"><Border Background="White" BorderBrush="#B5D2C9" BorderThickness="1" CornerRadius="12" Padding="16" Width="390"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="130" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><TextBlock Text="Chuyên ngành" VerticalAlignment="Center" /><ComboBox Grid.Column="1" SelectedValuePath="Content" SelectedValue="{Binding SelectedDomain}" Width="165" Margin="0">
                        <ComboBoxItem Content="Thông dụng" IsSelected="True" />
                        <ComboBoxItem Content="Công nghệ thông tin" />
                        <ComboBoxItem Content="Y tế &amp; Sinh học" />
                        <ComboBoxItem Content="Kinh tế &amp; Tài chính" />
                        <ComboBoxItem Content="Du lịch &amp; Khách sạn" />
                        <ComboBoxItem Content="Pháp luật" />
                    </ComboBox>

                    <TextBlock Grid.Row="1" Text="Phong cách" VerticalAlignment="Center" Margin="0,12,0,0" /><ComboBox Grid.Row="1" Grid.Column="1" SelectedValuePath="Content" SelectedValue="{Binding SelectedStyle}" Width="165" Margin="0">
                        <ComboBoxItem Content="Tự nhiên" IsSelected="True" />
                        <ComboBoxItem Content="Trang trọng" />
                        <ComboBoxItem Content="Học thuật" />
                        <ComboBoxItem Content="Ngắn gọn" />
                    </ComboBox>
                </Grid></Border></Popup>
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><ComboBox SelectedValuePath="Tag" SelectedValue="{Binding SourceLanguage}" Width="165" Margin="0">
                        <ComboBoxItem Content="Tự động" Tag="auto" IsSelected="True" />
                        <ComboBoxItem Content="Tiếng Anh" Tag="en" />
                        <ComboBoxItem Content="Tiếng Việt" Tag="vi" />
                        <ComboBoxItem Content="Tiếng Nhật" Tag="ja" />
                        <ComboBoxItem Content="Tiếng Trung" Tag="zh" />
                        <ComboBoxItem Content="Tiếng Hàn" Tag="ko" />
                    </ComboBox>

                    <Button Content="⇄" Click="SwapLanguages_Click" Style="{StaticResource SecondaryButton}" Margin="10,0" /><ComboBox SelectedValuePath="Tag" SelectedValue="{Binding TargetLanguage}" Width="165" Margin="0">
                        <ComboBoxItem Content="Tiếng Việt" Tag="vi" IsSelected="True" />
                        <ComboBoxItem Content="Tiếng Anh" Tag="en" />
                        <ComboBoxItem Content="Tiếng Nhật" Tag="ja" />
                        <ComboBoxItem Content="Tiếng Trung" Tag="zh" />
                        <ComboBoxItem Content="Tiếng Hàn" Tag="ko" />
                    </ComboBox>
                    </StackPanel><TextBlock Text="{Binding SelectedDomain}" VerticalAlignment="Center" Foreground="#65756F" Grid.Column="1" HorizontalAlignment="Right" /></Grid></Grid>
<Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>


            <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#C2DDD5" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,8,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Văn bản gốc" FontWeight="SemiBold" Foreground="#65756F" Margin="0,0,0,12" /><Grid DockPanel.Dock="Bottom" Margin="0,12,0,0">
                        <Button Content="🔊 Đọc văn bản gốc" Command="{Binding SpeakSourceCommand}" Background="#D8E5E1" Foreground="#243D35" HorizontalAlignment="Left" Padding="10,6" Cursor="Hand" />
                        <Button Content="Xóa" Style="{StaticResource DestructiveButton}" Click="ClearSource_Click" Background="Transparent" Foreground="#65756F" BorderThickness="0" HorizontalAlignment="Right" Cursor="Hand" />
                    </Grid>

                    <TextBox Text="{Binding SourceText, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" Foreground="#243D35" BorderThickness="0" FontSize="14" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                </DockPanel>
            </Border>


            <Border Grid.Column="1" Background="#FFFFFF" BorderBrush="#C2DDD5" BorderThickness="1" CornerRadius="12" Padding="16" Margin="8,0,0,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Bản dịch" FontWeight="SemiBold" Foreground="#65756F" Margin="0,0,0,12" /><Grid DockPanel.Dock="Bottom" Margin="0,12,0,0">
                        <Button Content="🔊 Đọc bản dịch" Command="{Binding SpeakTranslatedCommand}" Background="#287568" Foreground="White" HorizontalAlignment="Left" Padding="10,6" Cursor="Hand" />
                        <Button Content="📋 Sao chép" Click="CopyTranslated_Click" Background="#D8E5E1" Foreground="#243D35" HorizontalAlignment="Right" Padding="10,6" Cursor="Hand" />
                    </Grid>

                    <TextBox Text="{Binding TranslatedText}" IsReadOnly="True" Background="Transparent" Foreground="#287568" BorderThickness="0" FontSize="14" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                </DockPanel>
            </Border>
        </Grid>


        <Border Grid.Row="2" Margin="0,12,0,0">
            <TextBlock Text="{Binding Status}" FontSize="12" Foreground="#73827C" />
        </Border>
    </Grid></Grid></DockPanel></UserControl>