<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="TransTools.Views.QuickTranslateView">
<UserControl.Resources>
 <Style x:Key="StudioEditor" TargetType="TextBox">
  <Setter Property="Padding" Value="8"/><Setter Property="VerticalContentAlignment" Value="Top"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/></ControlTemplate></Setter.Value></Setter>
 </Style>
</UserControl.Resources>
<UserControl.InputBindings><KeyBinding Key="Enter" Modifiers="Control" Command="{Binding TranslateCommand}"/></UserControl.InputBindings>
<DockPanel><Grid DockPanel.Dock="Top" Margin="0,4,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Dịch nhanh" FontSize="22" FontWeight="SemiBold" /><TextBlock Text="Dịch, sửa ngữ pháp và chọn cách diễn đạt phù hợp" Foreground="#65756F" Margin="0,4,0,0" /></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0" Grid.Column="1">
                    <Button Content="Sửa ngữ pháp" Command="{Binding CheckGrammarCommand}" Margin="0,0,8,0" Padding="12,8" Cursor="Hand" Style="{StaticResource SecondaryButton}" />
                    <Button Content="Chụp" IsEnabled="{Binding CanConfigure}" Click="CaptureOcr_Click" Margin="0,0,8,0" Padding="12,8" Cursor="Hand" Style="{StaticResource SecondaryButton}" ToolTip="Chụp và dịch màn hình" />
                    <Button Content="Dịch ngay" Command="{Binding TranslateCommand}" FontWeight="Bold" Padding="16,8" Cursor="Hand" Margin="0,0,16,0" />
                <Button x:Name="ContextButton" Grid.Column="1" Content="{Binding ContextButtonLabel}" Style="{StaticResource SecondaryButton}" Click="ShowContext_Click" /></StackPanel>
            </Grid>
<Grid><Grid x:Name="TranslationContent"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
<StackPanel Margin="0,0,0,16"><StackPanel x:Name="ContextPanel" Visibility="{Binding ShowContext,Converter={StaticResource BoolVisibility}}"><Border Background="White" BorderBrush="#B5D2C9" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Chuyên ngành" VerticalAlignment="Center" /><ComboBox IsEnabled="{Binding CanConfigure}" Grid.Column="1" SelectedValuePath="Content" SelectedValue="{Binding SelectedDomain}" HorizontalAlignment="Stretch" Margin="0">
                        <ComboBoxItem Content="Thông dụng" /><ComboBoxItem Content="Kinh doanh &amp; Hội họp" />
                        <ComboBoxItem Content="Công nghệ thông tin" />
                        <ComboBoxItem Content="Y tế &amp; Sinh học" />
                        <ComboBoxItem Content="Kinh tế &amp; Tài chính" />
                        <ComboBoxItem Content="Du lịch &amp; Khách sạn" />
                        <ComboBoxItem Content="Pháp luật" />
                    </ComboBox>

                    <TextBlock Grid.Column="2" Text="Phong cách" VerticalAlignment="Center" Margin="16,0,0,0" /><ComboBox IsEnabled="{Binding CanConfigure}" Grid.Column="3" SelectedValuePath="Content" SelectedValue="{Binding SelectedStyle}" HorizontalAlignment="Stretch" Margin="0">
                        <ComboBoxItem Content="Tự nhiên" IsSelected="True" />
                        <ComboBoxItem Content="Trang trọng" />
                        <ComboBoxItem Content="Học thuật" />
                        <ComboBoxItem Content="Ngắn gọn" />
                    </ComboBox>
                </Grid></Border><ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,12"><ItemsControl ItemsSource="{Binding QuickPhrases}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding}" Click="ChoosePhrase_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" MinHeight="32" Padding="10,5" FontSize="12" IsEnabled="{Binding DataContext.CanConfigure,RelativeSource={RelativeSource AncestorType=UserControl}}"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></StackPanel>
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><ComboBox IsEnabled="{Binding CanConfigure}" SelectedValuePath="Tag" SelectedValue="{Binding SourceLanguage}" Width="165" Margin="0">
                        <ComboBoxItem Content="Tự động" Tag="auto" IsSelected="True" />
                        <ComboBoxItem Content="Tiếng Anh" Tag="en" />
                        <ComboBoxItem Content="Tiếng Việt" Tag="vi" />
                        <ComboBoxItem Content="Tiếng Nhật" Tag="ja" />
                        <ComboBoxItem Content="Tiếng Trung" Tag="zh" />
                        <ComboBoxItem Content="Tiếng Hàn" Tag="ko" />
                    </ComboBox>

                    <Button Content="⇄" IsEnabled="{Binding CanConfigure}" Click="SwapLanguages_Click" Style="{StaticResource SecondaryButton}" Margin="10,0" /><ComboBox IsEnabled="{Binding CanConfigure}" SelectedValuePath="Tag" SelectedValue="{Binding TargetLanguage}" Width="165" Margin="0">
                        <ComboBoxItem Content="Tiếng Việt" Tag="vi" IsSelected="True" />
                        <ComboBoxItem Content="Tiếng Anh" Tag="en" />
                        <ComboBoxItem Content="Tiếng Nhật" Tag="ja" />
                        <ComboBoxItem Content="Tiếng Trung" Tag="zh" />
                        <ComboBoxItem Content="Tiếng Hàn" Tag="ko" />
                    </ComboBox>
                    </StackPanel><TextBlock Text="{Binding SelectedDomain}" VerticalAlignment="Center" Foreground="#65756F" Grid.Column="1" HorizontalAlignment="Right" /></Grid></StackPanel>
<Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>


            <DockPanel Grid.Column="0" Margin="0,0,8,0"><DockPanel DockPanel.Dock="Top" Margin="0,0,0,10" LastChildFill="True"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="Nghe" Command="{Binding SpeakSourceCommand}" Padding="8,4" Cursor="Hand" MinHeight="28" FontSize="12" Margin="8,0,0,0" Style="{StaticResource SecondaryButton}" />
                        <Button Content="Xóa" Style="{StaticResource SecondaryButton}" Click="ClearSource_Click" BorderThickness="0" Cursor="Hand" MinHeight="28" Padding="8,4" FontSize="12" Margin="8,0,0,0" />
                    </StackPanel><TextBlock DockPanel.Dock="Top" Text="Văn bản gốc" FontWeight="SemiBold" Foreground="#65756F" Margin="0" VerticalAlignment="Center" /></DockPanel><Border Background="#FFFFFF" BorderBrush="#C2DDD5" BorderThickness="1" CornerRadius="14" Padding="10" Margin="0">
                <DockPanel>
                    <Grid><TextBox x:Name="SourceEditor" Style="{StaticResource StudioEditor}" Text="{Binding SourceText, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" Foreground="#243D35" BorderThickness="0" FontSize="{Binding EditorFontSize}" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" /><TextBlock Text="Nhập hoặc dán văn bản…" Margin="8" Foreground="#8B9691" FontSize="{Binding EditorFontSize}" IsHitTestVisible="False" TextWrapping="Wrap"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text,ElementName=SourceEditor}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
                </DockPanel>
            </Border>


            </DockPanel><DockPanel Grid.Column="1" Margin="8,0,0,0"><DockPanel DockPanel.Dock="Top" Margin="0,0,0,10" LastChildFill="True"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="Nghe" Command="{Binding SpeakTranslatedCommand}" Padding="8,4" Cursor="Hand" MinHeight="28" FontSize="12" Margin="8,0,0,0" Style="{StaticResource SecondaryButton}" />
                        <Button Content="Sao chép" Click="CopyTranslated_Click" Padding="8,4" Cursor="Hand" MinHeight="28" FontSize="12" Margin="8,0,0,0" Style="{StaticResource SecondaryButton}" />
                    </StackPanel><TextBlock DockPanel.Dock="Top" Text="Bản dịch" FontWeight="SemiBold" Foreground="#65756F" Margin="0" VerticalAlignment="Center" /></DockPanel><Border Background="#FFFFFF" BorderBrush="#C2DDD5" BorderThickness="1" CornerRadius="14" Padding="10" Margin="0">
                <DockPanel>
                    <Grid><TextBox x:Name="TranslationEditor" Style="{StaticResource StudioEditor}" Text="{Binding TranslatedText}" IsReadOnly="True" Background="Transparent" Foreground="#287568" BorderThickness="0" FontSize="{Binding EditorFontSize}" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" /><TextBlock Text="Bản dịch sẽ hiện tại đây." Margin="8" Foreground="#8B9691" FontSize="{Binding EditorFontSize}" IsHitTestVisible="False" TextWrapping="Wrap"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text,ElementName=TranslationEditor}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
                </DockPanel>
            </Border>
        </DockPanel></Grid>


        <Grid Grid.Row="2" Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<DockPanel Margin="0,0,8,0"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="A−" Command="{Binding DecreaseEditorFontCommand}" ToolTip="Giảm cỡ chữ" Style="{StaticResource SecondaryButton}" MinHeight="28" Padding="6,3"/><TextBlock Text="{Binding EditorFontSize}" VerticalAlignment="Center" Margin="8,0" Foreground="#287568"/><Button Content="A+" Command="{Binding IncreaseEditorFontCommand}" ToolTip="Tăng cỡ chữ" Style="{StaticResource SecondaryButton}" MinHeight="28" Padding="6,3"/></StackPanel><TextBlock Text="{Binding CharacterCountLabel}" FontSize="11" Foreground="#73827C" VerticalAlignment="Center"/></DockPanel>
<TextBlock Grid.Column="1" Text="{Binding Status}" FontSize="12" Foreground="#73827C" Margin="8,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"/>
</Grid>
    </Grid></Grid></DockPanel></UserControl>