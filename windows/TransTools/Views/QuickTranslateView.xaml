<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="TransTools.Views.QuickTranslateView">
<UserControl.Resources>
 <Style x:Key="StudioCard" TargetType="Border" BasedOn="{StaticResource TranscriptCard}">
  <Setter Property="Padding" Value="16"/><Setter Property="CornerRadius" Value="12"/><Setter Property="MinHeight" Value="220"/>
  <Style.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="#287568"/></Trigger></Style.Triggers>
 </Style>

 <Style x:Key="StudioEditor" TargetType="TextBox">
  <Setter Property="Padding" Value="4"/><Setter Property="VerticalContentAlignment" Value="Top"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/></ControlTemplate></Setter.Value></Setter>
 </Style>
</UserControl.Resources>
<UserControl.InputBindings><KeyBinding Key="Enter" Modifiers="Control" Command="{Binding TranslateCommand}"/></UserControl.InputBindings>
<DockPanel><Grid DockPanel.Dock="Top" Margin="0,4,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Dịch nhanh" FontSize="17" FontWeight="Bold" /><TextBlock Text="Dịch, sửa ngữ pháp và chọn cách diễn đạt phù hợp" Foreground="#65756F" Margin="0,4,0,0" /></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0" Grid.Column="1">
                    <Button Command="{Binding CheckGrammarCommand}" Margin="0,0,8,0" Padding="12,8" Cursor="Hand" Style="{StaticResource SecondaryButton}"  AutomationProperties.Name="Sửa ngữ pháp"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE734;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,7,0"/><TextBlock Text="Sửa ngữ pháp" VerticalAlignment="Center"/></StackPanel></Button>
                    <Button IsEnabled="{Binding CanConfigure}" Click="CaptureOcr_Click" Margin="0,0,8,0" Padding="12,8" Cursor="Hand" Style="{StaticResource SecondaryButton}" ToolTip="Chụp và dịch màn hình"  AutomationProperties.Name="Chụp"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE722;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,7,0"/><TextBlock Text="Chụp" VerticalAlignment="Center"/></StackPanel></Button>
                    <Button Command="{Binding TranslateCommand}" FontWeight="Bold" Padding="16,8" Cursor="Hand" Margin="0,0,16,0"  AutomationProperties.Name="Dịch ngay"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72A;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,7,0"/><TextBlock Text="Dịch ngay" VerticalAlignment="Center"/></StackPanel></Button>
                <Button x:Name="ContextButton" Grid.Column="1" Style="{StaticResource SecondaryButton}" Click="ShowContext_Click"  AutomationProperties.Name="{Binding ContextButtonLabel}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE9E9;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,7,0"/><TextBlock Text="{Binding ContextButtonLabel}" VerticalAlignment="Center"/></StackPanel></Button></StackPanel>
            </Grid>
<Grid><Grid x:Name="TranslationContent"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
<StackPanel Margin="0,0,0,16"><StackPanel x:Name="ContextPanel" Visibility="{Binding ShowContext,Converter={StaticResource BoolVisibility}}"><Border Background="White" BorderBrush="#B5D2C9" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Chuyên ngành" VerticalAlignment="Center" /><ComboBox IsEnabled="{Binding CanConfigure}" Grid.Column="1" SelectedValuePath="Content" SelectedValue="{Binding SelectedDomain}" HorizontalAlignment="Stretch" Margin="0">
                        <ComboBoxItem Content="Thông dụng" /><ComboBoxItem Content="Kinh doanh &amp; Hội họp" />
                        <ComboBoxItem Content="Công nghệ thông tin" />
                        <ComboBoxItem Content="Y tế &amp; Sinh học" />
                        <ComboBoxItem Content="Kinh tế &amp; Tài chính" />
                        <ComboBoxItem Content="Du lịch &amp; Khách sạn" />
                        <ComboBoxItem Content="Pháp luật" />
                    </ComboBox>

                    <TextBlock Grid.Column="2" Text="Phong cách" VerticalAlignment="Center" Margin="16,0,0,0" /><ComboBox IsEnabled="{Binding CanConfigure}" Grid.Column="3" SelectedValuePath="Content" SelectedValue="{Binding SelectedStyle}" HorizontalAlignment="Stretch" Margin="0">
                        <ComboBoxItem Content="Tự nhiên" IsSelected="True" />
                        <ComboBoxItem Content="Trang trọng" />
                        <ComboBoxItem Content="Học thuật" />
                        <ComboBoxItem Content="Ngắn gọn" />
                    </ComboBox>
                </Grid></Border><ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,12"><ItemsControl ItemsSource="{Binding QuickPhrases}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding}" Click="ChoosePhrase_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" MinHeight="32" Padding="10,5" FontSize="12" IsEnabled="{Binding DataContext.CanConfigure,RelativeSource={RelativeSource AncestorType=UserControl}}"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></StackPanel>
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><ComboBox IsEnabled="{Binding CanConfigure}" SelectedValuePath="Tag" SelectedValue="{Binding SourceLanguage}" Width="165" Height="40" MinHeight="40" Margin="0">
                        <ComboBoxItem Content="Tự động" Tag="auto" IsSelected="True"  ContentTemplate="{StaticResource LanguageItem}"/>
                        <ComboBoxItem Content="Tiếng Anh" Tag="en"  ContentTemplate="{StaticResource LanguageItem}"/>
                        <ComboBoxItem Content="Tiếng Việt" Tag="vi"  ContentTemplate="{StaticResource LanguageItem}"/>
                        <ComboBoxItem Content="Tiếng Nhật" Tag="ja"  ContentTemplate="{StaticResource LanguageItem}"/>
                        <ComboBoxItem Content="Tiếng Trung" Tag="zh"  ContentTemplate="{StaticResource LanguageItem}"/>
                        <ComboBoxItem Content="Tiếng Hàn" Tag="ko"  ContentTemplate="{StaticResource LanguageItem}"/>
                    </ComboBox>

                    <Button Content="⇄" Width="40" Height="40" MinHeight="40" Padding="0" IsEnabled="{Binding CanConfigure}" Click="SwapLanguages_Click" Style="{StaticResource SecondaryButton}" Margin="10,0" /><ComboBox IsEnabled="{Binding CanConfigure}" SelectedValuePath="Tag" SelectedValue="{Binding TargetLanguage}" Width="165" Height="40" MinHeight="40" Margin="0">
                        <ComboBoxItem Content="Tiếng Việt" Tag="vi" IsSelected="True"  ContentTemplate="{StaticResource LanguageItem}"/>
                        <ComboBoxItem Content="Tiếng Anh" Tag="en"  ContentTemplate="{StaticResource LanguageItem}"/>
                        <ComboBoxItem Content="Tiếng Nhật" Tag="ja"  ContentTemplate="{StaticResource LanguageItem}"/>
                        <ComboBoxItem Content="Tiếng Trung" Tag="zh"  ContentTemplate="{StaticResource LanguageItem}"/>
                        <ComboBoxItem Content="Tiếng Hàn" Tag="ko"  ContentTemplate="{StaticResource LanguageItem}"/>
                    </ComboBox>
                    </StackPanel><TextBlock Text="{Binding SelectedDomain}" VerticalAlignment="Center" Foreground="#65756F" Grid.Column="1" HorizontalAlignment="Right" /></Grid></StackPanel>
<Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>


            <DockPanel Grid.Column="0" Margin="0,0,8,0"><DockPanel DockPanel.Dock="Top" Margin="0,0,0,10" LastChildFill="True"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button AutomationProperties.Name="Nghe" Command="{Binding SpeakSourceCommand}" Padding="8,4" Cursor="Hand" MinHeight="28" FontSize="12" Margin="8,0,0,0" Style="{StaticResource SecondaryButton}" ><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE767;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,5,0"/><TextBlock Text="Nghe"/></StackPanel></Button>
                        <Button AutomationProperties.Name="Xóa" Style="{StaticResource SecondaryButton}" Click="ClearSource_Click" BorderThickness="0" Cursor="Hand" MinHeight="28" Padding="8,4" FontSize="12" Margin="8,0,0,0" ><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,5,0"/><TextBlock Text="Xóa"/></StackPanel></Button>
                    </StackPanel><TextBlock DockPanel.Dock="Top" Text="{Binding SourceHeading}" FontSize="11" FontWeight="Bold" Foreground="#65756F" Margin="0" VerticalAlignment="Center" /></DockPanel><Border Style="{StaticResource StudioCard}" Margin="0">
                <DockPanel>
                    <Grid><TextBox x:Name="SourceEditor" Style="{StaticResource StudioEditor}" Text="{Binding SourceText, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" Foreground="#243D35" BorderThickness="0" FontSize="{Binding EditorFontSize}" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" /><TextBlock Text="Nhập hoặc dán văn bản…" Margin="4" Foreground="#8B9691" FontSize="{Binding EditorFontSize}" IsHitTestVisible="False" TextWrapping="Wrap"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text,ElementName=SourceEditor}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
                </DockPanel>
            </Border>


            </DockPanel><DockPanel Grid.Column="1" Margin="8,0,0,0"><DockPanel DockPanel.Dock="Top" Margin="0,0,0,10" LastChildFill="True"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button AutomationProperties.Name="Nghe" Command="{Binding SpeakTranslatedCommand}" Padding="8,4" Cursor="Hand" MinHeight="28" FontSize="12" Margin="8,0,0,0" Style="{StaticResource SecondaryButton}" ><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE767;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,5,0"/><TextBlock Text="Nghe"/></StackPanel></Button>
                        <Button AutomationProperties.Name="Sao chép" Click="CopyTranslated_Click" Padding="8,4" Cursor="Hand" MinHeight="28" FontSize="12" Margin="8,0,0,0" Style="{StaticResource SecondaryButton}" ><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,5,0"/><TextBlock Text="Sao chép"/></StackPanel></Button>
                    </StackPanel><TextBlock DockPanel.Dock="Top" Text="{Binding TargetHeading}" FontSize="11" FontWeight="Bold" Foreground="#65756F" Margin="0" VerticalAlignment="Center" /></DockPanel><Border Style="{StaticResource StudioCard}" Margin="0">
                <DockPanel>
                    <Grid><TextBox x:Name="TranslationEditor" Style="{StaticResource StudioEditor}" Text="{Binding TranslatedText,Mode=OneWay}" IsReadOnly="True" Background="Transparent" Foreground="#287568" BorderThickness="0" FontSize="{Binding EditorFontSize}" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" /><TextBlock Text="Bản dịch sẽ hiện tại đây." Margin="4" Foreground="#8B9691" FontSize="{Binding EditorFontSize}" IsHitTestVisible="False" TextWrapping="Wrap"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text,ElementName=TranslationEditor}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
                </DockPanel>
            </Border>
        </DockPanel></Grid>


        <Grid Grid.Row="2" Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<DockPanel Margin="0,0,8,0"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="A−" Command="{Binding DecreaseEditorFontCommand}" ToolTip="Giảm cỡ chữ" Style="{StaticResource SecondaryButton}" MinHeight="28" Padding="6,3"/><TextBlock Text="{Binding EditorFontSize}" VerticalAlignment="Center" Margin="8,0" Foreground="#287568"/><Button Content="A+" Command="{Binding IncreaseEditorFontCommand}" ToolTip="Tăng cỡ chữ" Style="{StaticResource SecondaryButton}" MinHeight="28" Padding="6,3"/></StackPanel><TextBlock Text="{Binding CharacterCountLabel}" FontSize="11" Foreground="#73827C" VerticalAlignment="Center"/></DockPanel>
<TextBlock Grid.Column="1" Text="{Binding Status}" FontSize="12" Foreground="#73827C" Margin="8,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"/>
</Grid>
    </Grid></Grid></DockPanel></UserControl>