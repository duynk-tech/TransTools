<UserControl x:Class="TransTools.Views.QuickTranslateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:TransTools.ViewModels">

    <DockPanel>
 <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,16">
  <RadioButton Content="Dịch &amp; Ngữ pháp" IsChecked="True" GroupName="QuickTool" Checked="TranslationTool_Checked" Margin="0,0,20,0" Cursor="Hand"/>
  <RadioButton Content="Đọc văn bản" GroupName="QuickTool" Checked="ReadingTool_Checked" Cursor="Hand"/>
 </StackPanel>
 <Grid>
 <ContentControl x:Name="ReaderContent" Visibility="Collapsed"/>
 <Grid x:Name="TranslationContent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Controls: Domain & Languages -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#C2DDD5" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <WrapPanel VerticalAlignment="Center" Margin="0,0,0,50">
                    <TextBlock Text="Chuyên ngành:" FontWeight="SemiBold" Foreground="#65756F" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox SelectedValuePath="Content" SelectedValue="{Binding SelectedDomain}" Width="160" Background="#F5F8F7" Foreground="#243D35" Margin="0,0,20,0">
                        <ComboBoxItem Content="Thông dụng" IsSelected="True"/>
                        <ComboBoxItem Content="Công nghệ thông tin"/>
                        <ComboBoxItem Content="Y tế &amp; Sinh học"/>
                        <ComboBoxItem Content="Kinh tế &amp; Tài chính"/>
                        <ComboBoxItem Content="Du lịch &amp; Khách sạn"/>
                        <ComboBoxItem Content="Pháp luật"/>
                    </ComboBox>

                    <TextBlock Text="Ngôn ngữ:" FontWeight="SemiBold" Foreground="#65756F" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox SelectedValuePath="Tag" SelectedValue="{Binding SourceLanguage}" Width="120" Background="#F5F8F7" Foreground="#243D35" Margin="0,0,8,0">
                        <ComboBoxItem Content="Tự động" Tag="auto" IsSelected="True"/>
                        <ComboBoxItem Content="Tiếng Anh" Tag="en"/>
                        <ComboBoxItem Content="Tiếng Việt" Tag="vi"/>
                        <ComboBoxItem Content="Tiếng Nhật" Tag="ja"/>
                        <ComboBoxItem Content="Tiếng Trung" Tag="zh"/>
                        <ComboBoxItem Content="Tiếng Hàn" Tag="ko"/>
                    </ComboBox>

                    <TextBlock Text="➔" Foreground="#73827C" VerticalAlignment="Center" Margin="0,0,8,0"/>

                    <ComboBox SelectedValuePath="Tag" SelectedValue="{Binding TargetLanguage}" Width="120" Background="#F5F8F7" Foreground="#243D35">
                        <ComboBoxItem Content="Tiếng Việt" Tag="vi" IsSelected="True"/>
                        <ComboBoxItem Content="Tiếng Anh" Tag="en"/>
                        <ComboBoxItem Content="Tiếng Nhật" Tag="ja"/>
                        <ComboBoxItem Content="Tiếng Trung" Tag="zh"/>
                        <ComboBoxItem Content="Tiếng Hàn" Tag="ko"/>
                    </ComboBox>
                    <TextBlock Text="Phong cách:" FontWeight="SemiBold" Foreground="#65756F" VerticalAlignment="Center" Margin="16,0,8,0"/>
                    <ComboBox SelectedValuePath="Content" SelectedValue="{Binding SelectedStyle}" Width="120" Background="#F5F8F7" Foreground="#243D35">
                        <ComboBoxItem Content="Tự nhiên" IsSelected="True"/>
                        <ComboBoxItem Content="Trang trọng"/>
                        <ComboBoxItem Content="Học thuật"/>
                        <ComboBoxItem Content="Ngắn gọn"/>
                    </ComboBox>
                </WrapPanel>

                <!-- Actions -->
                <StackPanel Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                    <Button Content="✍️ Sửa ngữ pháp" Command="{Binding CheckGrammarCommand}" Background="#D8E5E1" Foreground="#243D35" Margin="0,0,8,0" Padding="12,8" Cursor="Hand"/>
                    <Button Content="📷 Chụp OCR" Click="CaptureOcr_Click" Background="#D8E5E1" Foreground="#243D35" Margin="0,0,8,0" Padding="12,8" Cursor="Hand"/>
                    <Button Content="⚡ Dịch ngay" Command="{Binding TranslateCommand}" Background="#287568" Foreground="White" FontWeight="Bold" Padding="16,8" Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Translation Dual Panels -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Source Input -->
            <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#C2DDD5" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,8,0">
                <DockPanel>
                    <Grid DockPanel.Dock="Bottom" Margin="0,12,0,0">
                        <Button Content="🔊 Đọc văn bản gốc" Command="{Binding SpeakSourceCommand}" Background="#D8E5E1" Foreground="#243D35" HorizontalAlignment="Left" Padding="10,6" Cursor="Hand"/>
                        <Button Content="Xóa" Style="{StaticResource DestructiveButton}" Click="ClearSource_Click" Background="Transparent" Foreground="#65756F" BorderThickness="0" HorizontalAlignment="Right" Cursor="Hand"/>
                    </Grid>

                    <TextBox Text="{Binding SourceText, UpdateSourceTrigger=PropertyChanged}"
                             Background="Transparent" Foreground="#243D35" BorderThickness="0"
                             FontSize="14" AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"/>
                </DockPanel>
            </Border>

            <!-- Translated Output -->
            <Border Grid.Column="1" Background="#FFFFFF" BorderBrush="#C2DDD5" BorderThickness="1" CornerRadius="12" Padding="16" Margin="8,0,0,0">
                <DockPanel>
                    <Grid DockPanel.Dock="Bottom" Margin="0,12,0,0">
                        <Button Content="🔊 Đọc bản dịch" Command="{Binding SpeakTranslatedCommand}" Background="#287568" Foreground="White" HorizontalAlignment="Left" Padding="10,6" Cursor="Hand"/>
                        <Button Content="📋 Sao chép" Click="CopyTranslated_Click" Background="#D8E5E1" Foreground="#243D35" HorizontalAlignment="Right" Padding="10,6" Cursor="Hand"/>
                    </Grid>

                    <TextBox Text="{Binding TranslatedText}"
                             IsReadOnly="True"
                             Background="Transparent" Foreground="#287568" BorderThickness="0"
                             FontSize="14" AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"/>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Status Footer -->
        <Border Grid.Row="2" Margin="0,12,0,0">
            <TextBlock Text="{Binding Status}" FontSize="12" Foreground="#73827C"/>
        </Border>
    </Grid>
 </Grid>
</DockPanel>
</UserControl>
