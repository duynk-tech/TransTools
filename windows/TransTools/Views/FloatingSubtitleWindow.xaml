<Window x:Class="TransTools.Views.FloatingSubtitleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Phụ đề Trans Tools"
        Height="220" Width="820" MinWidth="780" MinHeight="160"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Border Background="#F5FFFFFF"
            CornerRadius="16"
            BorderBrush="#B5D2C9"
            BorderThickness="1"
            Padding="16,10">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Control Bar (Drag Handle, Mode, Font Size & Close) -->
            <Grid Grid.Row="0" Margin="0,0,0,4">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Fill="#10B981" Margin="0,0,6,0"/>
                    <TextBlock Text="Trans Tools" FontSize="11" FontWeight="Bold" Foreground="#243D35" Margin="0,0,12,0"/>

                    <!-- Subtitle Mode Toggles -->
                    <RadioButton x:Name="ModeBilingual" Content="Song ngữ" IsChecked="True" Foreground="#65756F" FontSize="10" Margin="0,0,8,0" Checked="Mode_Checked"/>
                    <RadioButton x:Name="ModeOriginal" Content="Tiếng gốc" Foreground="#65756F" FontSize="10" Margin="0,0,8,0" Checked="Mode_Checked"/>
                    <RadioButton x:Name="ModeTranslation" Content="Bản dịch" Foreground="#65756F" FontSize="10" Checked="Mode_Checked"/>
                    <CheckBox x:Name="ShowMascot" Content="Trợ lý" Margin="12,0,0,0" FontSize="10"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="StopButton" Content="Dừng cuộc họp" MinHeight="28" Padding="8,2" Margin="0,0,6,0" Background="#FFF1F2" Foreground="#DC2626" BorderBrush="#FECDD3" Click="StopMeeting_Click"/>
                    <Button Content="Mở ứng dụng" MinHeight="28" Padding="5,2" Margin="0,0,6,0" Click="OpenMain_Click"/>
                    <Button Content="A-" Width="22" Height="28" MinHeight="28" Padding="2" Background="#D8E5E1" Foreground="#334B43" FontSize="10" Margin="0,0,4,0" Click="FontDecrease_Click" Cursor="Hand"/>
                    <Button Content="A+" Width="22" Height="28" MinHeight="28" Padding="2" Background="#D8E5E1" Foreground="#334B43" FontSize="10" Margin="0,0,8,0" Click="FontIncrease_Click" Cursor="Hand"/>
                    <Button Content="✕" Width="20" Height="28" MinHeight="28" Padding="2" Background="Transparent" Foreground="#65756F" BorderThickness="0" Click="CloseButton_Click" Cursor="Hand"/>
                </StackPanel>
            </Grid>

            <!-- Subtitle Lines -->
            <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Image Grid.Column="0" Source="/TransTools;component/Resources/Mascot/MascotSprites/angles/angle_front.png" Width="80" Stretch="Uniform" Margin="0,0,14,0" Visibility="{Binding IsChecked,ElementName=ShowMascot,Converter={StaticResource BoolVisibility}}"/>
            <ScrollViewer x:Name="CaptionScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto"><StackPanel VerticalAlignment="Center">
                <!-- Original Text -->
                <TextBlock x:Name="OriginalText"
                           Text="Chờ nội dung cuộc họp…"
                           FontSize="13"
                           Foreground="#65756F"
                           TextWrapping="Wrap"

                           />

                <!-- Vietnamese Translated Text -->
                <TextBlock x:Name="TranslatedText"
                           Text="Đang lắng nghe âm thanh cuộc họp..."
                           FontSize="16"
                           FontWeight="Bold"
                           Foreground="#287568"
                           TextWrapping="Wrap"


                           Margin="0,2,0,0"/>
            </StackPanel></ScrollViewer></Grid>
        </Grid>
    </Border>
</Window>
