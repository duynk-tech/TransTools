<UserControl x:Class="TransTools.Views.VoiceSettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <UserControl.Resources><Style x:Key="VoiceChoice" TargetType="RadioButton"><Setter Property="Cursor" Value="Hand"/><Setter Property="Margin" Value="0,0,0,12"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Border x:Name="Card" Background="#F8FAF9" BorderBrush="#D8E5E1" BorderThickness="1" CornerRadius="14" Padding="20"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid Width="22" Height="22" VerticalAlignment="Top" Margin="0,2,0,0"><Ellipse x:Name="ChoiceRing" Stroke="#87928D" StrokeThickness="2"/><Ellipse x:Name="ChoiceDot" Fill="#287568" Margin="5" Visibility="Collapsed"/></Grid><ContentPresenter Grid.Column="1"/></Grid></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="ChoiceRing" Property="Stroke" Value="#287568"/><Setter TargetName="ChoiceDot" Property="Visibility" Value="Visible"/><Setter TargetName="Card" Property="Background" Value="#E5F1ED"/><Setter TargetName="Card" Property="BorderBrush" Value="#75BBAE"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="#287568"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="#194F45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></UserControl.Resources>
 <StackPanel>
  <Grid Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="250"/></Grid.ColumnDefinitions><TextBlock Text="Ngôn ngữ giọng đọc" VerticalAlignment="Center"/><ComboBox Grid.Column="1" ItemsSource="{Binding Languages}" SelectedItem="{Binding Language}" ItemTemplate="{StaticResource LanguageItem}" IsEnabled="{Binding CanConfigure}"/></Grid>
  <UniformGrid Columns="2" Margin="0,0,0,20"><RadioButton x:Name="DefaultTab" AutomationProperties.Name="Mặc định" GroupName="VoiceSections" Style="{StaticResource SegmentedOption}" IsChecked="True" Checked="Default_Checked"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE767;" FontFamily="Segoe MDL2 Assets" Margin="0,0,7,0" VerticalAlignment="Center"/><TextBlock Text="Mặc định"/></StackPanel></RadioButton><RadioButton x:Name="AdvancedTab" AutomationProperties.Name="Nâng cao" GroupName="VoiceSections" Style="{StaticResource SegmentedOption}" Checked="Advanced_Checked"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE9E9;" FontFamily="Segoe MDL2 Assets" Margin="0,0,7,0" VerticalAlignment="Center"/><TextBlock Text="Nâng cao"/></StackPanel></RadioButton></UniformGrid>
  <StackPanel x:Name="DefaultPanel" IsEnabled="{Binding CanConfigure}">
   <RadioButton Style="{StaticResource VoiceChoice}" GroupName="VoiceEngine" IsChecked="{Binding Engine,Mode=TwoWay,Converter={StaticResource OptionSelection},ConverterParameter=Supertonic 3}" Visibility="{Binding SupportsNatural,Converter={StaticResource BoolVisibility}}"><StackPanel><TextBlock Text="Giọng tự nhiên · Supertonic 3" FontWeight="SemiBold" FontSize="16"/><TextBlock Text="Offline sau khi tải · Việt, Anh, Nhật, Hàn" Foreground="#65756F" Margin="0,6,0,0"/><TextBlock Text="{Binding Management.LocalVoiceStatus}" Foreground="#287568" Margin="0,10,0,0"/></StackPanel></RadioButton>
   <Button Content="Tải giọng tự nhiên" Command="{Binding Management.InstallVoiceCommand}" IsEnabled="{Binding Management.CanManageModels}" HorizontalAlignment="Right" Margin="0,0,0,16"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding SupportsNatural}" Value="True"/><Condition Binding="{Binding Management.ShowSupertonicInstall}" Value="True"/></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible"/></MultiDataTrigger></Style.Triggers></Style></Button.Style></Button>
   
   <RadioButton Style="{StaticResource VoiceChoice}" GroupName="VoiceEngine" IsChecked="{Binding Engine,Mode=TwoWay,Converter={StaticResource OptionSelection},ConverterParameter=Giọng cơ bản}"><StackPanel><TextBlock Text="Giọng cơ bản" FontWeight="SemiBold" FontSize="16"/><TextBlock Text="Giọng có sẵn của Windows · Không cần tải mô hình" Foreground="#65756F" Margin="0,6,0,0"/></StackPanel></RadioButton>
   <RadioButton Style="{StaticResource VoiceChoice}" GroupName="VoiceEngine" IsChecked="{Binding Engine,Mode=TwoWay,Converter={StaticResource OptionSelection},ConverterParameter=Edge}"><StackPanel><TextBlock Text="Giọng AI trực tuyến · Edge" FontWeight="SemiBold" FontSize="16"/><TextBlock Text="Cần mạng · Nội dung đọc gửi tới dịch vụ giọng nói" Foreground="#65756F" Margin="0,6,0,0"/></StackPanel></RadioButton>
  </StackPanel>
  <Border x:Name="AdvancedPanel" Visibility="Collapsed" Background="#F8FAF9" BorderBrush="#C2DDD5" BorderThickness="1" CornerRadius="14" Padding="20" Margin="0,0,0,20"><StackPanel>
   <TextBlock Text="Chọn giọng theo ngôn ngữ" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,16"/><ComboBox ItemsSource="{Binding Engines}" SelectedItem="{Binding Engine}" IsEnabled="{Binding CanConfigure}"/>
   <TextBlock Text="VieNeu v3 Turbo dành cho tiếng Việt. Cần tải mô hình trước khi nghe; tốc độ hiện dùng nhịp đọc gốc." TextWrapping="Wrap" Foreground="#65756F" Margin="0,12,0,16"/>
   <WrapPanel><Button Content="Tải giọng VieNeu" Command="{Binding Management.InstallVieNeuCommand}" IsEnabled="{Binding Management.HasVieNeuProcessor}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8"/><Button Content="Quản lý mô hình" Click="ManageModels_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,0,8"/></WrapPanel>
   <Border Visibility="{Binding SupportsPersonalVoice,Converter={StaticResource BoolVisibility}}" Background="White" BorderBrush="#C2DDD5" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,12,0,0"><StackPanel>
    <DockPanel Margin="0,0,0,12"><Button DockPanel.Dock="Right" Content="Thu giọng mới" Click="RecordVoice_Click" Style="{StaticResource SecondaryButton}" IsEnabled="{Binding CanConfigure}"/><TextBlock Text="Giọng của tôi" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
    <DockPanel><Button DockPanel.Dock="Right" Command="{Binding RefreshPersonalVoicesCommand}" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" ToolTip="Làm mới danh sách giọng" AutomationProperties.Name="Làm mới giọng cá nhân"><TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets"/></Button><ComboBox ItemsSource="{Binding PersonalVoices}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedPersonalVoice}" IsEnabled="{Binding CanConfigure}" AutomationProperties.Name="Giọng cá nhân"/></DockPanel>
    <TextBlock Text="{Binding PersonalVoiceHint}" TextWrapping="Wrap" Foreground="#65756F" Margin="0,10,0,0"/>
   </StackPanel></Border>
  </StackPanel></Border>
  <Border Background="White" BorderBrush="#C2DDD5" BorderThickness="1" CornerRadius="14" Padding="20" Margin="0,0,0,16"><StackPanel>
   <TextBlock Text="Tùy chỉnh &amp; Nghe thử" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,16"/><Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions><TextBlock Text="Tốc độ đọc" VerticalAlignment="Center"/><Slider Grid.Column="1" Minimum="0.7" Maximum="1.5" TickFrequency="0.1" IsSnapToTickEnabled="True" Value="{Binding Rate}" IsEnabled="{Binding CanChangeRate}" VerticalAlignment="Center"/><TextBlock Grid.Column="2" Text="{Binding Rate,StringFormat={}{0:F1}×}" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
   <TextBox Text="{Binding SampleText,UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" VerticalContentAlignment="Top" TextWrapping="Wrap" MinHeight="90" IsEnabled="{Binding CanConfigure}"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0"><Button AutomationProperties.Name="Nghe thử" Command="{Binding PreviewCommand}" IsEnabled="{Binding CanConfigure}" Margin="0,0,8,0"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE767;" FontFamily="Segoe MDL2 Assets" Margin="0,0,7,0" VerticalAlignment="Center"/><TextBlock Text="Nghe thử"/></StackPanel></Button><Button AutomationProperties.Name="Dừng" Command="{Binding StopPreviewCommand}" IsEnabled="{Binding IsPreviewing}" Style="{StaticResource SecondaryButton}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE71A;" FontFamily="Segoe MDL2 Assets" Margin="0,0,7,0" VerticalAlignment="Center"/><TextBlock Text="Dừng"/></StackPanel></Button></StackPanel>
  </StackPanel></Border>
  <TextBlock Text="{Binding Status}" Foreground="#65756F" TextWrapping="Wrap" Margin="0,0,0,16"/>
 </StackPanel>
</UserControl>
