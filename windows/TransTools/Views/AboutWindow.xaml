<Window x:Class="TransTools.Views.AboutWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Giới thiệu Trans Tools" Width="560" Height="680" MinWidth="480" MinHeight="540" WindowStartupLocation="CenterOwner" Background="#F2FAF7" ShowInTaskbar="False">
 <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
 <Grid Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition Width="76"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Image Source="/TransTools;component/Resources/AppIcon.png" Width="60" Height="60"/><StackPanel Grid.Column="1" VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><TextBlock Text="Trans Tools" FontSize="23" FontWeight="Bold"/><Border Background="#DCEEE6" CornerRadius="8" Padding="7,3" Margin="10,0,0,0" VerticalAlignment="Center"><TextBlock x:Name="VersionLabel" Foreground="#287568" FontSize="11"/></Border></StackPanel><TextBlock Text="Hiểu nhau dễ hơn. Học ngôn ngữ mỗi ngày." Foreground="#65756F" Margin="0,5,0,0" TextWrapping="Wrap"/></StackPanel></Grid>
 <TextBlock Text="Trans Tools đồng hành cùng bạn trong cuộc họp, đọc văn bản và luyện ngoại ngữ. Nghe và xem bản dịch, lưu điều quan trọng, rồi tiếp tục học từ những cuộc trò chuyện hằng ngày." Foreground="#65756F" TextWrapping="Wrap" LineHeight="21" Margin="0,0,0,20"/>
 <UniformGrid Columns="2"><Border Style="{StaticResource TranscriptCard}" Margin="0,0,6,12"><StackPanel><TextBlock Text="Cuộc họp &amp; Phụ đề" FontWeight="SemiBold"/><TextBlock Text="Theo dõi hội thoại song ngữ, lưu bản ghi và việc cần làm." TextWrapping="Wrap" Foreground="#65756F" Margin="0,7,0,0"/></StackPanel></Border><Border Style="{StaticResource TranscriptCard}" Margin="6,0,0,12"><StackPanel><TextBlock Text="Dịch nhanh" FontWeight="SemiBold"/><TextBlock Text="Dịch văn bản, chỉnh ngữ pháp theo ngữ cảnh của bạn." TextWrapping="Wrap" Foreground="#65756F" Margin="0,7,0,0"/></StackPanel></Border><Border Style="{StaticResource TranscriptCard}" Margin="0,0,6,12"><StackPanel><TextBlock Text="Đọc &amp; Học ngôn ngữ" FontWeight="SemiBold"/><TextBlock Text="Nghe văn bản, khám phá truyện và luyện tập mỗi ngày." TextWrapping="Wrap" Foreground="#65756F" Margin="0,7,0,0"/></StackPanel></Border><Border Style="{StaticResource TranscriptCard}" Margin="6,0,0,12"><StackPanel><TextBlock Text="Trò chuyện &amp; Trợ lý" FontWeight="SemiBold"/><TextBlock Text="Luyện giao tiếp cùng AI và trợ lý cá nhân trên màn hình." TextWrapping="Wrap" Foreground="#65756F" Margin="0,7,0,0"/></StackPanel></Border></UniformGrid>
 <Expander Header="Học liệu &amp; Nguồn phát âm" Margin="0,6,0,16"><TextBlock Text="Thư viện truyện giữ liên kết nguồn Wikisource và Project Gutenberg. Các bản ghi phát âm do bạn nhập được lưu riêng trên máy. Nguồn và tác quyền thuộc đơn vị cung cấp; hãy xem liên kết gốc trong từng học liệu." TextWrapping="Wrap" Foreground="#65756F" Margin="0,10,0,0"/></Expander>
 <TextBlock Text="Tác giả: DuyNK-Tech" FontWeight="SemiBold" Margin="0,0,0,12"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="khacduy90@gmail.com" VerticalAlignment="Center"/><Button x:Name="CopyEmail" Grid.Column="1" Content="Chép email" Click="CopyEmail_Click" Style="{StaticResource SecondaryButton}"/></Grid>
 <Button Content="GitHub · Trans Tools ↗" Click="GitHub_Click" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,12,0,0"/>
 </StackPanel></ScrollViewer><Button Grid.Row="1" Content="Đóng" Click="Close_Click" HorizontalAlignment="Right" Margin="0,20,0,0" MinWidth="96" IsCancel="True"/></Grid>
</Window>