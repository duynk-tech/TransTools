<UserControl x:Class="TransTools.Views.NotebookVocabularyView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid Margin="24,20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <Grid Margin="0,0,12,0"><TextBox x:Name="SearchBox" TextChanged="SearchChanged" Height="40"/><TextBlock Text="Tìm từ, nghĩa hoặc câu ví dụ…" Margin="12,0" Foreground="#93A19B" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text,ElementName=SearchBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
   <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,12,0"><RadioButton x:Name="AllWords" Content="Tất cả" GroupName="WordState" IsChecked="True" Style="{StaticResource SegmentedOption}" Checked="StateChanged"/><RadioButton x:Name="DueWords" Content="Cần ôn" GroupName="WordState" Style="{StaticResource SegmentedOption}" Checked="StateChanged"/><RadioButton x:Name="LearningWords" Content="Đang học" GroupName="WordState" Style="{StaticResource SegmentedOption}" Checked="StateChanged"/><RadioButton x:Name="MasteredWords" Content="Đã thuộc" GroupName="WordState" Style="{StaticResource SegmentedOption}" Checked="StateChanged"/></StackPanel>
   <ComboBox x:Name="LanguagePicker" Grid.Column="2" Width="150" ItemsSource="{Binding Languages}" ItemTemplate="{StaticResource LanguageItem}" SelectedItem="{Binding SelectedLanguage}" Margin="0,0,12,0"/>
   <Button Grid.Column="3" x:Name="AddWordButton" Content="＋ Thêm từ" Click="ShowAdd_Click"/>
  </Grid>
  <Grid Grid.Row="1"><ListBox x:Name="WordsList" SelectedItem="{Binding SelectedWord}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter HorizontalAlignment="Stretch"/></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle><ListBox.ItemTemplate><DataTemplate>
   <Border Style="{StaticResource TranscriptCard}" Margin="0,0,0,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel><WrapPanel><TextBlock Text="{Binding Word}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Phonetic}" FontSize="12" Foreground="#73827C" Margin="10,2,0,0" TextWrapping="Wrap"/></WrapPanel><TextBlock Text="{Binding Meaning}" FontSize="13" Foreground="#287568" Margin="0,6,0,0" TextWrapping="Wrap"/><TextBlock Text="{Binding ExampleSentence}" Foreground="#65756F" Margin="0,8,0,0" TextWrapping="Wrap"/><TextBlock Text="{Binding ExampleTranslation}" Foreground="#287568" Margin="0,4,0,0" TextWrapping="Wrap"/></StackPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="16,0,0,0"><StackPanel VerticalAlignment="Center" Margin="0,0,12,0"><TextBlock Text="{Binding IntervalDays,StringFormat='Khoảng ôn: {0} ngày'}" Foreground="#65756F" FontSize="11" HorizontalAlignment="Right"/><TextBlock Text="{Binding Repetition,StringFormat='Lần ôn: {0}'}" Foreground="#73827C" FontSize="11" HorizontalAlignment="Right" Margin="0,3,0,0"/></StackPanel><Button Content="&#xE767;" FontFamily="Segoe MDL2 Assets" ToolTip="Nghe phát âm" Width="36" Padding="0" Click="Speak_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/><Button Command="{Binding DataContext.ToggleWordMasteryCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource SecondaryButton}" Width="36" Padding="0" Margin="0,0,8,0" ToolTip="Đánh dấu hoặc bỏ đánh dấu đã thuộc"><TextBlock FontSize="18" Foreground="#287568"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="○"/><Style.Triggers><DataTrigger Binding="{Binding IsMastered}" Value="True"><Setter Property="Text" Value="✓"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Button><Button Content="&#xE74D;" FontFamily="Segoe MDL2 Assets" ToolTip="Xóa từ" Click="Delete_Click" Style="{StaticResource DestructiveButton}"/></StackPanel>
   </Grid></Border>
  </DataTemplate></ListBox.ItemTemplate></ListBox>
  <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"><Image Source="/TransTools;component/Resources/Mascot/MascotWalking.png" Width="96" Height="96" Margin="0,0,0,20"/><TextBlock Text="Chưa có từ phù hợp" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="Thêm từ mới hoặc thay đổi ngôn ngữ và từ tìm kiếm." Foreground="#65756F" Margin="0,10,0,0"/></StackPanel></Grid>
  <TextBlock x:Name="VocabularyStatus" Grid.Row="2" Text="{Binding Status}" Foreground="#65756F" Margin="0,12,0,0" TextWrapping="Wrap"/>
  <Popup x:Name="AddWordPopup" PlacementTarget="{Binding ElementName=AddWordButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True"><Border Width="380" Padding="20" Background="White" BorderBrush="#75BBAE" BorderThickness="1" CornerRadius="14"><StackPanel>
   <TextBlock Text="Thêm từ vựng" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16"/><TextBlock Text="Từ hoặc cụm từ"/><TextBox Text="{Binding NewWord,UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,12"/><TextBlock Text="Phiên âm (không bắt buộc)"/><TextBox Text="{Binding NewPhonetic,UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,12"/><TextBlock Text="Nghĩa tiếng Việt"/><TextBox Text="{Binding NewMeaning,UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,16" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="64"/><TextBlock Text="Câu ví dụ ngữ cảnh · Không bắt buộc"/><TextBox Text="{Binding NewExampleSentence,UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,16" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="64" MaxHeight="120" VerticalScrollBarVisibility="Auto"/><Button Content="Lưu từ" Command="{Binding AddWordCommand}"/>
  </StackPanel></Border></Popup>
 </Grid>
</UserControl>
