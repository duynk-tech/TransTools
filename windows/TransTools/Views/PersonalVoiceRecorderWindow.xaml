<Window x:Class="TransTools.Views.PersonalVoiceRecorderWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Thu giọng của tôi" Width="720" Height="660" MinWidth="580" MinHeight="440" WindowStartupLocation="CenterOwner" Background="White">
 <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,18"><Button DockPanel.Dock="Right" Content="Đóng" Height="40" VerticalAlignment="Center" Click="Close_Click" Style="{StaticResource SecondaryButton}"/><StackPanel><TextBlock Text="Thu giọng của tôi" FontSize="17" FontWeight="Bold" Foreground="#287568"/><TextBlock Text="Đọc tự nhiên trong 3–8 giây, ở nơi yên tĩnh. Bản thu chỉ lưu trên thiết bị." FontSize="13" TextWrapping="Wrap" Foreground="#65756F" Margin="0,8,16,0"/></StackPanel></DockPanel>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel>
   <Border Background="Transparent" Padding="2"><StackPanel>
    <DockPanel Margin="0,0,0,12"><Button DockPanel.Dock="Right" Content="AI tạo đoạn mới" Command="{Binding GenerateScriptCommand}" IsEnabled="{Binding CanEdit}" Style="{StaticResource SecondaryButton}"/><TextBlock Text="Đoạn đọc mẫu" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
    <Border Background="#EBF4EF" BorderBrush="#9EBFB6" BorderThickness="1.5" CornerRadius="14" Padding="20" Margin="0,0,0,18"><TextBlock x:Name="ReadingBoard" FontSize="27" FontWeight="Medium" LineHeight="37" MinHeight="130" TextWrapping="Wrap" Foreground="#243D35"/></Border>
    <CheckBox Content="Tô chữ dẫn nhịp đọc" IsChecked="{Binding GuideEnabled}" IsEnabled="{Binding CanEdit}" Margin="0,0,0,8"/><TextBlock Text="Chữ sáng theo nhịp gợi ý, không theo dõi chính xác giọng nói. Đọc liền mạch, không cần chạy theo từng chữ." FontSize="11" Foreground="#65756F" TextWrapping="Wrap" Margin="0,0,0,12"/><ProgressBar Maximum="8" Value="{Binding RecordedSeconds}" Height="5" Foreground="#287568" Margin="0,0,0,8"/><TextBlock Text="{Binding RecordedSeconds,StringFormat={}{0:F1} / 8 giây}" Foreground="#65756F" Margin="0,0,0,12"/>
    <StackPanel Orientation="Horizontal">    <Button x:Name="RecordVoiceButton" Command="{Binding ToggleRecordingCommand}" HorizontalAlignment="Left" IsEnabled="{Binding CanToggle}"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Content" Value="Bắt đầu thu"/><Style.Triggers><DataTrigger Binding="{Binding HasUsableRecording}" Value="True"><Setter Property="Content" Value="Thu lại"/></DataTrigger><DataTrigger Binding="{Binding IsPreparing}" Value="True"><Setter Property="Content" Value="Hủy đếm ngược"/></DataTrigger><DataTrigger Binding="{Binding IsRecording}" Value="True"><Setter Property="Content" Value="Dừng thu"/><Setter Property="IsEnabled" Value="True"/></DataTrigger><DataTrigger Binding="{Binding IsProcessing}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger></Style.Triggers></Style></Button.Style></Button><TextBlock Text="{Binding Countdown,StringFormat=Bắt đầu sau {0}…}" Visibility="{Binding IsPreparing,Converter={StaticResource BoolVisibility}}" FontSize="14" FontWeight="SemiBold" Foreground="#287568" VerticalAlignment="Center" Margin="12,0,0,0"/></StackPanel>
    <StackPanel Orientation="Horizontal" Margin="0,12,0,0"><Button x:Name="PreviewVoiceButton" Content="Nghe bản thu" Command="{Binding PreviewRecordingCommand}" IsEnabled="{Binding CanPreview}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/><Button Content="Dừng nghe" Command="{Binding StopPreviewCommand}" IsEnabled="{Binding IsPreviewing}" Style="{StaticResource SecondaryButton}"/></StackPanel>
   </StackPanel></Border>
   <Grid Margin="0,20,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Tên giọng" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{Binding VoiceName,UpdateSourceTrigger=PropertyChanged}" MaxLength="100" IsEnabled="{Binding CanEdit}" AutomationProperties.Name="Tên giọng cá nhân"/></Grid>
   <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Foreground="#287568" Margin="0,0,0,16"/>
  </StackPanel></ScrollViewer>
  <StackPanel Grid.Row="2" Margin="0,16,0,0"><Border Height="1" Background="#DEE7E3" Margin="0,0,0,12"/><TextBlock Text="AI chỉ tạo đoạn văn. Bản thu lưu trên thiết bị; mô hình tương thích dùng bản thu để tạo giọng cá nhân." FontSize="11" Foreground="#65756F" TextWrapping="Wrap" Margin="0,0,0,12"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Hủy" Command="{Binding CancelCreationCommand}" IsEnabled="{Binding IsProcessing}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/><Button x:Name="SaveVoiceButton" Content="Tạo và lưu giọng" Command="{Binding SaveVoiceCommand}" IsEnabled="{Binding CanSave}"/></StackPanel></StackPanel>
 </Grid>
</Window>
