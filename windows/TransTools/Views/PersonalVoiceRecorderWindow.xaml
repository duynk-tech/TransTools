<Window x:Class="TransTools.Views.PersonalVoiceRecorderWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Thu giọng của tôi" Width="700" Height="520" MinWidth="580" MinHeight="440" WindowStartupLocation="CenterOwner" Background="#F2FAF7">
 <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,18"><Button DockPanel.Dock="Right" Content="Đóng" Height="40" VerticalAlignment="Center" Click="Close_Click" Style="{StaticResource SecondaryButton}"/><StackPanel><TextBlock Text="Thu giọng của tôi" FontSize="24" FontWeight="SemiBold" Foreground="#287568"/><TextBlock Text="Đọc rõ, tự nhiên trong 3–8 giây. Bản thu chỉ lưu trên máy." TextWrapping="Wrap" Foreground="#65756F" Margin="0,8,16,0"/></StackPanel></DockPanel>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel>
   <Border Background="White" BorderBrush="#C2DDD5" BorderThickness="1" CornerRadius="14" Padding="20"><StackPanel>
    <DockPanel Margin="0,0,0,12"><Button DockPanel.Dock="Right" Content="AI tạo đoạn mới" Command="{Binding GenerateScriptCommand}" IsEnabled="{Binding CanEdit}" Style="{StaticResource SecondaryButton}"/><TextBlock Text="Đoạn đọc mẫu" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
    <TextBlock x:Name="ReadingBoard" FontSize="20" LineHeight="30" TextWrapping="Wrap" Foreground="#243D35" Margin="0,0,0,16"/>
    <CheckBox Content="Tô chữ dẫn nhịp đọc" IsChecked="{Binding GuideEnabled}" Margin="0,0,0,12"/><ProgressBar Maximum="8" Value="{Binding RecordedSeconds}" Height="5" Foreground="#287568" Margin="0,0,0,8"/><TextBlock Text="{Binding RecordedSeconds,StringFormat={}{0:F1} / 8 giây}" Foreground="#65756F" Margin="0,0,0,12"/>
    <Button x:Name="RecordVoiceButton" Command="{Binding ToggleRecordingCommand}" HorizontalAlignment="Left" IsEnabled="{Binding CanToggle}"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Content" Value="Bắt đầu thu"/><Style.Triggers><DataTrigger Binding="{Binding IsRecording}" Value="True"><Setter Property="Content" Value="Dừng thu"/><Setter Property="IsEnabled" Value="True"/></DataTrigger><DataTrigger Binding="{Binding IsProcessing}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
    <StackPanel Orientation="Horizontal" Margin="0,12,0,0"><Button x:Name="PreviewVoiceButton" Content="Nghe bản thu" Command="{Binding PreviewRecordingCommand}" IsEnabled="{Binding CanPreview}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/><Button Content="Dừng nghe" Command="{Binding StopPreviewCommand}" IsEnabled="{Binding IsPreviewing}" Style="{StaticResource SecondaryButton}"/></StackPanel>
   </StackPanel></Border>
   <Grid Margin="0,20,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Tên giọng" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{Binding VoiceName,UpdateSourceTrigger=PropertyChanged}" MaxLength="100" IsEnabled="{Binding CanEdit}" AutomationProperties.Name="Tên giọng cá nhân"/></Grid>
   <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Foreground="#287568" Margin="0,0,0,16"/>
  </StackPanel></ScrollViewer>
  <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0"><Button Content="Hủy" Command="{Binding CancelCreationCommand}" IsEnabled="{Binding IsProcessing}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/><Button x:Name="SaveVoiceButton" Content="Tạo và lưu giọng" Command="{Binding SaveVoiceCommand}" IsEnabled="{Binding CanSave}"/></StackPanel>
 </Grid>
</Window>
