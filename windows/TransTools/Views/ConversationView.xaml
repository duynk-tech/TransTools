<UserControl x:Class="TransTools.Views.ConversationView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:TransTools.Views" xmlns:experience="clr-namespace:TransTools.Services.Experience">
<Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<Grid Margin="0,4,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
<StackPanel><TextBlock Text="Trò chuyện" FontSize="22" FontWeight="SemiBold"/><TextBlock Foreground="#65756F" Margin="0,4,0,0"><Run Text="{Binding TargetLanguage}"/><Run Text=" · "/><Run Text="{Binding CurrentTopic}"/></TextBlock></StackPanel>
<StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="＋ Tạo mới" Command="{Binding NewConversationCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/><Button x:Name="LibraryButton" Content="Hội thoại" Click="ShowLibrary_Click" Style="{StaticResource SecondaryButton}"/></StackPanel>
<Popup x:Name="LibraryPopup" PlacementTarget="{Binding ElementName=LibraryButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True"><Border Background="White" BorderBrush="#B5D2C9" BorderThickness="1" CornerRadius="12" Padding="16" Width="360"><StackPanel><TextBlock Text="Hội thoại đã lưu" FontWeight="SemiBold" Margin="0,0,0,12"/><ComboBox ItemsSource="{Binding Sessions}" DisplayMemberPath="Title" SelectedItem="{Binding SelectedSession}" IsEnabled="{Binding CanChangeSession}"/><Button Content="Xóa hội thoại đã chọn" Command="{Binding DeleteConversationCommand}" Style="{StaticResource DestructiveButton}" Margin="0,12,0,0"/></StackPanel></Border></Popup>
</Grid>
<WrapPanel Grid.Row="1" Margin="0,0,0,8"><StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8"><ComboBox IsEnabled="{Binding CanChangeSession}" SelectedValuePath="Tag" SelectedValue="{Binding TargetLanguage}" Width="165" ToolTip="Ngôn ngữ trò chuyện" Margin="0,0,12,0"><ComboBoxItem Content="Tiếng Anh" Tag="Tiếng Anh (English)"/><ComboBoxItem Content="Tiếng Nhật" Tag="Tiếng Nhật (日本語)"/><ComboBoxItem Content="Tiếng Trung" Tag="Tiếng Trung (中文)"/><ComboBoxItem Content="Tiếng Hàn" Tag="Tiếng Hàn (한국어)"/><ComboBoxItem Content="Tiếng Việt" Tag="Tiếng Việt"/></ComboBox>
</StackPanel><StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8"><ComboBox IsEnabled="{Binding CanChangeSession}" SelectedValuePath="Tag" SelectedValue="{Binding CurrentTopic}" Width="225" ToolTip="Chủ đề trò chuyện" Margin="0,0,12,0"><ComboBoxItem Content="Phỏng vấn xin việc" Tag="Phỏng vấn xin việc (Job Interview)"/><ComboBoxItem Content="Du lịch &amp; Khách sạn" Tag="Du lịch &amp; Nhận phòng khách sạn"/><ComboBoxItem Content="Công nghệ &amp; Lập trình" Tag="Công nghệ &amp; Lập trình viên"/><ComboBoxItem Content="Giao tiếp hằng ngày" Tag="Giao tiếp xã giao hàng ngày"/><ComboBoxItem Content="Thuyết trình dự án" Tag="Thuyết trình dự án"/></ComboBox>
</StackPanel><StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8"><Button x:Name="TopicButton" Content="Chủ đề &amp; Tên của bạn" Click="ShowTopic_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,16,0"/>
</StackPanel><StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8"><TextBlock Text="Chờ gửi" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBox x:Name="SendDelayInput" PreviewTextInput="SendDelay_PreviewTextInput" LostFocus="SendDelay_LostFocus" Text="{Binding SendDelaySeconds,UpdateSourceTrigger=LostFocus}" Width="54" Height="40" Padding="6,4" TextAlignment="Center" MaxLength="2" ToolTip="Nhập từ 1 đến 30 giây"/><StackPanel Margin="4,0,0,0"><Button Content="＋" Command="{Binding IncreaseSendDelayCommand}" MinHeight="20" Height="20" Width="24" Padding="0" Style="{StaticResource SecondaryButton}" ToolTip="Tăng thời gian chờ"/><Button Content="−" Command="{Binding DecreaseSendDelayCommand}" MinHeight="20" Height="20" Width="24" Padding="0" Style="{StaticResource SecondaryButton}" ToolTip="Giảm thời gian chờ"/></StackPanel><TextBlock Text="giây" VerticalAlignment="Center" Margin="8,0,16,0"/>
</StackPanel><StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8"><CheckBox Content="Gợi ý" IsChecked="{Binding SuggestionsEnabled}" Margin="0,0,16,0"/><CheckBox Content="Dịch Tiếng Việt" IsChecked="{Binding ShowVietnameseTranslation}" Visibility="{Binding CanShowTranslation, Converter={StaticResource BoolVisibility}}" VerticalAlignment="Center"/>
</StackPanel></WrapPanel>
<Popup x:Name="TopicPopup" PlacementTarget="{Binding ElementName=TopicButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True"><Border Background="White" BorderBrush="#B5D2C9" BorderThickness="1" CornerRadius="12" Padding="16" Width="400"><StackPanel><TextBlock Text="Tên của bạn" FontWeight="SemiBold" Margin="0,0,0,8"/><TextBox x:Name="LearnerNameInput" Text="{Binding LearnerName,UpdateSourceTrigger=PropertyChanged}" MaxLength="120" IsEnabled="{Binding CanEditLearnerName}"/><TextBlock Text="Gợi ý từ tên trên máy. Bạn có thể sửa hoặc để trống để chào chung. Tên được gửi AI khi tạo lời chào." Foreground="#65756F" TextWrapping="Wrap" Margin="0,8,0,16"/><TextBlock Text="Hướng dẫn riêng cho cuộc trò chuyện" FontWeight="SemiBold" Margin="0,0,0,12"/><TextBox IsEnabled="{Binding CanChangeSession}" Text="{Binding CustomPrompt,UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" Height="100" VerticalScrollBarVisibility="Auto"/><CheckBox Content="Tự gửi câu đã nhận diện" IsChecked="{Binding SendRecognizedSpeechAutomatically}" Margin="0,12,0,0"/><CheckBox Content="Đọc câu trả lời" IsChecked="{Binding AutoSpeakResponse}" Margin="0,12,0,0"/></StackPanel></Border></Popup>
<Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border BorderBrush="#C2DDD5" BorderThickness="1" CornerRadius="18" ClipToBounds="True"><Grid><Border Background="#80FFFFFF"/><Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<ListBox ItemTemplate="{StaticResource ConversationBubble}" x:Name="MessageList" ItemsSource="{Binding Messages}" Background="Transparent" BorderThickness="0" Padding="16" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.ScrollUnit="Pixel">
 <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Top"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Top"/></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>

</ListBox>

<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24"><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Messages.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style><Path Data="M2,2 L13,2 Q15,2 15,4 L15,11 L7,11 L3,15 L3,11 L1,11 L1,3 Z M7,12 L7,15 L13,15 L17,19 L17,15 L19,15 L19,7 L16,7" Stroke="#287568" StrokeThickness="1.4" StrokeLineJoin="Round" Stretch="Uniform" Width="48" Height="48" Margin="0,0,0,16"/><TextBlock Text="Cùng bắt đầu trò chuyện" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="Bấm Bắt đầu, trợ lý sẽ mở lời theo chủ đề bạn chọn." TextAlignment="Center" Foreground="#65756F" Margin="0,12,0,0" TextWrapping="Wrap"/></StackPanel>
<Border Grid.Row="1" Background="#FAFCFB" BorderBrush="#B5D2C9" BorderThickness="0,1,0,0" CornerRadius="0,0,18,18" Padding="14"><StackPanel><TextBlock Text="{Binding Status}" Foreground="#65756F" Margin="0,0,0,10" TextWrapping="Wrap"/>
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><Button x:Name="ConversationActionButton" Content="{Binding ConversationActionLabel}" Command="{Binding ToggleConversationCommand}" Margin="0,0,8,0"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding IsConversationActive}" Value="True"><Setter Property="Background" Value="#DC2626"/><Setter Property="BorderBrush" Value="#EF9C9C"/></DataTrigger></Style.Triggers></Style></Button.Style></Button><Button x:Name="InterruptReplyButton" Content="Nói tiếp" Command="{Binding InterruptReplyCommand}" Visibility="{Binding CanInterruptReply,Converter={StaticResource BoolVisibility}}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/><Button Content="Lưu buổi trò chuyện" Command="{Binding SaveConversationCommand}" IsEnabled="{Binding CanSaveConversation}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/></StackPanel><TextBox Grid.Column="1" Margin="12,0,0,0" x:Name="ConversationInput" Text="{Binding UserInput,UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding InputReadOnly}" FontSize="15" Padding="12,8" KeyDown="InputTextBox_KeyDown" ToolTip="Nhập câu trả lời, Enter để gửi"/><StackPanel Grid.Column="2" Orientation="Horizontal"><Button ToolTip="{Binding MicrophoneLabel}" AutomationProperties.Name="{Binding MicrophoneLabel}" Command="{Binding ToggleMicrophoneCommand}" Style="{StaticResource SecondaryButton}" Width="40" Padding="0" Margin="8,0"><TextBlock Text="&#xE720;" FontFamily="Segoe MDL2 Assets" FontSize="17"/></Button><Button Content="Gửi" Command="{Binding SendMessageCommand}" IsEnabled="{Binding CanSendMessage}"/></StackPanel></Grid>
</StackPanel></Border></Grid></Grid></Border><ScrollViewer x:Name="ConversationHelpPanel" Grid.Column="1" Width="260" Margin="16,0,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="{Binding SuggestionsEnabled,Converter={StaticResource BoolVisibility}}"><Border Background="#EAF5F1" CornerRadius="14" Padding="14"><StackPanel>
<TextBlock Text="Gợi ý trả lời" FontSize="16" FontWeight="SemiBold" Foreground="#287568"/>
<TextBlock Text="{Binding HelpStatus}" FontSize="12" Foreground="#65756F" TextWrapping="Wrap" Margin="0,8,0,14"/>
<ItemsControl ItemsSource="{Binding Suggestions}"><ItemsControl.ItemTemplate><DataTemplate><Border Background="#DCEEE8" CornerRadius="12" Padding="12" Margin="0,0,0,14"><StackPanel>
<TextBlock Text="{Binding Text}" FontSize="14" FontWeight="Medium" TextWrapping="Wrap" LineHeight="21"/>
<TextBlock Text="{Binding Vietnamese}" FontSize="13" Foreground="#65756F" TextWrapping="Wrap" LineHeight="19" Margin="0,8,0,0"/>
<Button Content="Nghe mẫu" Command="{Binding DataContext.ListenSuggestionCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,8,0,0"/>
</StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
<Button x:Name="RefreshConversationHelpButton" Content="Gợi ý khác" Command="{Binding RefreshHelpCommand}" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,0,0,14"/>
<TextBlock Text="Gợi ý để tham khảo; hãy thử tự nói câu trả lời. Dừng hội thoại để nghe mẫu." FontSize="12" Foreground="#65756F" TextWrapping="Wrap"/>
</StackPanel></Border></ScrollViewer></Grid>
</Grid></UserControl>
