<UserControl x:Class="TransTools.Views.ConversationView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:TransTools.Views" xmlns:experience="clr-namespace:TransTools.Services.Experience">
<Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<Grid Margin="0,4,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
<StackPanel><TextBlock Text="Trò chuyện" FontSize="22" FontWeight="SemiBold"/><TextBlock Foreground="#65756F" Margin="0,4,0,0"><Run Text="{Binding TargetLanguage}"/><Run Text=" · "/><Run Text="{Binding CurrentTopic}"/></TextBlock></StackPanel>
<StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="＋ Tạo mới" Command="{Binding NewConversationCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/><Button x:Name="LibraryButton" Content="Hội thoại" Click="ShowLibrary_Click" Style="{StaticResource SecondaryButton}"/></StackPanel>
<Popup x:Name="LibraryPopup" PlacementTarget="{Binding ElementName=LibraryButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True"><Border Background="White" BorderBrush="#B5D2C9" BorderThickness="1" CornerRadius="12" Padding="16" Width="360"><StackPanel><TextBlock Text="Hội thoại đã lưu" FontWeight="SemiBold" Margin="0,0,0,12"/><ComboBox ItemsSource="{Binding Sessions}" DisplayMemberPath="Title" SelectedItem="{Binding SelectedSession}" IsEnabled="{Binding CanChangeSession}"/><Button Content="Xóa hội thoại đã chọn" Command="{Binding DeleteConversationCommand}" Style="{StaticResource DestructiveButton}" Margin="0,12,0,0"/></StackPanel></Border></Popup>
</Grid>
<WrapPanel Grid.Row="1" Margin="0,0,0,8"><StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8"><TextBlock Text="Ngôn ngữ" VerticalAlignment="Center" Margin="0,0,8,0"/><ComboBox IsEnabled="{Binding CanChangeSession}" SelectedValuePath="Tag" SelectedValue="{Binding TargetLanguage}" Width="155" Margin="0,0,16,0"><ComboBoxItem Content="Tiếng Anh" Tag="Tiếng Anh (English)"/><ComboBoxItem Content="Tiếng Nhật" Tag="Tiếng Nhật (日本語)"/><ComboBoxItem Content="Tiếng Trung" Tag="Tiếng Trung (中文)"/><ComboBoxItem Content="Tiếng Hàn" Tag="Tiếng Hàn (한국어)"/><ComboBoxItem Content="Tiếng Việt" Tag="Tiếng Việt"/></ComboBox>
</StackPanel><StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8"><TextBlock Text="Chủ đề" VerticalAlignment="Center" Margin="0,0,8,0"/><ComboBox IsEnabled="{Binding CanChangeSession}" SelectedValuePath="Tag" SelectedValue="{Binding CurrentTopic}" Width="215" Margin="0,0,16,0"><ComboBoxItem Content="Phỏng vấn xin việc" Tag="Phỏng vấn xin việc (Job Interview)"/><ComboBoxItem Content="Du lịch &amp; Khách sạn" Tag="Du lịch &amp; Nhận phòng khách sạn"/><ComboBoxItem Content="Công nghệ &amp; Lập trình" Tag="Công nghệ &amp; Lập trình viên"/><ComboBoxItem Content="Giao tiếp hằng ngày" Tag="Giao tiếp xã giao hàng ngày"/><ComboBoxItem Content="Thuyết trình dự án" Tag="Thuyết trình dự án"/></ComboBox>
</StackPanel><StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8"><Button x:Name="TopicButton" Content="Chủ đề &amp; Tên của bạn" Click="ShowTopic_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,16,0"/>
</StackPanel><StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8"><TextBlock Text="Chờ gửi" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBox x:Name="SendDelayInput" PreviewTextInput="SendDelay_PreviewTextInput" LostFocus="SendDelay_LostFocus" Text="{Binding SendDelaySeconds,UpdateSourceTrigger=LostFocus}" Width="54" Height="40" Padding="6,4" TextAlignment="Center" MaxLength="2" ToolTip="Nhập từ 1 đến 30 giây"/><StackPanel Margin="4,0,0,0"><Button Content="＋" Command="{Binding IncreaseSendDelayCommand}" MinHeight="20" Height="20" Width="24" Padding="0" Style="{StaticResource SecondaryButton}" ToolTip="Tăng thời gian chờ"/><Button Content="−" Command="{Binding DecreaseSendDelayCommand}" MinHeight="20" Height="20" Width="24" Padding="0" Style="{StaticResource SecondaryButton}" ToolTip="Giảm thời gian chờ"/></StackPanel><TextBlock Text="giây" VerticalAlignment="Center" Margin="8,0,16,0"/>
</StackPanel><StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8"><CheckBox Content="Dịch Tiếng Việt" IsChecked="{Binding ShowVietnameseTranslation}" Visibility="{Binding CanShowTranslation, Converter={StaticResource BoolVisibility}}" VerticalAlignment="Center"/>
</StackPanel></WrapPanel>
<Popup x:Name="TopicPopup" PlacementTarget="{Binding ElementName=TopicButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True"><Border Background="White" BorderBrush="#B5D2C9" BorderThickness="1" CornerRadius="12" Padding="16" Width="400"><StackPanel><TextBlock Text="Tên của bạn" FontWeight="SemiBold" Margin="0,0,0,8"/><TextBox x:Name="LearnerNameInput" Text="{Binding LearnerName,UpdateSourceTrigger=PropertyChanged}" MaxLength="120" IsEnabled="{Binding CanEditLearnerName}"/><TextBlock Text="Gợi ý từ tên trên máy. Bạn có thể sửa hoặc để trống để chào chung. Tên được gửi AI khi tạo lời chào." Foreground="#65756F" TextWrapping="Wrap" Margin="0,8,0,16"/><TextBlock Text="Hướng dẫn riêng cho cuộc trò chuyện" FontWeight="SemiBold" Margin="0,0,0,12"/><TextBox IsEnabled="{Binding CanChangeSession}" Text="{Binding CustomPrompt,UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" Height="100" VerticalScrollBarVisibility="Auto"/><CheckBox Content="Tự gửi câu đã nhận diện" IsChecked="{Binding SendRecognizedSpeechAutomatically}" Margin="0,12,0,0"/><CheckBox Content="Đọc câu trả lời" IsChecked="{Binding AutoSpeakResponse}" Margin="0,12,0,0"/></StackPanel></Border></Popup>
<Border Grid.Row="2" BorderBrush="#C2DDD5" BorderThickness="1" CornerRadius="18" ClipToBounds="True"><Grid><Border Background="#40FFFFFF"/><Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<ListBox x:Name="MessageList" ItemsSource="{Binding Messages}" Background="Transparent" BorderThickness="0" Padding="16" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.ScrollUnit="Pixel">
 <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Top"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Top"/></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
 <ListBox.ItemTemplate><DataTemplate>
  <Border Tag="ChatBubble" CornerRadius="16" Padding="13" MaxWidth="620" VerticalAlignment="Top">
   <Border.Style><Style TargetType="Border"><Setter Property="Margin" Value="0,0,48,14"/><Setter Property="Background" Value="#EBEFED"/><Setter Property="HorizontalAlignment" Value="Left"/><Style.Triggers><DataTrigger Binding="{Binding IsUser}" Value="True"><Setter Property="Background" Value="#DCEEE8"/><Setter Property="HorizontalAlignment" Value="Right"/><Setter Property="Margin" Value="48,0,0,14"/></DataTrigger></Style.Triggers></Style></Border.Style>
   <StackPanel>
    <DockPanel Margin="0,0,0,7" LastChildFill="True">
     <TextBlock DockPanel.Dock="Right" Text="{Binding TimeString}" Foreground="#73827C" FontSize="11" VerticalAlignment="Center" Margin="16,0,0,0"/>
     <StackPanel Orientation="Horizontal">
      <Border Background="#DCEEE8" CornerRadius="20" Width="40" Height="40" Margin="0,0,7,0"><Grid>
       <Image Source="/TransTools;component/Resources/Mascot/MascotWalking.png" Width="30" Height="30"><Image.Style><Style TargetType="Image"><Style.Triggers><DataTrigger Binding="{Binding IsUser}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Image.Style></Image>
       <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="26" Foreground="#65756F" VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsUser}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
      </Grid></Border>
      <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#287568" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="{Binding DisplayName,Source={x:Static experience:AssistantIdentity.Shared}}"/><Style.Triggers><DataTrigger Binding="{Binding IsUser}" Value="True"><Setter Property="Text" Value="Bạn"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
     </StackPanel>
    </DockPanel>
    <TextBlock Text="{Binding Text}" FontSize="15" Foreground="#243D35" TextWrapping="Wrap" LineHeight="22"/>
    <StackPanel Margin="0,7,0,0"><StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers><DataTrigger Binding="{Binding Translation}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding DataContext.ShowVietnameseTranslation,RelativeSource={RelativeSource AncestorType=ListBox}}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding DataContext.CanShowTranslation,RelativeSource={RelativeSource AncestorType=ListBox}}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></StackPanel.Style><Border Height="1" Background="#CBDCD5" Margin="0,0,0,7"/><TextBlock Text="{Binding Translation}" FontSize="14" Foreground="#65756F" TextWrapping="Wrap" LineHeight="21"/></StackPanel>
   </StackPanel>
  </Border>
 </DataTemplate></ListBox.ItemTemplate>
</ListBox>

<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24"><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Messages.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style><Path Data="M2,2 L13,2 Q15,2 15,4 L15,11 L7,11 L3,15 L3,11 L1,11 L1,3 Z M7,12 L7,15 L13,15 L17,19 L17,15 L19,15 L19,7 L16,7" Stroke="#287568" StrokeThickness="1.4" StrokeLineJoin="Round" Stretch="Uniform" Width="48" Height="48" Margin="0,0,0,16"/><TextBlock Text="Cùng bắt đầu trò chuyện" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="Bấm Bắt đầu, trợ lý sẽ mở lời theo chủ đề bạn chọn." TextAlignment="Center" Foreground="#65756F" Margin="0,12,0,0" TextWrapping="Wrap"/></StackPanel>
<Border Grid.Row="1" Background="#FAFCFB" BorderBrush="#B5D2C9" BorderThickness="0,1,0,0" Padding="14"><StackPanel><TextBlock Text="{Binding Status}" Foreground="#65756F" Margin="0,0,0,10" TextWrapping="Wrap"/>
<DockPanel LastChildFill="False"><Button Content="Bắt đầu trò chuyện" Command="{Binding StartConversationCommand}" Margin="0,0,8,0"/><Button Content="Lưu buổi trò chuyện" Command="{Binding SaveConversationCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/><Button Content="Kết thúc" Command="{Binding EndConversationCommand}" Style="{StaticResource DestructiveButton}" Visibility="{Binding IsConversationActive,Converter={StaticResource BoolVisibility}}"/></DockPanel>
<Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding UserInput,UpdateSourceTrigger=PropertyChanged}" FontSize="15" Padding="12,8" KeyDown="InputTextBox_KeyDown" ToolTip="Nhập câu trả lời, Enter để gửi"/><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="{Binding MicrophoneLabel}" Command="{Binding ToggleMicrophoneCommand}" Style="{StaticResource SecondaryButton}" Margin="8,0"/><Button Content="Gửi" Command="{Binding SendMessageCommand}"/></StackPanel></Grid>
</StackPanel></Border></Grid></Grid></Border>
</Grid></UserControl>
