<UserControl x:Class="TransTools.Views.ConversationView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:TransTools.Views" xmlns:experience="clr-namespace:TransTools.Services.Experience">
<Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<Grid Margin="0,4,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
<StackPanel><TextBlock Text="Trò chuyện" FontSize="22" FontWeight="SemiBold"/><TextBlock Foreground="#65756F" Margin="0,4,0,0"><Run Text="{Binding TargetLanguage}"/><Run Text=" · "/><Run Text="{Binding CurrentTopic}"/></TextBlock></StackPanel>
<StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="＋ Tạo mới" Command="{Binding NewConversationCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/><Button x:Name="LibraryButton" Content="Hội thoại" Click="ShowLibrary_Click" Style="{StaticResource SecondaryButton}"/></StackPanel>
<Popup x:Name="LibraryPopup" PlacementTarget="{Binding ElementName=LibraryButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True"><Border Background="White" BorderBrush="#B5D2C9" BorderThickness="1" CornerRadius="12" Padding="16" Width="360"><StackPanel><TextBlock Text="Hội thoại đã lưu" FontWeight="SemiBold" Margin="0,0,0,12"/><ComboBox ItemsSource="{Binding Sessions}" DisplayMemberPath="Title" SelectedItem="{Binding SelectedSession}" IsEnabled="{Binding CanChangeSession}"/><Button Content="Xóa hội thoại đã chọn" Command="{Binding DeleteConversationCommand}" Style="{StaticResource DestructiveButton}" Margin="0,12,0,0"/></StackPanel></Border></Popup>
</Grid>
<WrapPanel Grid.Row="1" Margin="0,0,0,8"><StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8"><TextBlock Text="Ngôn ngữ trò chuyện" VerticalAlignment="Center" Margin="0,0,10,0"/><ComboBox IsEnabled="{Binding CanChangeSession}" SelectedValuePath="Tag" SelectedValue="{Binding TargetLanguage}" Width="155" Margin="0,0,16,0"><ComboBoxItem Content="Tiếng Anh" Tag="Tiếng Anh (English)"/><ComboBoxItem Content="Tiếng Nhật" Tag="Tiếng Nhật (日本語)"/><ComboBoxItem Content="Tiếng Trung" Tag="Tiếng Trung (中文)"/><ComboBoxItem Content="Tiếng Hàn" Tag="Tiếng Hàn (한국어)"/><ComboBoxItem Content="Tiếng Việt" Tag="Tiếng Việt"/></ComboBox>
</StackPanel><StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8"><TextBlock Text="Chủ đề" VerticalAlignment="Center" Margin="0,0,10,0"/><ComboBox IsEnabled="{Binding CanChangeSession}" SelectedValuePath="Tag" SelectedValue="{Binding CurrentTopic}" Width="215" Margin="0,0,16,0"><ComboBoxItem Content="Phỏng vấn xin việc" Tag="Phỏng vấn xin việc (Job Interview)"/><ComboBoxItem Content="Du lịch &amp; Khách sạn" Tag="Du lịch &amp; Nhận phòng khách sạn"/><ComboBoxItem Content="Công nghệ &amp; Lập trình" Tag="Công nghệ &amp; Lập trình viên"/><ComboBoxItem Content="Giao tiếp hằng ngày" Tag="Giao tiếp xã giao hàng ngày"/><ComboBoxItem Content="Thuyết trình dự án" Tag="Thuyết trình dự án"/></ComboBox>
</StackPanel><StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8"><Button x:Name="TopicButton" Content="Chủ đề &amp; Tùy chỉnh" Click="ShowTopic_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,16,0"/>
</StackPanel><StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8"><TextBlock Text="Chờ gửi" VerticalAlignment="Center" Margin="0,0,8,0"/><ComboBox ItemsSource="{Binding SendDelays}" SelectedItem="{Binding SendDelaySeconds}" Width="65"/><TextBlock Text="giây" VerticalAlignment="Center" Margin="8,0,16,0"/>
</StackPanel><StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8"><CheckBox Content="Dịch Tiếng Việt" IsChecked="{Binding ShowVietnameseTranslation}" Visibility="{Binding CanShowTranslation, Converter={StaticResource BoolVisibility}}" VerticalAlignment="Center"/>
</StackPanel></WrapPanel>
<Popup x:Name="TopicPopup" PlacementTarget="{Binding ElementName=TopicButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True"><Border Background="White" BorderBrush="#B5D2C9" BorderThickness="1" CornerRadius="12" Padding="16" Width="400"><StackPanel><TextBlock Text="Hướng dẫn riêng cho cuộc trò chuyện" FontWeight="SemiBold" Margin="0,0,0,12"/><TextBox IsEnabled="{Binding CanChangeSession}" Text="{Binding CustomPrompt,UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" Height="100" VerticalScrollBarVisibility="Auto"/><CheckBox Content="Tự gửi câu đã nhận diện" IsChecked="{Binding SendRecognizedSpeechAutomatically}" Margin="0,12,0,0"/><CheckBox Content="Đọc câu trả lời" IsChecked="{Binding AutoSpeakResponse}" Margin="0,12,0,0"/></StackPanel></Border></Popup>
<Border Grid.Row="2" BorderBrush="#C2DDD5" BorderThickness="1" CornerRadius="18" ClipToBounds="True"><Grid><Border Background="#40FFFFFF"/><Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<ListBox xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="MessageList" ItemsSource="{Binding Messages}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,4,0,8">

                            <Border Background="#DCEEE8" CornerRadius="12,12,2,12" Padding="14,10" HorizontalAlignment="Right" MaxWidth="500">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsUser}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <TextBlock Text="{Binding Text}" FontSize="14" Foreground="#243D35" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding TimeString}" FontSize="10" Foreground="#65756F" HorizontalAlignment="Right" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>


                            <Border Background="#F5F8F7" BorderBrush="#D8E5E1" BorderThickness="1" CornerRadius="12,12,12,2" Padding="14,10" HorizontalAlignment="Left" MaxWidth="540">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsUser}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <Border Background="#DCEEE8" CornerRadius="16" Padding="4" Margin="0,0,8,0"><Image Source="/TransTools;component/Resources/Mascot/MascotWalking.png" Width="28" Height="28" /></Border><TextBlock Text="{Binding DisplayName,Source={x:Static experience:AssistantIdentity.Shared}}" FontSize="12" VerticalAlignment="Center" FontWeight="Bold" Foreground="#75BBAE" />
                                        <TextBlock Text="{Binding TimeString}" FontSize="10" Foreground="#73827C" Margin="8,0,0,0" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding Text}" FontSize="14" Foreground="#243D35" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Translation}" FontSize="12" Foreground="#287568" TextWrapping="Wrap" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

<StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Margin="24,64,24,0"><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Messages.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style><TextBlock Text="Cùng bắt đầu trò chuyện" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="Bấm Bắt đầu, trợ lý sẽ mở lời theo chủ đề bạn chọn." Foreground="#65756F" Margin="0,12,0,0" TextWrapping="Wrap"/></StackPanel>
<Border Grid.Row="1" Background="#DFEAF5EE" BorderBrush="#B5D2C9" BorderThickness="0,1,0,0" Padding="14"><StackPanel><TextBlock Text="{Binding Status}" Foreground="#65756F" Margin="0,0,0,10" TextWrapping="Wrap"/>
<DockPanel LastChildFill="False"><Button Content="Bắt đầu trò chuyện" Command="{Binding StartConversationCommand}" Margin="0,0,8,0"/><Button Content="Lưu buổi trò chuyện" Command="{Binding SaveConversationCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/><Button Content="Kết thúc" Command="{Binding EndConversationCommand}" Style="{StaticResource DestructiveButton}" Visibility="{Binding IsConversationActive,Converter={StaticResource BoolVisibility}}"/></DockPanel>
<Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding UserInput,UpdateSourceTrigger=PropertyChanged}" FontSize="15" Padding="12,8" KeyDown="InputTextBox_KeyDown" ToolTip="Nhập câu trả lời, Enter để gửi"/><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="{Binding MicrophoneLabel}" Command="{Binding ToggleMicrophoneCommand}" Style="{StaticResource SecondaryButton}" Margin="8,0"/><Button Content="Gửi" Command="{Binding SendMessageCommand}"/></StackPanel></Grid>
</StackPanel></Border></Grid></Grid></Border>
</Grid></UserControl>
