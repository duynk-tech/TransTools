<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="TransTools.Views.NotebookView">
  <UserControl.Resources><Style x:Key="NotebookTab" TargetType="RadioButton"><Setter Property="Cursor" Value="Hand"/><Setter Property="Foreground" Value="#73827C"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Grid><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/><Border x:Name="Underline" Height="3" Background="Transparent" VerticalAlignment="Bottom" CornerRadius="1"/></Grid><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter Property="Foreground" Value="#287568"/><Setter TargetName="Underline" Property="Background" Value="#287568"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="#287568"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></UserControl.Resources>
  <Grid Margin="-18" Background="#C7F5F8F7">
   <Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Border Background="#EDFFFFFF" BorderBrush="#C2DDD5" BorderThickness="0,0,0,1"><UniformGrid Columns="2" Margin="18,6">
    <RadioButton x:Name="RecordsTab" Content="Cuộc họp &amp; Hội thoại" GroupName="NotebookSections" Style="{StaticResource NotebookTab}" IsChecked="True" Checked="Records_Checked" FontSize="15"/>
    <RadioButton x:Name="WordsTab" Content="Từ vựng" GroupName="NotebookSections" Style="{StaticResource NotebookTab}" Checked="Words_Checked" FontSize="15"/>
   </UniformGrid></Border>
   <Grid x:Name="RecordsPanel" Grid.Row="1">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="320" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Border Grid.Column="0" Background="#E8F5F8F7" BorderBrush="#C2DDD5" BorderThickness="0,0,1,0" CornerRadius="0" Padding="14" Margin="0">
      <DockPanel>
        
        <Grid DockPanel.Dock="Top" Margin="0,0,0,12"><TextBox Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}" ToolTip="Tìm theo tiêu đề, nội dung…" MinHeight="40" Height="40" Margin="0" />
        <TextBlock Text="Tìm theo tiêu đề, nội dung…" Foreground="#93A19B" FontSize="12" IsHitTestVisible="False" VerticalAlignment="Center" Margin="12,0,8,0" TextTrimming="CharacterEllipsis"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding SearchKeyword}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid><UniformGrid DockPanel.Dock="Top" Columns="3" Margin="0,0,0,12">
        <RadioButton Content="Tất cả" Style="{StaticResource SegmentedOption}" GroupName="RecordKind" IsChecked="{Binding RecordKind,Mode=TwoWay,Converter={StaticResource OptionSelection},ConverterParameter=Tất cả}"/>
        <RadioButton Content="Cuộc họp" Style="{StaticResource SegmentedOption}" GroupName="RecordKind" IsChecked="{Binding RecordKind,Mode=TwoWay,Converter={StaticResource OptionSelection},ConverterParameter=Cuộc họp}"/>
        <RadioButton Content="Trò chuyện" Style="{StaticResource SegmentedOption}" GroupName="RecordKind" IsChecked="{Binding RecordKind,Mode=TwoWay,Converter={StaticResource OptionSelection},ConverterParameter=Trò chuyện}"/>
        </UniformGrid><ListBox ScrollViewer.HorizontalScrollBarVisibility="Disabled" ItemsSource="{Binding SessionsView}" SelectedItem="{Binding SelectedSession}" Background="Transparent" BorderThickness="0">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Border Style="{StaticResource TranscriptCard}" Margin="0,0,0,6">
                <DockPanel><Button DockPanel.Dock="Right" Content="&#xE74D;" FontFamily="Segoe MDL2 Assets" ToolTip="Xóa bản ghi" Style="{StaticResource DestructiveButton}" MinHeight="30" Width="32" Padding="4" Margin="8,0,0,0" Command="{Binding DataContext.ConfirmDeleteRecordCommand,RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"/><StackPanel>
                  <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" Foreground="#243D35" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding KindLabel}" FontSize="11" Foreground="#287568" Margin="0,4,0,0"/><TextBlock Text="{Binding FormattedDate}" FontSize="11" Foreground="#73827C" Margin="0,2,0,0" />
                </StackPanel></DockPanel>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>
    <Border Grid.Column="1" Background="Transparent" BorderBrush="#C2DDD5" BorderThickness="0" CornerRadius="0" Padding="24,20">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
          <StackPanel>
            <DockPanel><Button DockPanel.Dock="Right" Content="✎" ToolTip="Đổi tên bản ghi" Command="{Binding RenameRecordCommand}" Style="{StaticResource SecondaryButton}" Width="40" Margin="12,0,0,0"/><TextBlock Text="{Binding SelectedSession.Title}" FontSize="20" FontWeight="Bold" Foreground="#243D35" TextWrapping="Wrap" /></DockPanel>
            </StackPanel>
          <WrapPanel HorizontalAlignment="Left" Margin="0,12,0,0">
            <Button Content="Tiếp tục trò chuyện" Command="{Binding ResumeConversationCommand}" Visibility="{Binding IsConversationSelected,Converter={StaticResource BoolVisibility}}" Margin="0,0,8,0"/><Button Visibility="{Binding IsMeetingSelected,Converter={StaticResource BoolVisibility}}" Content="Ghi chú" Command="{Binding OpenNotesCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" />
            <Button Visibility="{Binding IsMeetingSelected,Converter={StaticResource BoolVisibility}}" Content="Tóm tắt AI" Command="{Binding GenerateSummaryCommand}" Margin="0,0,8,0" Padding="12,6" Cursor="Hand" Style="{StaticResource SecondaryButton}" />
            <Grid>
              <Button x:Name="ExportButton" Content="Xuất ▾" Click="ShowExport_Click" Style="{StaticResource SecondaryButton}" />
              <Popup x:Name="ExportPopup" PlacementTarget="{Binding ElementName=ExportButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                <Border Background="White" BorderBrush="#B5D2C9" BorderThickness="1" CornerRadius="10" Padding="8">
                  <StackPanel>
                    <Button Content="Xuất Word" Command="{Binding ExportDocxCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,0,6" />
                    <Button Visibility="{Binding IsMeetingSelected,Converter={StaticResource BoolVisibility}}" Content="Xuất phụ đề SRT" Command="{Binding ExportSrtCommand}" Style="{StaticResource SecondaryButton}" />
                  </StackPanel>
                </Border>
              </Popup>
            </Grid>
          </WrapPanel>
        <WrapPanel Margin="0,12,0,0"><Border Background="#ECFFFFFF" BorderBrush="#D9E6E1" BorderThickness="1" CornerRadius="7" Padding="8,5" Margin="0,0,8,4"><TextBlock Text="{Binding SelectedSession.FormattedDate}" FontSize="11" Foreground="#65756F" /></Border><Border Background="#ECFFFFFF" BorderBrush="#D9E6E1" BorderThickness="1" CornerRadius="7" Padding="8,5" Margin="0,0,8,4"><TextBlock Text="{Binding SelectedSession.FormattedDuration}" FontSize="11" Foreground="#65756F" /></Border><Border Background="#ECFFFFFF" BorderBrush="#D9E6E1" BorderThickness="1" CornerRadius="7" Padding="8,5" Margin="0,0,8,4"><TextBlock Text="{Binding SelectedSession.AudioSource}" FontSize="11" Foreground="#65756F" /></Border><Border Background="#ECFFFFFF" BorderBrush="#D9E6E1" BorderThickness="1" CornerRadius="7" Padding="8,5" Margin="0,0,8,4"><TextBlock Text="{Binding SelectedSession.Captions.Count,StringFormat={}{0} đoạn phụ đề}" FontSize="11" Foreground="#65756F" /></Border></WrapPanel></StackPanel>
        <Border DockPanel.Dock="Top" Background="#E8F5F8F7" BorderBrush="#C2DDD5" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14" MaxHeight="160">
          <Border.Style>
            <Style TargetType="Border">
              <Setter Property="Visibility" Value="Visible" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedSession.Summary}" Value="{x:Null}">
                  <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding SelectedSession.Summary}" Value="">
                  <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Border.Style>
          <StackPanel>
            <TextBlock Text="✨ Tóm tắt cuộc họp bằng AI" FontWeight="Bold" FontSize="13" Foreground="#10B981" Margin="0,0,0,6" />
            <TextBlock Text="{Binding SelectedSession.Summary}" FontSize="13" Foreground="#334B43" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding Status}" FontSize="11" Foreground="#73827C" Margin="0,8,0,0" />
        <Border DockPanel.Dock="Top" Background="#E8FFFFFF" BorderBrush="#C2DDD5" BorderThickness="1" CornerRadius="12" Padding="10">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding SelectedSession.Captions.Count,StringFormat=Bản ghi ({0})}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
              <RadioButton Content="Song ngữ" GroupName="TranscriptMode" Style="{StaticResource SegmentedOption}" IsChecked="{Binding CaptionMode,Mode=TwoWay,Converter={StaticResource OptionSelection},ConverterParameter=Song ngữ}" MinWidth="74" FontSize="12" Padding="6" />
              <RadioButton Content="Tiếng gốc" GroupName="TranscriptMode" Style="{StaticResource SegmentedOption}" IsChecked="{Binding CaptionMode,Mode=TwoWay,Converter={StaticResource OptionSelection},ConverterParameter=Tiếng gốc}" MinWidth="74" FontSize="12" Padding="6" />
              <RadioButton Content="Bản dịch" GroupName="TranscriptMode" Style="{StaticResource SegmentedOption}" IsChecked="{Binding CaptionMode,Mode=TwoWay,Converter={StaticResource OptionSelection},ConverterParameter=Bản dịch}" MinWidth="74" FontSize="12" Padding="6" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal">
              <Button Content="A−" Command="{Binding DecreaseCaptionFontCommand}" Style="{StaticResource SecondaryButton}" Padding="7,4" MinHeight="32" Height="32" VerticalAlignment="Center" />
              <TextBlock Text="{Binding CaptionFontSize}" VerticalAlignment="Center" Margin="8,0" />
              <Button Content="A+" Command="{Binding IncreaseCaptionFontCommand}" Style="{StaticResource SecondaryButton}" Padding="7,4" MinHeight="32" Height="32" VerticalAlignment="Center" />
              <Grid Width="150" Margin="12,0,0,0" VerticalAlignment="Center"><TextBox Text="{Binding CaptionSearch,UpdateSourceTrigger=PropertyChanged}" ToolTip="Lọc câu thoại…" Height="32" MinHeight="32" Margin="0" />
            <TextBlock Text="Lọc câu thoại…" Foreground="#93A19B" FontSize="12" IsHitTestVisible="False" VerticalAlignment="Center" Margin="12,0,8,0" TextTrimming="CharacterEllipsis"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding CaptionSearch}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid></StackPanel>
          </Grid>
        </Border>
        <ListBox ScrollViewer.HorizontalScrollBarVisibility="Disabled" ItemsSource="{Binding CaptionView}" Background="Transparent" BorderThickness="0" Margin="0,14,0,0">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Border Style="{StaticResource TranscriptCard}" Margin="0,0,0,6">
                <StackPanel>
                  <DockPanel Margin="0,0,0,10" LastChildFill="True"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="Nghe gốc" Command="{Binding DataContext.SpeakOriginalCommand,RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" Style="{StaticResource SecondaryButton}" MinHeight="26" Padding="8,4" FontSize="12" Margin="4,0,0,0" /><Button Content="Nghe dịch" Command="{Binding DataContext.SpeakTranslationCommand,RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" Style="{StaticResource SecondaryButton}" MinHeight="26" Padding="8,4" FontSize="12" Margin="4,0,0,0" /><Menu Background="Transparent" Foreground="#287568" VerticalAlignment="Center" Margin="4,0,0,0"><MenuItem Header="Sao chép" Padding="8,4" DataContext="{Binding}"><MenuItem Header="Tiếng gốc" Click="CopyOriginal_Click" /><MenuItem Header="Bản dịch" Click="CopyTranslation_Click" /><MenuItem Header="Song ngữ kèm thời gian" Click="CopyBilingual_Click" /></MenuItem></Menu></StackPanel><Border Background="#F0F3F1" CornerRadius="4" Padding="6,3" HorizontalAlignment="Left" VerticalAlignment="Center"><TextBlock Text="{Binding FormattedTimestamp}" FontSize="10" FontWeight="Bold" Foreground="#73827C" FontFamily="Consolas" />
                  </Border></DockPanel><TextBlock Text="{Binding Original}" TextWrapping="Wrap" FontSize="{Binding DataContext.CaptionFontSize,RelativeSource={RelativeSource AncestorType=ListBox}}" Foreground="#334B43" Margin="0,10,0,0" Visibility="{Binding DataContext.ShowOriginal,RelativeSource={RelativeSource AncestorType=ListBox},Converter={StaticResource BoolVisibility}}" />
                  <TextBlock Text="{Binding Vietnamese}" TextWrapping="Wrap" FontSize="{Binding DataContext.CaptionFontSize,RelativeSource={RelativeSource AncestorType=ListBox}}" Foreground="#287568" Margin="0,8,0,0" Visibility="{Binding DataContext.ShowTranslation,RelativeSource={RelativeSource AncestorType=ListBox},Converter={StaticResource BoolVisibility}}" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>
  </Grid>
  <ContentControl x:Name="VocabularyPanel" Grid.Row="1" Visibility="Collapsed"/>
 </Grid>
</UserControl>