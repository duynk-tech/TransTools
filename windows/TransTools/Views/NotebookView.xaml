<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="TransTools.Views.NotebookView">
  <UserControl.Resources><Style x:Key="SelectableTranscript" TargetType="TextBox"><Setter Property="IsReadOnly" Value="True"/><Setter Property="IsReadOnlyCaretVisible" Value="False"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/><Setter Property="VerticalContentAlignment" Value="Top"/><Setter Property="Cursor" Value="IBeam"/><Setter Property="SelectionBrush" Value="#75BBAE"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><ScrollViewer x:Name="PART_ContentHost" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled"/></ControlTemplate></Setter.Value></Setter></Style><Style x:Key="NotebookTab" TargetType="RadioButton"><Setter Property="Cursor" Value="Hand"/><Setter Property="Foreground" Value="#73827C"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Grid><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/><Border x:Name="Underline" Height="3" Background="Transparent" VerticalAlignment="Bottom" CornerRadius="1"/></Grid><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter Property="Foreground" Value="#287568"/><Setter TargetName="Underline" Property="Background" Value="#287568"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="#287568"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style><Style x:Key="NotebookMode" TargetType="RadioButton"><Setter Property="Width" Value="84"/><Setter Property="Height" Value="32"/><Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="#287568"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Border x:Name="ModeChrome" Background="Transparent" CornerRadius="6"><ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="ModeChrome" Property="Background" Value="#287568"/><Setter Property="Foreground" Value="White"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ModeChrome" Property="Opacity" Value=".85"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ModeChrome" Property="BorderBrush" Value="#287568"/><Setter TargetName="ModeChrome" Property="BorderThickness" Value="1"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
<Style x:Key="NotebookFontButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}"><Setter Property="Width" Value="30"/><Setter Property="Height" Value="32"/><Setter Property="MinHeight" Value="32"/><Setter Property="Padding" Value="0"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/></Style>
<Style x:Key="RecordKindOption" TargetType="RadioButton" BasedOn="{StaticResource NotebookMode}"><Setter Property="Width" Value="Auto"/><Setter Property="Height" Value="36"/><Setter Property="HorizontalAlignment" Value="Stretch"/></Style>
</UserControl.Resources>
  <Grid Margin="-18" Background="#C7F5F8F7">
   <Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Border Background="#EDFFFFFF" BorderBrush="#C2DDD5" BorderThickness="0,0,0,1"><UniformGrid Columns="2" Margin="18,6">
    <RadioButton x:Name="RecordsTab" GroupName="NotebookSections" Style="{StaticResource NotebookTab}" IsChecked="True" Checked="Records_Checked" FontSize="15" AutomationProperties.Name="Cuộc họp &amp; Hội thoại"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8F2;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,9,0"/><TextBlock Text="Cuộc họp &amp; Hội thoại" VerticalAlignment="Center"/><Border Background="#E0EEE8" CornerRadius="12" Padding="7,3" Margin="9,0,0,0"><TextBlock x:Name="RecordTabCount" Text="{Binding Sessions.Count}" FontSize="12" Foreground="#287568"/></Border></StackPanel></RadioButton>
    <RadioButton x:Name="WordsTab" GroupName="NotebookSections" Style="{StaticResource NotebookTab}" Checked="Words_Checked" FontSize="15" AutomationProperties.Name="Từ vựng"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE82D;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,9,0"/><TextBlock Text="Từ vựng" VerticalAlignment="Center"/><Border Background="#E0EEE8" CornerRadius="12" Padding="7,3" Margin="9,0,0,0"><TextBlock x:Name="WordTabCount" Text="0" FontSize="12" Foreground="#287568"/></Border></StackPanel></RadioButton>
   </UniformGrid></Border>
   <Grid x:Name="RecordsPanel" Grid.Row="1">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="320" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Border Grid.Column="0" Background="#E8F5F8F7" BorderBrush="#C2DDD5" BorderThickness="0,0,1,0" CornerRadius="0" Padding="14" Margin="0">
      <DockPanel>

        <Grid DockPanel.Dock="Top" Margin="0,0,0,12"><TextBox Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}" ToolTip="Tìm theo tiêu đề, nội dung…" MinHeight="40" Height="40" Margin="0" />
        <TextBlock Text="Tìm theo tiêu đề, nội dung…" Foreground="#93A19B" FontSize="12" IsHitTestVisible="False" VerticalAlignment="Center" Margin="12,0,8,0" TextTrimming="CharacterEllipsis"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding SearchKeyword}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid><Border DockPanel.Dock="Top" BorderBrush="#B5D2C9" BorderThickness="1" CornerRadius="8" Background="White" Margin="0,0,0,12"><UniformGrid Columns="3">
        <RadioButton Content="Tất cả" Style="{StaticResource RecordKindOption}" GroupName="RecordKind" IsChecked="{Binding RecordKind,Mode=TwoWay,Converter={StaticResource OptionSelection},ConverterParameter=Tất cả}"/>
        <RadioButton Content="Cuộc họp" Style="{StaticResource RecordKindOption}" GroupName="RecordKind" IsChecked="{Binding RecordKind,Mode=TwoWay,Converter={StaticResource OptionSelection},ConverterParameter=Cuộc họp}"/>
        <RadioButton Content="Trò chuyện" Style="{StaticResource RecordKindOption}" GroupName="RecordKind" IsChecked="{Binding RecordKind,Mode=TwoWay,Converter={StaticResource OptionSelection},ConverterParameter=Trò chuyện}"/>
        </UniformGrid></Border><DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0"><Button DockPanel.Dock="Right" Content="&#xE74D;" FontFamily="Segoe MDL2 Assets" ToolTip="Xóa tất cả bản ghi" Width="32" MinHeight="32" Padding="4" Style="{StaticResource DestructiveButton}" Command="{Binding ConfirmDeleteAllRecordsCommand}"/><TextBlock Text="Quản lý bản ghi" Foreground="#73827C" FontSize="12" VerticalAlignment="Center"/></DockPanel><ListBox ScrollViewer.HorizontalScrollBarVisibility="Disabled" ItemsSource="{Binding SessionsView}" SelectedItem="{Binding SelectedSession}" Background="Transparent" BorderThickness="0">
          <ListBox.GroupStyle>
            <GroupStyle>
              <GroupStyle.HeaderTemplate>
                <DataTemplate><TextBlock Text="{Binding Name}" Foreground="#73827C" FontSize="12" FontWeight="SemiBold" Margin="10,18,0,8"/></DataTemplate>
              </GroupStyle.HeaderTemplate>
            </GroupStyle>
          </ListBox.GroupStyle>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Border Padding="10,8" Background="Transparent">
                <DockPanel><Border DockPanel.Dock="Left" Background="#D8EAE5" Width="30" Height="36" CornerRadius="8" Margin="0,0,10,0" ToolTip="{Binding KindLabel}"><TextBlock FontFamily="Segoe MDL2 Assets" FontSize="17" Foreground="#287568" VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="&#xE9D9;"/><Style.Triggers><DataTrigger Binding="{Binding IsConversation}" Value="True"><Setter Property="Text" Value="&#xE8F2;"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Border><Button DockPanel.Dock="Right" Content="&#xE74D;" FontFamily="Segoe MDL2 Assets" ToolTip="Xóa bản ghi" Style="{StaticResource DestructiveButton}" MinHeight="30" Width="32" Padding="4" Margin="8,0,0,0" Command="{Binding DataContext.ConfirmDeleteRecordCommand,RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"/><StackPanel>
                  <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" Foreground="#243D35" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding FormattedDate}" FontSize="11" Foreground="#73827C" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel></DockPanel>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>
    <Grid Grid.Column="1">
     <StackPanel x:Name="EmptyRecordPanel" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="370" Margin="24"><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding HasSelectedSession}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
      <Viewbox Width="48" Height="48" Margin="0,0,0,18"><Path Stroke="#80A89E" StrokeThickness="1.5" StrokeLineJoin="Round" Data="M2,2 L10,2 Q12,2 12,4 Q12,2 14,2 L22,2 L22,20 L14,20 Q12,20 12,22 Q12,20 10,20 L2,20 Z M12,4 L12,20 M5,6 L9,6 M5,10 L9,10 M15,6 L19,6 M15,10 L19,10"/></Viewbox>
      <TextBlock Text="Chọn một bản ghi để xem chi tiết" FontSize="16" FontWeight="SemiBold" Foreground="#65756F" TextAlignment="Center" TextWrapping="Wrap"/>
      <TextBlock Text="Xem lại cuộc họp hoặc hội thoại, nghe lời thoại, ghi chú và xuất nội dung đã lưu." Foreground="#73827C" TextAlignment="Center" TextWrapping="Wrap" Margin="0,10,0,0"/>
     </StackPanel>
    <Border x:Name="RecordDetailPanel" Visibility="{Binding HasSelectedSession,Converter={StaticResource BoolVisibility}}" Background="Transparent" BorderBrush="#C2DDD5" BorderThickness="0" CornerRadius="0" Padding="24,20">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
          <StackPanel>
            <DockPanel><Button DockPanel.Dock="Right" Content="&#xE70F;" FontFamily="Segoe MDL2 Assets" AutomationProperties.Name="Đổi tên bản ghi" ToolTip="Đổi tên bản ghi" Command="{Binding RenameRecordCommand}" Style="{StaticResource SecondaryButton}" Width="40" Margin="12,0,0,0"/><TextBlock Text="{Binding SelectedSession.Title}" FontSize="20" FontWeight="Bold" Foreground="#243D35" TextWrapping="Wrap" /></DockPanel>
            </StackPanel>
          <WrapPanel HorizontalAlignment="Left" Margin="0,12,0,0">
            <Button Command="{Binding ResumeConversationCommand}" Visibility="{Binding IsConversationSelected,Converter={StaticResource BoolVisibility}}" Margin="0,0,8,0" AutomationProperties.Name="Tiếp tục trò chuyện"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8F2;" FontFamily="Segoe MDL2 Assets" Margin="0,0,7,0" VerticalAlignment="Center"/><TextBlock Text="Tiếp tục trò chuyện" VerticalAlignment="Center"/></StackPanel></Button><Button Command="{Binding OpenNotesCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"  AutomationProperties.Name="Ghi chú"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE70B;" FontFamily="Segoe MDL2 Assets" Margin="0,0,7,0" VerticalAlignment="Center"/><TextBlock Text="Ghi chú" VerticalAlignment="Center"/></StackPanel></Button>
            <Button Visibility="{Binding IsMeetingSelected,Converter={StaticResource BoolVisibility}}" Command="{Binding OpenTasksCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" AutomationProperties.Name="Việc cần làm (AI)"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE73A;" FontFamily="Segoe MDL2 Assets" Margin="0,0,7,0" VerticalAlignment="Center"/><TextBlock Text="Việc cần làm (AI)" VerticalAlignment="Center"/></StackPanel></Button>

            <Grid>
              <Button x:Name="ExportButton" Click="ShowExport_Click" Style="{StaticResource SecondaryButton}"  AutomationProperties.Name="Xuất ▾"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72D;" FontFamily="Segoe MDL2 Assets" Margin="0,0,7,0" VerticalAlignment="Center"/><TextBlock Text="Xuất ▾" VerticalAlignment="Center"/></StackPanel></Button>
              <Popup x:Name="ExportPopup" PlacementTarget="{Binding ElementName=ExportButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                <Border Background="White" BorderBrush="#B5D2C9" BorderThickness="1" CornerRadius="10" Padding="8">
                  <StackPanel>
                    <Button Content="Xuất Word" Command="{Binding ExportDocxCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,0,6" />
                    <Button Content="Xuất văn bản TXT" Command="{Binding ExportTxtCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,0,6"/>
                    <Button Visibility="{Binding IsMeetingSelected,Converter={StaticResource BoolVisibility}}" Content="Xuất phụ đề SRT" Command="{Binding ExportSrtCommand}" Style="{StaticResource SecondaryButton}" />
                  </StackPanel>
                </Border>
              </Popup>
            </Grid>
          </WrapPanel>
        <WrapPanel Margin="0,12,0,0"><Border Background="#ECFFFFFF" BorderBrush="#D9E6E1" BorderThickness="1" CornerRadius="7" Padding="8,5" Margin="0,0,8,4"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#287568" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBlock Text="{Binding SelectedSession.FormattedDate}" FontSize="11" Foreground="#65756F" /></StackPanel></Border><Border Background="#ECFFFFFF" BorderBrush="#D9E6E1" BorderThickness="1" CornerRadius="7" Padding="8,5" Margin="0,0,8,4"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE823;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#287568" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBlock Text="{Binding SelectedSession.FormattedDuration}" FontSize="11" Foreground="#65756F" /></StackPanel></Border><Border Background="#ECFFFFFF" BorderBrush="#D9E6E1" BorderThickness="1" CornerRadius="7" Padding="8,5" Margin="0,0,8,4"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE767;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#287568" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBlock Text="{Binding SelectedSession.AudioSourceLabel}" FontSize="11" Foreground="#65756F" /></StackPanel></Border><Border Background="#ECFFFFFF" BorderBrush="#D9E6E1" BorderThickness="1" CornerRadius="7" Padding="8,5" Margin="0,0,8,4"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8F2;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#287568" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBlock Text="{Binding SelectedSession.Captions.Count,StringFormat={}{0} đoạn phụ đề}" FontSize="11" Foreground="#65756F" /></StackPanel></Border></WrapPanel></StackPanel>
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding Status}" FontSize="11" Foreground="#73827C" Margin="0,8,0,0" />
        <Border DockPanel.Dock="Top" Background="#E8FFFFFF" BorderBrush="#C2DDD5" BorderThickness="1" CornerRadius="12" Padding="10">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0"><TextBlock Text="Bản ghi" FontWeight="SemiBold" VerticalAlignment="Center"/><Border Background="#E1EEE6" CornerRadius="12" Padding="7,4" Margin="8,0,0,0"><TextBlock Text="{Binding FilteredCaptionCount}" FontSize="11" FontWeight="SemiBold" Foreground="#287568"/></Border></StackPanel>
            <Border Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" Background="White" BorderBrush="#B5D2C9" BorderThickness="1" CornerRadius="8"><StackPanel Orientation="Horizontal">
              <RadioButton Content="Song ngữ" GroupName="TranscriptMode" Style="{StaticResource NotebookMode}" IsChecked="{Binding CaptionMode,Mode=TwoWay,Converter={StaticResource OptionSelection},ConverterParameter=Song ngữ}"/>
              <RadioButton Content="Tiếng gốc" GroupName="TranscriptMode" Style="{StaticResource NotebookMode}" IsChecked="{Binding CaptionMode,Mode=TwoWay,Converter={StaticResource OptionSelection},ConverterParameter=Tiếng gốc}"/>
              <RadioButton Content="Bản dịch" GroupName="TranscriptMode" Style="{StaticResource NotebookMode}" IsChecked="{Binding CaptionMode,Mode=TwoWay,Converter={StaticResource OptionSelection},ConverterParameter=Bản dịch}"/>
            </StackPanel></Border>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
              <Border Background="White" BorderBrush="#B5D2C9" BorderThickness="1" CornerRadius="8"><StackPanel Orientation="Horizontal"><Button Content="A−" ToolTip="Giảm cỡ chữ" Command="{Binding DecreaseCaptionFontCommand}" Style="{StaticResource NotebookFontButton}"/><TextBlock Text="{Binding CaptionFontSize}" VerticalAlignment="Center" TextAlignment="Center" Width="24" FontSize="12"/><Button Content="A+" ToolTip="Tăng cỡ chữ" Command="{Binding IncreaseCaptionFontCommand}" Style="{StaticResource NotebookFontButton}"/></StackPanel></Border>
              <Grid Width="185" Margin="12,0,0,0"><TextBox Text="{Binding CaptionSearch,UpdateSourceTrigger=PropertyChanged}" ToolTip="Tìm trong bản ghi" Height="34" MinHeight="34" Margin="0" Padding="10,4,30,4" FontSize="12"/>
               <TextBlock Text="Tìm trong bản ghi…" Foreground="#93A19B" FontSize="12" IsHitTestVisible="False" VerticalAlignment="Center" Margin="10,0,30,0"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding CaptionSearch}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
               <Button Content="×" ToolTip="Xóa tìm kiếm" Command="{Binding ClearCaptionSearchCommand}" Width="26" Height="30" MinHeight="30" Padding="0" HorizontalAlignment="Right" Style="{StaticResource NotebookFontButton}"/>
              </Grid>
            </StackPanel>
          </Grid>
        </Border>
        <ListBox ScrollViewer.HorizontalScrollBarVisibility="Disabled" ItemsSource="{Binding CaptionView}" Background="Transparent" BorderThickness="0" Margin="0,14,0,0">
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
              <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
              <Setter Property="Padding" Value="0"/>
              <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter HorizontalAlignment="Stretch"/></ControlTemplate></Setter.Value></Setter>
            </Style>
          </ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Border Style="{StaticResource TranscriptCard}" CornerRadius="10" Margin="0,0,0,8">
                <StackPanel>
                  <DockPanel Margin="0,0,0,8" LastChildFill="True"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button AutomationProperties.Name="Nghe gốc" Command="{Binding DataContext.SpeakOriginalCommand,RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" Style="{StaticResource SecondaryButton}" MinHeight="26" Padding="8,4" FontSize="12" Margin="4,0,0,0" ><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE767;" FontFamily="Segoe MDL2 Assets" Margin="0,0,4,0" VerticalAlignment="Center"/><TextBlock Text="Nghe gốc"/></StackPanel></Button><Button AutomationProperties.Name="Nghe dịch" Command="{Binding DataContext.SpeakTranslationCommand,RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" Style="{StaticResource SecondaryButton}" MinHeight="26" Padding="8,4" FontSize="12" Margin="4,0,0,0" ><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE767;" FontFamily="Segoe MDL2 Assets" Margin="0,0,4,0" VerticalAlignment="Center"/><TextBlock Text="Nghe dịch"/></StackPanel></Button><Menu Background="Transparent" Foreground="#287568" VerticalAlignment="Center" Margin="4,0,0,0"><MenuItem Header="Sao chép" Padding="8,4" DataContext="{Binding}"><MenuItem Header="Tiếng gốc" Click="CopyOriginal_Click" /><MenuItem Header="Bản dịch" Click="CopyTranslation_Click" /><MenuItem Header="Song ngữ kèm thời gian" Click="CopyBilingual_Click" /></MenuItem></Menu></StackPanel><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="{Binding DisplayOrdinal,StringFormat=#{0}}" FontFamily="Consolas" FontSize="10" FontWeight="Bold" Foreground="#73827C" Margin="0,0,8,0" VerticalAlignment="Center"/><Border Background="#F0F3F1" CornerRadius="4" Padding="6,3" HorizontalAlignment="Left" VerticalAlignment="Center"><TextBlock Text="{Binding FormattedTimestamp}" FontSize="10" FontWeight="Bold" Foreground="#73827C" FontFamily="Consolas" />
                  </Border></StackPanel></DockPanel><TextBox TextWrapping="Wrap" FontSize="{Binding DataContext.CaptionFontSize,RelativeSource={RelativeSource AncestorType=ListBox}}" Margin="0" TextBlock.LineHeight="20" TextBlock.LineStackingStrategy="MaxHeight"><TextBox.Text><MultiBinding Mode="OneWay" Converter="{StaticResource CaptionDisplayText}"><Binding Path="Original"/><Binding Path="Vietnamese"/><Binding Path="DataContext.CaptionModeKey" RelativeSource="{RelativeSource AncestorType=ListBox}"/></MultiBinding></TextBox.Text><TextBox.Style><Style TargetType="TextBox" BasedOn="{StaticResource SelectableTranscript}"><Setter Property="Foreground" Value="#334B43"/><Style.Triggers><DataTrigger Binding="{Binding DataContext.CaptionModeKey,RelativeSource={RelativeSource AncestorType=ListBox}}" Value="translation"><Setter Property="Foreground" Value="#287568"/></DataTrigger></Style.Triggers></Style></TextBox.Style></TextBox>
                  <Border Background="#EEF6F3" CornerRadius="8" Padding="12,10" Margin="0,8,0,0">
                    <Border.Style><Style TargetType="Border"><Style.Triggers>
                      <DataTrigger Binding="{Binding Vietnamese}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                      <DataTrigger Binding="{Binding DataContext.CaptionModeKey,RelativeSource={RelativeSource AncestorType=ListBox}}" Value="original"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                      <DataTrigger Binding="{Binding DataContext.CaptionModeKey,RelativeSource={RelativeSource AncestorType=ListBox}}" Value="translation"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                    </Style.Triggers></Style></Border.Style>
                    <TextBox TextWrapping="Wrap" FontSize="{Binding DataContext.CaptionFontSize,RelativeSource={RelativeSource AncestorType=ListBox}}" Foreground="#287568" Margin="0"><TextBox.Text><MultiBinding Mode="OneWay" Converter="{StaticResource CaptionDisplayText}" ConverterParameter="secondary"><Binding Path="Original"/><Binding Path="Vietnamese"/><Binding Path="DataContext.CaptionModeKey" RelativeSource="{RelativeSource AncestorType=ListBox}"/></MultiBinding></TextBox.Text><TextBox.Style><Style TargetType="TextBox" BasedOn="{StaticResource SelectableTranscript}"><Style.Triggers><DataTrigger Binding="{Binding Text,RelativeSource={RelativeSource Self}}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBox.Style></TextBox>
                  </Border>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>
    </Grid>
  </Grid>
  <ContentControl x:Name="VocabularyPanel" Grid.Row="1" Visibility="Collapsed"/>
 </Grid>
</UserControl>
