<UserControl x:Class="TransTools.Views.NotebookView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sessions List -->
        <Border Grid.Column="0" Background="#1E293B" CornerRadius="12" Padding="14" Margin="0,0,16,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Danh sách cuộc họp" FontSize="16" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,0,0,12"/>
                
                <ListBox ItemsSource="{Binding Sessions}" SelectedItem="{Binding SelectedSession}" Background="Transparent" BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#0F172A" CornerRadius="8" Padding="10" Margin="0,0,0,6">
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" Foreground="#F8FAFC" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding FormattedDate}" FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Session Detail & Export -->
        <Border Grid.Column="1" Background="#1E293B" CornerRadius="12" Padding="18">
            <DockPanel>
                <!-- Detail Header -->
                <Grid DockPanel.Dock="Top" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="{Binding SelectedSession.Title}" FontSize="18" FontWeight="Bold" Foreground="#F8FAFC"/>
                        <TextBlock Text="{Binding SelectedSession.FormattedDate}" FontSize="12" Foreground="#94A3B8" Margin="0,2,0,0"/>
                    </StackPanel>

                    <!-- Export Actions -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="✨ Tóm tắt AI" Command="{Binding GenerateSummaryCommand}" Background="#059669" Foreground="White" Margin="0,0,8,0" Padding="12,6" Cursor="Hand"/>
                        <Button Content="📄 Xuất Word (.docx)" Command="{Binding ExportDocxCommand}" Background="#2563EB" Foreground="White" Margin="0,0,8,0" Padding="12,6" Cursor="Hand"/>
                        <Button Content="🎬 Xuất SRT" Command="{Binding ExportSrtCommand}" Background="#334155" Foreground="White" Padding="12,6" Cursor="Hand"/>
                    </StackPanel>
                </Grid>

                <!-- AI Summary Card if available -->
                <Border DockPanel.Dock="Top" Background="#0F172A" BorderBrush="#059669" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedSession.Summary}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding SelectedSession.Summary}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Text="✨ Tóm tắt cuộc họp bằng AI" FontWeight="Bold" FontSize="13" Foreground="#10B981" Margin="0,0,0,6"/>
                        <TextBlock Text="{Binding SelectedSession.Summary}" FontSize="13" Foreground="#E2E8F0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Status line -->
                <TextBlock DockPanel.Dock="Bottom" Text="{Binding Status}" FontSize="11" Foreground="#64748B" Margin="0,8,0,0"/>

                <!-- Captions inside selected session -->
                <ListBox ItemsSource="{Binding SelectedSession.Captions}" Background="Transparent" BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#0F172A" CornerRadius="8" Padding="10" Margin="0,0,0,6">
                                <StackPanel>
                                    <TextBlock Text="{Binding FormattedTimestamp}" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                                    <TextBlock Text="{Binding Original}" FontSize="13" Foreground="#E2E8F0" Margin="0,2,0,0"/>
                                    <TextBlock Text="{Binding Vietnamese}" FontSize="13" Foreground="#38BDF8" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
