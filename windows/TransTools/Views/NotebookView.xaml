<UserControl x:Class="TransTools.Views.NotebookView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sessions List -->
        <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#C2DDD5" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,16,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Danh sách cuộc họp" FontSize="16" FontWeight="Bold" Foreground="#243D35" Margin="0,0,0,12"/>

                <TextBox DockPanel.Dock="Top" Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}" ToolTip="Tìm tiêu đề và nội dung" Margin="0,0,0,12"/>
                <ListBox ItemsSource="{Binding SessionsView}" SelectedItem="{Binding SelectedSession}" Background="Transparent" BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource TranscriptCard}" Margin="0,0,0,6">
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" Foreground="#243D35" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding FormattedDate}" FontSize="11" Foreground="#73827C" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Session Detail & Export -->
        <Border Grid.Column="1" Background="#FFFFFF" BorderBrush="#C2DDD5" BorderThickness="1" CornerRadius="12" Padding="18">
            <DockPanel>
                <!-- Detail Header -->
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="{Binding SelectedSession.Title}" FontSize="18" FontWeight="Bold" Foreground="#243D35" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding SelectedSession.FormattedDate}" FontSize="12" Foreground="#65756F" Margin="0,2,0,0"/>
                    </StackPanel>

                    <!-- Export Actions -->
                    <WrapPanel HorizontalAlignment="Left" Margin="0,12,0,0">
                        <Button Content="Ghi chú" Command="{Binding OpenNotesCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>
                        <Button Content="✨ Tóm tắt AI" Command="{Binding GenerateSummaryCommand}" Background="#059669" Foreground="White" Margin="0,0,8,0" Padding="12,6" Cursor="Hand"/>
                        <Button Content="📄 Xuất Word (.docx)" Command="{Binding ExportDocxCommand}" Background="#287568" Foreground="White" Margin="0,0,8,0" Padding="12,6" Cursor="Hand"/>
                        <Button Content="🎬 Xuất SRT" Command="{Binding ExportSrtCommand}" Background="#D8E5E1" Foreground="#243D35" Padding="12,6" Cursor="Hand"/>
                    </WrapPanel>
                </StackPanel>

                <!-- AI Summary Card if available -->
                <Border DockPanel.Dock="Top" Background="#F5F8F7" BorderBrush="#059669" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedSession.Summary}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding SelectedSession.Summary}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Text="✨ Tóm tắt cuộc họp bằng AI" FontWeight="Bold" FontSize="13" Foreground="#10B981" Margin="0,0,0,6"/>
                        <TextBlock Text="{Binding SelectedSession.Summary}" FontSize="13" Foreground="#334B43" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Status line -->
                <TextBlock DockPanel.Dock="Bottom" Text="{Binding Status}" FontSize="11" Foreground="#73827C" Margin="0,8,0,0"/>

                <!-- Captions inside selected session -->
                <ListBox ItemsSource="{Binding SelectedSession.Captions}" Background="Transparent" BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource TranscriptCard}" Margin="0,0,0,6">
                                <StackPanel>
                                    <TextBlock Text="{Binding FormattedTimestamp}" FontSize="10" FontWeight="Bold" Foreground="#73827C"/>
                                    <TextBlock Text="{Binding Original}" TextWrapping="Wrap" FontSize="14" Foreground="#334B43" Margin="0,2,0,0"/>
                                    <TextBlock Text="{Binding Vietnamese}" TextWrapping="Wrap" FontSize="14" Foreground="#287568" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
