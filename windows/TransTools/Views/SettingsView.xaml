<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:ui="clr-namespace:TransTools.Views" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="TransTools.Views.SettingsView">
  <UserControl.Resources>
    <Style x:Key="SettingsSection" TargetType="TabItem">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Foreground" Value="#65756F" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabItem">
            <Border x:Name="SectionChrome" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,0,0,8" MinHeight="50">
              <ContentPresenter ContentSource="Header" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="SectionChrome" Property="Background" Value="#DCEAE5" />
                <Setter TargetName="SectionChrome" Property="BorderBrush" Value="#B5D2C9" />
                <Setter Property="Foreground" Value="#287568" />
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="SectionChrome" Property="BorderBrush" Value="#75BBAE" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>
  <DockPanel>
    <TextBlock DockPanel.Dock="Bottom" Text="{Binding Status}" Foreground="#287568" TextWrapping="Wrap" Margin="308,8,28,0" />
    <TabControl TabStripPlacement="Left" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource SettingsSection}">
      <TabControl.Template>
        <ControlTemplate TargetType="TabControl">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="280" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="Cài đặt" FontSize="22" FontWeight="SemiBold" Foreground="#243D35" Margin="14,8,0,24" />
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TabPanel IsItemsHost="True" />
              </ScrollViewer>
            </StackPanel>
            <ContentPresenter Grid.Column="1" ContentSource="SelectedContent" Margin="28,20,28,20" />
          </Grid>
        </ControlTemplate>
      </TabControl.Template>
      <TabItem Header="AI &amp; Kết nối">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel>
            <TextBlock Text="AI &amp; Kết nối" FontSize="24" FontWeight="SemiBold" Margin="0,8,0,24" />
            <Border Background="#FFFFFF" CornerRadius="12" Padding="20" Margin="0,0,0,16" BorderBrush="#C2DDD5" BorderThickness="1">
              <StackPanel>
                <TextBlock Text="Cấu hình AI" FontSize="15" FontWeight="Bold" Foreground="#243D35" Margin="0,0,0,12" />
                <TextBlock Text="API Key được bảo mật cục bộ theo tài khoản Windows của bạn, không gửi qua bất kỳ máy chủ trung gian nào." FontSize="12" Foreground="#65756F" Margin="0,0,0,16" />
                <TextBlock Text="Nhà cung cấp dùng cho các tính năng AI" Foreground="#65756F" />
                <ComboBox ItemsSource="{Binding Providers}" SelectedItem="{Binding ActiveProvider}" Margin="0,8" />
                <WrapPanel Margin="0,0,0,12">
                  <Button Content="Lấy danh sách mô hình" Command="{Binding FetchModelsCommand}" Margin="0,0,8,0" />
                  <ComboBox ItemsSource="{Binding AvailableModels}" SelectedItem="{Binding CatalogModel}" Width="300" />
                </WrapPanel>
                <TextBlock Text="OpenAI API Key:" FontSize="13" Foreground="#334B43" Margin="0,0,0,4" />
                <PasswordBox ui:KeyBinding.Value="{Binding OpenAiKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Background="#F5F8F7" Foreground="#243D35" BorderBrush="#D8E5E1" Padding="8,6" Margin="0,0,0,12" />
                <TextBlock Text="Mô hình muốn sử dụng" Foreground="#65756F" />
                <TextBox Text="{Binding OpenAiModel, UpdateSourceTrigger=PropertyChanged}" Background="#F5F8F7" Foreground="#243D35" Padding="8,6" Margin="0,4,0,12" />
                <TextBlock Text="Google Gemini API Key:" FontSize="13" Foreground="#334B43" Margin="0,0,0,4" />
                <PasswordBox ui:KeyBinding.Value="{Binding GeminiKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Background="#F5F8F7" Foreground="#243D35" BorderBrush="#D8E5E1" Padding="8,6" Margin="0,0,0,12" />
                <TextBlock Text="Mô hình muốn sử dụng" Foreground="#65756F" />
                <TextBox Text="{Binding GeminiModel, UpdateSourceTrigger=PropertyChanged}" Background="#F5F8F7" Foreground="#243D35" Padding="8,6" Margin="0,4,0,12" />
                <TextBlock Text="Anthropic Claude API Key:" FontSize="13" Foreground="#334B43" Margin="0,0,0,4" />
                <PasswordBox ui:KeyBinding.Value="{Binding ClaudeKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Background="#F5F8F7" Foreground="#243D35" BorderBrush="#D8E5E1" Padding="8,6" Margin="0,0,0,12" />
                <TextBlock Text="Mô hình muốn sử dụng" Foreground="#65756F" />
                <TextBox Text="{Binding ClaudeModel, UpdateSourceTrigger=PropertyChanged}" Background="#F5F8F7" Foreground="#243D35" Padding="8,6" Margin="0,4,0,12" />
                <TextBlock Text="DeepSeek API Key:" FontSize="13" Foreground="#334B43" Margin="0,0,0,4" />
                <PasswordBox ui:KeyBinding.Value="{Binding DeepSeekKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Background="#F5F8F7" Foreground="#243D35" BorderBrush="#D8E5E1" Padding="8,6" Margin="0,0,0,16" />
                <TextBlock Text="Mô hình muốn sử dụng" Foreground="#65756F" />
                <TextBox Text="{Binding DeepSeekModel, UpdateSourceTrigger=PropertyChanged}" Background="#F5F8F7" Foreground="#243D35" Padding="8,6" Margin="0,4,0,12" />
                <Button Content="Lưu cấu hình AI" Command="{Binding SaveAllKeysCommand}" Background="#287568" Foreground="White" FontWeight="Bold" Padding="16,8" HorizontalAlignment="Right" Cursor="Hand" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="Mô hình AI">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel>
            <TextBlock Text="Mô hình AI" FontSize="24" FontWeight="SemiBold" Margin="0,8,0,24" />
            <Border Background="#FFFFFF" CornerRadius="12" Padding="20" Margin="0,0,0,16" BorderBrush="#C2DDD5" BorderThickness="1">
              <StackPanel>
                <TextBlock Text="Giọng tự nhiên · Supertonic 3" FontSize="18" Foreground="#243D35" />
                <TextBlock Text="Dùng offline sau khi tải · Việt, Anh, Nhật, Hàn" Foreground="#65756F" Margin="0,8" />
                <TextBlock Text="{Binding LocalVoiceStatus}" Foreground="#75BBAE" Margin="0,8" />
                <WrapPanel>
                  <Button Content="Giấy phép" Command="{Binding OpenVoiceLicenseCommand}" Margin="0,0,8,0" />
                  <Button Content="Tải mô hình" Command="{Binding InstallVoiceCommand}" Margin="0,0,8,0" />
                  <Button Content="Hủy tải" Command="{Binding CancelVoiceInstallCommand}" Margin="0,0,8,0" />
                  <Button Content="Gỡ mô hình" Style="{StaticResource DestructiveButton}" Command="{Binding RemoveVoiceCommand}" Foreground="#EF4444" />
                </WrapPanel>
              </StackPanel>
            </Border>
            <Border Background="#FFFFFF" CornerRadius="12" Padding="20" Margin="0,0,0,16" BorderBrush="#C2DDD5" BorderThickness="1">
              <StackPanel>
                <TextBlock Text="VieNeu v3 Turbo · Tiếng Việt" FontSize="18" Foreground="#243D35" />
                <TextBlock Text="Giọng tiếng Việt · Tải khi cần · Dùng offline" Foreground="#65756F" TextWrapping="Wrap" Margin="0,8" />
                <Button Content="Tải VieNeu" IsEnabled="{Binding HasVieNeuProcessor}" Command="{Binding InstallVieNeuCommand}" HorizontalAlignment="Left" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="Giọng đọc &amp; Phát âm">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel>
            <TextBlock Text="Giọng đọc &amp; Phát âm" FontSize="24" FontWeight="SemiBold" Margin="0,8,0,24" />
            <Border Background="#FFFFFF" CornerRadius="12" Padding="20" Margin="0,0,0,16" BorderBrush="#C2DDD5" BorderThickness="1">
              <StackPanel>
                <TextBlock Text="Bản ghi phát âm offline" FontSize="18" Foreground="#243D35" />
                <TextBlock Text="Nhập bộ âm thanh mẫu để nghe phát âm khi học chữ." TextWrapping="Wrap" Foreground="#65756F" Margin="0,10" />
                <Button Content="Nhập bộ bản ghi" Command="{Binding ImportRecordingsCommand}" HorizontalAlignment="Left" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="Chip Chip &amp; Sức khỏe">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel>
            <TextBlock Text="Chip Chip &amp; Sức khỏe" FontSize="24" FontWeight="SemiBold" Margin="0,8,0,24" />
            <Border Background="White" BorderBrush="#C2DDD5" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,16">
              <StackPanel>
                <TextBlock Text="Trợ lý của bạn" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="Tên trợ lý" VerticalAlignment="Center" />
                  <TextBox Grid.Column="1" Text="{Binding AssistantName}" MaxLength="40" MinHeight="40" ToolTip="Để trống để dùng Chip Chip" Margin="0,0,12,0" />
                  <Button Grid.Column="2" Content="Lưu" Command="{Binding SaveAssistantNameCommand}" />
                </Grid>
                <TextBlock Text="Tên này dùng trong trò chuyện, phụ đề và trợ lý trên màn hình." Foreground="#65756F" Margin="0,10,0,0" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
            <Border Background="#FFFFFF" CornerRadius="12" Padding="20" Margin="0,0,0,16" BorderBrush="#C2DDD5" BorderThickness="1">
              <StackPanel>
                <DockPanel>
                  <CheckBox DockPanel.Dock="Right" IsChecked="{Binding BreakReminderEnabled}" VerticalAlignment="Center" />
                  <TextBlock Text="Chip Chip nhắc nghỉ" FontSize="18" Foreground="#243D35" />
                </DockPanel>
                <TextBlock Text="Nhắc chớp mắt, uống nước và thư giãn vai khi học hoặc làm việc." Foreground="#65756F" TextWrapping="Wrap" Margin="0,8" />
                <WrapPanel>
                  <TextBlock Text="Chu kỳ (phút)" Foreground="#65756F" VerticalAlignment="Center" Margin="0,0,12,0" />
                  <ComboBox ItemsSource="{Binding BreakIntervals}" SelectedItem="{Binding BreakMinutes}" Width="100" Margin="0,0,12,0" />
                  <Button Content="Lưu nhịp nghỉ" Command="{Binding SaveBreakReminderCommand}" />
                </WrapPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="Lưu trữ &amp; Dữ liệu">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel>
            <TextBlock Text="Lưu trữ &amp; Dữ liệu" FontSize="24" FontWeight="SemiBold" Margin="0,8,0,24" />
            <Border Background="#FFFFFF" CornerRadius="12" Padding="20" Margin="0,0,0,16" BorderBrush="#C2DDD5" BorderThickness="1">
              <StackPanel>
                <TextBlock Text="Dung lượng đang sử dụng" FontSize="15" FontWeight="Bold" Foreground="#243D35" Margin="0,0,0,12" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                  <TextBlock Text="Dung lượng dữ liệu &amp; mô hình hiện tại:" Foreground="#65756F" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding CacheSize}" FontWeight="Bold" Foreground="#287568" Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <ListBox ItemsSource="{Binding StorageGroups}" SelectedItem="{Binding SelectedStorage}" Background="Transparent" BorderBrush="#75BBAE" Margin="0,0,0,12">
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <StackPanel Margin="8">
                        <TextBlock Text="{Binding Title}" Foreground="#243D35" FontWeight="Bold" />
                        <TextBlock Text="{Binding Detail}" Foreground="#65756F" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Size}" Foreground="#75BBAE" />
                      </StackPanel>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <WrapPanel Margin="0,0,0,12">
                  <Button Content="Làm mới" Command="{Binding RefreshStorageCommand}" Margin="0,0,8,0" />
                  <Button Content="Gỡ / Dọn nhóm đã chọn" Style="{StaticResource DestructiveButton}" Command="{Binding RemoveStorageCommand}" Background="#FFF1F1" Foreground="#C84343" BorderBrush="#F3BABA" />
                </WrapPanel>
                <StackPanel Orientation="Horizontal">
                  <Button Content="📂 Mở thư mục dữ liệu" Command="{Binding OpenDataFolderCommand}" Background="#D8E5E1" Foreground="#243D35" Padding="14,8" Margin="0,0,10,0" Cursor="Hand" />
                  <Button Content="🧹 Dọn dẹp bộ nhớ đệm" Command="{Binding ClearCacheCommand}" Background="#FFF1F1" Foreground="#C84343" BorderBrush="#F3BABA" Padding="14,8" Cursor="Hand" />
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="Hệ thống &amp; Cập nhật">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel>
            <TextBlock Text="Hệ thống &amp; Cập nhật" FontSize="24" FontWeight="SemiBold" Margin="0,8,0,24" />
            <Border Background="#FFFFFF" CornerRadius="12" Padding="20" Margin="0,0,0,16" BorderBrush="#C2DDD5" BorderThickness="1">
              <StackPanel>
                <TextBlock Text="Phiên bản &amp; Cập nhật" FontSize="18" FontWeight="Bold" Foreground="#243D35" />
                <TextBlock Text="{Binding UpdateStatus}" Foreground="#75BBAE" TextWrapping="Wrap" Margin="0,10" />
                <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto">
                  <TextBlock Text="{Binding ReleaseNotes}" TextWrapping="Wrap" Foreground="#65756F" />
                </ScrollViewer>
                <ProgressBar Value="{Binding UpdateProgress}" Maximum="1" Height="6" Margin="0,12" Visibility="{Binding IsUpdating, Converter={StaticResource BoolVisibility}}" />
                <WrapPanel>
                  <Button Content="Kiểm tra cập nhật" Command="{Binding CheckUpdateCommand}" Margin="0,0,8,0" />
                  <Button Content="Tải &amp; Cài cập nhật" Command="{Binding InstallUpdateCommand}" IsEnabled="{Binding CanInstallUpdate}" Margin="0,0,8,0" />
                  <Button Content="Hủy tải" Command="{Binding CancelUpdateCommand}" />
                </WrapPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
  </DockPanel>
</UserControl>