<UserControl x:Class="TransTools.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:TransTools.ViewModels"
             xmlns:ui="clr-namespace:TransTools.Views">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="800" HorizontalAlignment="Left">
            <Border Background="White" BorderBrush="#C2DDD5" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,16">
                <StackPanel><TextBlock Text="Trợ lý của bạn" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="Tên trợ lý" VerticalAlignment="Center"/>
                <TextBox Grid.Column="1" Text="{Binding AssistantName}" MaxLength="40" MinHeight="40" ToolTip="Để trống để dùng Chip Chip" Margin="0,0,12,0"/>
                <Button Grid.Column="2" Content="Lưu" Command="{Binding SaveAssistantNameCommand}"/></Grid>
                <TextBlock Text="Tên này dùng trong trò chuyện, phụ đề và trợ lý trên màn hình." Foreground="#65756F" Margin="0,10,0,0" TextWrapping="Wrap"/></StackPanel>
            </Border>

            <!-- Header -->
            <TextBlock Text="Cài đặt hệ thống &amp; Dịch vụ AI" FontSize="20" FontWeight="Bold" Foreground="#243D35" Margin="0,0,0,16"/>

            <Border Background="#FFFFFF" CornerRadius="12" Padding="20" Margin="0,0,0,16"><StackPanel>
                <TextBlock Text="Phiên bản &amp; Cập nhật" FontSize="18" FontWeight="Bold" Foreground="#243D35"/>
                <TextBlock Text="{Binding UpdateStatus}" Foreground="#75BBAE" TextWrapping="Wrap" Margin="0,10"/>
                <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto"><TextBlock Text="{Binding ReleaseNotes}" TextWrapping="Wrap" Foreground="#65756F"/></ScrollViewer>
                <ProgressBar Value="{Binding UpdateProgress}" Maximum="1" Height="6" Margin="0,12" Visibility="{Binding IsUpdating, Converter={StaticResource BoolVisibility}}"/>
                <WrapPanel><Button Content="Kiểm tra cập nhật" Command="{Binding CheckUpdateCommand}" Margin="0,0,8,0"/><Button Content="Tải &amp; Cài cập nhật" Command="{Binding InstallUpdateCommand}" IsEnabled="{Binding CanInstallUpdate}" Margin="0,0,8,0"/><Button Content="Hủy tải" Command="{Binding CancelUpdateCommand}"/></WrapPanel>
            </StackPanel></Border>
            <!-- AI API Keys Card -->
            <Border Background="#FFFFFF" CornerRadius="12" Padding="20" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="🔑 Cấu hình Khóa API (Mã hóa Windows DPAPI)" FontSize="15" FontWeight="Bold" Foreground="#243D35" Margin="0,0,0,12"/>
                    <TextBlock Text="API Key được bảo mật cục bộ theo tài khoản Windows của bạn, không gửi qua bất kỳ máy chủ trung gian nào." FontSize="12" Foreground="#65756F" Margin="0,0,0,16"/>

                    <TextBlock Text="Nhà cung cấp dùng cho các tính năng AI" Foreground="#65756F"/>
                    <ComboBox ItemsSource="{Binding Providers}" SelectedItem="{Binding ActiveProvider}" Margin="0,8"/>
                    <WrapPanel Margin="0,0,0,12">
                        <Button Content="Tải danh sách model" Command="{Binding FetchModelsCommand}" Margin="0,0,8,0"/>
                        <ComboBox ItemsSource="{Binding AvailableModels}" SelectedItem="{Binding CatalogModel}" Width="300"/>
                    </WrapPanel>
                    <!-- OpenAI -->
                    <TextBlock Text="OpenAI API Key:" FontSize="13" Foreground="#334B43" Margin="0,0,0,4"/>
                    <PasswordBox ui:KeyBinding.Value="{Binding OpenAiKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Background="#F5F8F7" Foreground="#243D35" BorderBrush="#D8E5E1" Padding="8,6" Margin="0,0,0,12"/>
                    <TextBlock Text="Model ID (nhập model khả dụng từ nhà cung cấp):" Foreground="#65756F"/>
                    <TextBox Text="{Binding OpenAiModel, UpdateSourceTrigger=PropertyChanged}" Background="#F5F8F7" Foreground="#243D35" Padding="8,6" Margin="0,4,0,12"/>

                    <!-- Google Gemini -->
                    <TextBlock Text="Google Gemini API Key:" FontSize="13" Foreground="#334B43" Margin="0,0,0,4"/>
                    <PasswordBox ui:KeyBinding.Value="{Binding GeminiKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Background="#F5F8F7" Foreground="#243D35" BorderBrush="#D8E5E1" Padding="8,6" Margin="0,0,0,12"/>
                    <TextBlock Text="Model ID (nhập model khả dụng từ nhà cung cấp):" Foreground="#65756F"/>
                    <TextBox Text="{Binding GeminiModel, UpdateSourceTrigger=PropertyChanged}" Background="#F5F8F7" Foreground="#243D35" Padding="8,6" Margin="0,4,0,12"/>

                    <!-- Anthropic Claude -->
                    <TextBlock Text="Anthropic Claude API Key:" FontSize="13" Foreground="#334B43" Margin="0,0,0,4"/>
                    <PasswordBox ui:KeyBinding.Value="{Binding ClaudeKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Background="#F5F8F7" Foreground="#243D35" BorderBrush="#D8E5E1" Padding="8,6" Margin="0,0,0,12"/>
                    <TextBlock Text="Model ID (nhập model khả dụng từ nhà cung cấp):" Foreground="#65756F"/>
                    <TextBox Text="{Binding ClaudeModel, UpdateSourceTrigger=PropertyChanged}" Background="#F5F8F7" Foreground="#243D35" Padding="8,6" Margin="0,4,0,12"/>

                    <!-- DeepSeek -->
                    <TextBlock Text="DeepSeek API Key:" FontSize="13" Foreground="#334B43" Margin="0,0,0,4"/>
                    <PasswordBox ui:KeyBinding.Value="{Binding DeepSeekKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Background="#F5F8F7" Foreground="#243D35" BorderBrush="#D8E5E1" Padding="8,6" Margin="0,0,0,16"/>
                    <TextBlock Text="Model ID (nhập model khả dụng từ nhà cung cấp):" Foreground="#65756F"/>
                    <TextBox Text="{Binding DeepSeekModel, UpdateSourceTrigger=PropertyChanged}" Background="#F5F8F7" Foreground="#243D35" Padding="8,6" Margin="0,4,0,12"/>

                    <Button Content="💾 Lưu tất cả API Key" Command="{Binding SaveAllKeysCommand}" Background="#287568" Foreground="White" FontWeight="Bold" Padding="16,8" HorizontalAlignment="Left" Cursor="Hand"/>
                </StackPanel>
            </Border>

            <Border Background="#FFFFFF" CornerRadius="12" Padding="20" Margin="0,0,0,16">
                <StackPanel><TextBlock Text="Giọng tự nhiên · Supertonic 3" FontSize="18" Foreground="#243D35"/><TextBlock Text="Offline sau khi tải · Việt, Anh, Nhật, Hàn · ONNX native" Foreground="#65756F" Margin="0,8"/><TextBlock Text="{Binding LocalVoiceStatus}" Foreground="#75BBAE" Margin="0,8"/><WrapPanel><Button Content="Giấy phép" Command="{Binding OpenVoiceLicenseCommand}" Margin="0,0,8,0"/><Button Content="Tải mô hình" Command="{Binding InstallVoiceCommand}" Margin="0,0,8,0"/><Button Content="Hủy tải" Command="{Binding CancelVoiceInstallCommand}" Margin="0,0,8,0"/><Button Content="Gỡ mô hình" Style="{StaticResource DestructiveButton}" Command="{Binding RemoveVoiceCommand}" Foreground="#EF4444"/></WrapPanel></StackPanel>
            </Border>
            <Border Background="#FFFFFF" CornerRadius="12" Padding="20" Margin="0,0,0,16"><StackPanel><TextBlock Text="Bản ghi phát âm offline" FontSize="18" Foreground="#243D35"/><TextBlock Text="Nhập bộ bản ghi có manifest và SHA-256. Phát âm chữ không dùng TTS thay thế." TextWrapping="Wrap" Foreground="#65756F" Margin="0,10"/><Button Content="Nhập bộ bản ghi" Command="{Binding ImportRecordingsCommand}" HorizontalAlignment="Left"/></StackPanel></Border>
            <Border Background="#FFFFFF" CornerRadius="12" Padding="20" Margin="0,0,0,16"><StackPanel><TextBlock Text="VieNeu v3 Turbo · Tiếng Việt" FontSize="18" Foreground="#243D35"/><TextBlock Text="C# + ONNX native · Tải khi cần · Không cần Python · Tốc độ gốc" Foreground="#65756F" TextWrapping="Wrap" Margin="0,8"/><Button Content="Tải VieNeu" IsEnabled="{Binding HasVieNeuProcessor}" Command="{Binding InstallVieNeuCommand}" HorizontalAlignment="Left"/></StackPanel></Border>
            <!-- Storage & Data Management -->
            <Border Background="#FFFFFF" CornerRadius="12" Padding="20" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="💾 Quản lý Lưu trữ &amp; Dữ liệu" FontSize="15" FontWeight="Bold" Foreground="#243D35" Margin="0,0,0,12"/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <TextBlock Text="Dung lượng dữ liệu &amp; mô hình hiện tại:" Foreground="#65756F" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding CacheSize}" FontWeight="Bold" Foreground="#287568" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <ListBox ItemsSource="{Binding StorageGroups}" SelectedItem="{Binding SelectedStorage}" Background="Transparent" BorderBrush="#75BBAE" Margin="0,0,0,12">
                        <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="8"><TextBlock Text="{Binding Title}" Foreground="#243D35" FontWeight="Bold"/><TextBlock Text="{Binding Detail}" Foreground="#65756F" TextWrapping="Wrap"/><TextBlock Text="{Binding Size}" Foreground="#75BBAE"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                    <WrapPanel Margin="0,0,0,12"><Button Content="Làm mới" Command="{Binding RefreshStorageCommand}" Margin="0,0,8,0"/><Button Content="Gỡ / Dọn nhóm đã chọn" Style="{StaticResource DestructiveButton}" Command="{Binding RemoveStorageCommand}" Background="#FFF1F1" Foreground="#C84343" BorderBrush="#F3BABA"/></WrapPanel>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="📂 Mở thư mục dữ liệu" Command="{Binding OpenDataFolderCommand}" Background="#D8E5E1" Foreground="#243D35" Padding="14,8" Margin="0,0,10,0" Cursor="Hand"/>
                        <Button Content="🧹 Dọn dẹp bộ nhớ đệm" Command="{Binding ClearCacheCommand}" Background="#FFF1F1" Foreground="#C84343" BorderBrush="#F3BABA" Padding="14,8" Cursor="Hand"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Background="#FFFFFF" CornerRadius="12" Padding="20" Margin="0,0,0,16">
                <StackPanel>
                    <DockPanel><CheckBox DockPanel.Dock="Right" IsChecked="{Binding BreakReminderEnabled}" VerticalAlignment="Center"/><TextBlock Text="Chip Chip nhắc nghỉ" FontSize="18" Foreground="#243D35"/></DockPanel>
                    <TextBlock Text="Nhắc chớp mắt, uống nước và thư giãn vai khi học hoặc làm việc." Foreground="#65756F" TextWrapping="Wrap" Margin="0,8"/>
                    <WrapPanel><TextBlock Text="Chu kỳ (phút)" Foreground="#65756F" VerticalAlignment="Center" Margin="0,0,12,0"/><ComboBox ItemsSource="{Binding BreakIntervals}" SelectedItem="{Binding BreakMinutes}" Width="100" Margin="0,0,12,0"/><Button Content="Lưu nhịp nghỉ" Command="{Binding SaveBreakReminderCommand}"/></WrapPanel>
                </StackPanel>
            </Border>
            <!-- Status Notice -->
            <TextBlock Text="{Binding Status}" FontSize="12" Foreground="#10B981" Margin="0,4,0,20"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
