<UserControl x:Class="TransTools.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:TransTools.ViewModels">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="800" HorizontalAlignment="Left">
            <!-- Header -->
            <TextBlock Text="Cài đặt hệ thống &amp; Dịch vụ AI" FontSize="20" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,0,0,16"/>

            <!-- AI API Keys Card -->
            <Border Background="#1E293B" CornerRadius="12" Padding="20" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="🔑 Cấu hình Khóa API (Mã hóa Windows DPAPI)" FontSize="15" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,0,0,12"/>
                    <TextBlock Text="API Key được bảo mật cục bộ theo tài khoản Windows của bạn, không gửi qua bất kỳ máy chủ trung gian nào." FontSize="12" Foreground="#94A3B8" Margin="0,0,0,16"/>

                    <!-- OpenAI -->
                    <TextBlock Text="OpenAI API Key:" FontSize="13" Foreground="#E2E8F0" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding OpenAiKey, UpdateSourceTrigger=PropertyChanged}" Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#334155" Padding="8,6" Margin="0,0,0,12"/>

                    <!-- Google Gemini -->
                    <TextBlock Text="Google Gemini API Key:" FontSize="13" Foreground="#E2E8F0" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding GeminiKey, UpdateSourceTrigger=PropertyChanged}" Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#334155" Padding="8,6" Margin="0,0,0,12"/>

                    <!-- Anthropic Claude -->
                    <TextBlock Text="Anthropic Claude API Key:" FontSize="13" Foreground="#E2E8F0" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding ClaudeKey, UpdateSourceTrigger=PropertyChanged}" Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#334155" Padding="8,6" Margin="0,0,0,12"/>

                    <!-- DeepSeek -->
                    <TextBlock Text="DeepSeek API Key:" FontSize="13" Foreground="#E2E8F0" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding DeepSeekKey, UpdateSourceTrigger=PropertyChanged}" Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#334155" Padding="8,6" Margin="0,0,0,16"/>

                    <Button Content="💾 Lưu tất cả API Key" Command="{Binding SaveAllKeysCommand}" Background="#2563EB" Foreground="White" FontWeight="Bold" Padding="16,8" HorizontalAlignment="Left" Cursor="Hand"/>
                </StackPanel>
            </Border>

            <!-- Storage & Data Management -->
            <Border Background="#1E293B" CornerRadius="12" Padding="20" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="💾 Quản lý Lưu trữ &amp; Dữ liệu" FontSize="15" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,0,0,12"/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <TextBlock Text="Dung lượng dữ liệu &amp; mô hình hiện tại:" Foreground="#94A3B8" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding CacheSize}" FontWeight="Bold" Foreground="#38BDF8" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <Button Content="📂 Mở thư mục dữ liệu" Command="{Binding OpenDataFolderCommand}" Background="#334155" Foreground="White" Padding="14,8" Margin="0,0,10,0" Cursor="Hand"/>
                        <Button Content="🧹 Dọn dẹp bộ nhớ đệm" Command="{Binding ClearCacheCommand}" Background="#334155" Foreground="White" Padding="14,8" Cursor="Hand"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Status Notice -->
            <TextBlock Text="{Binding Status}" FontSize="12" Foreground="#10B981" Margin="0,4,0,20"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
