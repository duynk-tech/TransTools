ntal"><TextBlock Text="&#xE765;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#287568" VerticalAlignment="Center" Margin="0,0,10,0"/><TextBlock Text="Phím tắt tiện ích" FontSize="13.5" FontWeight="Bold" Foreground="#292F2D" VerticalAlignment="Center"/></StackPanel><Border Height="1" Background="#DEE7E3" Margin="0,16,0,16"/></StackPanel><Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="250"/></Grid.ColumnDefinitions><TextBlock Text="Dịch văn bản đang chọn" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,20,0"/><TextBlock Grid.Column="1" Text="Ctrl + Alt + D" HorizontalAlignment="Right" Foreground="#287568" FontWeight="SemiBold"/></Grid><Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="250"/></Grid.ColumnDefinitions><TextBlock Text="Mở Dịch nhanh" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,20,0"/><TextBlock Grid.Column="1" Text="Ctrl + Alt + T" HorizontalAlignment="Right" Foreground="#287568" FontWeight="SemiBold"/></Grid><TextBlock Text="Nếu ứng dụng khác đang dùng cùng phím tắt, Trans Tools sẽ báo trong trạng thái Cài đặt." TextWrapping="Wrap" Foreground="#65756F"/></StackPanel></Border></StackPanel></ScrollViewer></TabItem>
