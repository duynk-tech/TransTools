<TabItem Header="Lưu trữ &amp; Dữ liệu" Tag="">
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <StackPanel>
   <ui:SettingsPageHeading Title="Lưu trữ &amp; Dữ liệu" Description="Mô hình đã cài, học liệu Offline và bộ nhớ đệm" Icon="&#xEDA2;" Margin="0,0,0,24"/>

