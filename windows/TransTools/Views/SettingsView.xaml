<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:ui="clr-namespace:TransTools.Views" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="TransTools.Views.SettingsView">
  <UserControl.Resources>
    <Style x:Key="SettingsSection" TargetType="TabItem">
      <Setter Property="Cursor" Value="Hand" /><Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="#292F2D" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabItem">
            <Border x:Name="SectionChrome" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="8" Padding="10,10" Margin="0,0,0,6" MinHeight="46">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border x:Name="SectionIconBackground" Background="#D8EAE5" CornerRadius="6" Width="26" Height="26" Margin="0,0,10,0"><TextBlock x:Name="SectionIcon" Text="{TemplateBinding Tag}" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#287568" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ContentPresenter Grid.Column="1" x:Name="SectionLabel" ContentSource="Header" VerticalAlignment="Center" TextElement.Foreground="#65756F" TextElement.FontWeight="SemiBold"/><TextBlock Grid.Column="2" x:Name="SectionChevron" Text="›" Foreground="#243D35" FontSize="20" VerticalAlignment="Center" Margin="8,0,0,0" Visibility="Collapsed"/></Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="SectionChrome" Property="Background" Value="#DCEAE5" />
                <Setter TargetName="SectionChrome" Property="BorderBrush" Value="#B5D2C9" />
                <Setter TargetName="SectionLabel" Property="TextElement.Foreground" Value="#243D35"/>
                <Setter TargetName="SectionIconBackground" Property="Background" Value="#287568"/>
                <Setter TargetName="SectionIcon" Property="Foreground" Value="White"/>
                <Setter TargetName="SectionChevron" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="SectionChrome" Property="BorderBrush" Value="#75BBAE" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>
  <DockPanel Background="Transparent">
    <TextBlock DockPanel.Dock="Bottom" Text="{Binding Status}" Foreground="#287568" TextWrapping="Wrap" Margin="308,8,28,0" />
    <TabControl x:Name="SettingsSections" TabStripPlacement="Left" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource SettingsSection}">
      <TabControl.Template>
        <ControlTemplate TargetType="TabControl">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="280" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <DockPanel Background="#BBEAF2EF" Margin="0,0,0,0">
              <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="16,18,16,16"><TextBlock Text="&#xE9E9;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="#243D35" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBlock Text="Cài đặt" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/></StackPanel>
              <TextBlock DockPanel.Dock="Bottom" Text="{Binding AppVersion}" FontFamily="Consolas" FontSize="11" Foreground="#73827C" Margin="14,16,0,16"/>
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TabPanel IsItemsHost="True" Margin="10,0" />
              </ScrollViewer>
            </DockPanel>
            <Border Grid.Column="0" HorizontalAlignment="Right" Width="1" Background="#BDD9D2" IsHitTestVisible="False"/><ContentPresenter Grid.Column="1" ContentSource="SelectedContent" Margin="28" />
          </Grid>
        </ControlTemplate>
      </TabControl.Template>
      <TabItem Header="Dịch &amp; Phụ đề" Tag="&#xE8F2;"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel><ui:SettingsPageHeading Title="Dịch &amp; Phụ đề" Description="Chuyên ngành, ngôn ngữ và công cụ dịch" Icon="&#xE8F2;" Margin="0,0,0,24"/><Border Background="White" BorderBrush="#C2DDD5" BorderThickness="1" CornerRadius="14" Padding="20" Margin="0,0,0,16"><StackPanel><StackPanel><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE821;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#287568" VerticalAlignment="Center" Margin="0,0,10,0"/><TextBlock Text="Chuyên ngành &amp; Ngữ cảnh" FontSize="13.5" FontWeight="Bold" Foreground="#292F2D" VerticalAlignment="Center"/></StackPanel><Border Height="1" Background="#DEE7E3" Margin="0,16,0,16"/></StackPanel><Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="250"/></Grid.ColumnDefinitions><TextBlock Text="Chuyên ngành dịch" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,20,0"/><ComboBox Grid.Column="1" SelectedItem="{Binding TranslationDomain}" ItemsSource="{Binding TranslationDomains}"/></Grid><TextBlock Text="Áp dụng cho Dịch nhanh và dịch bằng AI trong cuộc họp. Phiên họp đang chạy giữ chuyên ngành đã chọn lúc bắt đầu." TextWrapping="Wrap" Foreground="#65756F"/></StackPanel></Border><Border Background="White" BorderBrush="#C2DDD5" BorderThickness="1" CornerRadius="14" Padding="20" Margin="0,0,0,16"><StackPanel><StackPanel><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8F2;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#287568" VerticalAlignment="Center" Margin="0,0,10,0"/><TextBlock Text="Nhịp hiển thị phụ đề" FontSize="13.5" FontWeight="Bold" Foreground="#292F2D" VerticalAlignment="Center"/></StackPanel><Border Height="1" Background="#DEE7E3" Margin="0,16,0,16"/></StackPanel><Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="250"/></Grid.ColumnDefinitions><TextBlock Text="Độ trễ bản dịch" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,20,0"/><ComboBox Grid.Column="1" SelectedItem="{Binding SubtitlePacing}" ItemsSource="{Binding SubtitlePacingOptions}"/></Grid><TextBlock Text="Nhanh chuyển câu sớm hơn. Cân bằng giữ thời gian đọc vừa phải. Đủ ngữ cảnh giữ câu lâu hơn. Tùy chọn này điều chỉnh thời gian hiển thị, không thay đổi tốc độ nhận diện hoặc dịch." TextWrapping="Wrap" Foreground="#65756F"/></StackPanel></Border><Border Background="White" BorderBrush="#C2DDD5" BorderThickness="1" CornerRadius="14" Padding="20" Margin="0,0,0,16"><StackPanel><StackPanel><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8A7;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#287568" VerticalAlignment="Center" Margin="0,0,10,0"/><TextBlock Text="Phụ đề nổi" FontSize="13.5" FontWeight="Bold" Foreground="#292F2D" VerticalAlignment="Center"/></StackPanel><Border Height="1" Background="#DEE7E3" Margin="0,16,0,16"/></StackPanel><Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="250"/></Grid.ColumnDefinitions><TextBlock Text="Cỡ chữ" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,20,0"/><ComboBox Grid.Column="1" SelectedItem="{Binding SubtitleFontSize}" ItemsSource="{Binding SubtitleFontSizes}"/></Grid><Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="250"/></Grid.ColumnDefinitions><TextBlock Text="Nền sáng" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,20,0"/><CheckBox Style="{StaticResource SettingsSwitch}" AutomationProperties.Name="Nền sáng" Grid.Column="1" IsChecked="{Binding SubtitleLight}" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid><Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="250"/></Grid.ColumnDefinitions><TextBlock Text="Hiện tiếng gốc" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,20,0"/><CheckBox Style="{StaticResource SettingsSwitch}" AutomationProperties.Name="Hiện tiếng gốc" Grid.Column="1" IsChecked="{Binding SubtitleOriginal}" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid><Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="250"/></Grid.ColumnDefinitions><TextBlock Text="Giữ câu trước để theo dõi ngữ cảnh" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,20,0"/><CheckBox Style="{StaticResource SettingsSwitch}" AutomationProperties.Name="Giữ câu trước để theo dõi ngữ cảnh" Grid.Column="1" IsChecked="{Binding SubtitleContext}" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid><Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="250"/></Grid.ColumnDefinitions><TextBlock Text="Hiện câu tiếp theo đang được dịch" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,20,0"/><CheckBox Style="{StaticResource SettingsSwitch}" AutomationProperties.Name="Hiện câu tiếp theo đang được dịch" Grid.Column="1" IsChecked="{Binding SubtitleNext}" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid><Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="250"/></Grid.ColumnDefinitions><TextBlock Text="Hiện trợ lý bên cạnh nội dung" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,20,0"/><CheckBox Style="{StaticResource SettingsSwitch}" AutomationProperties.Name="Hiện trợ lý bên cạnh nội dung" Grid.Column="1" IsChecked="{Binding SubtitleMascot}" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid><Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="250"/></Grid.ColumnDefinitions><TextBlock Text="Bố cục dọc bên cạnh màn hình" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,20,0"/><CheckBox Style="{StaticResource SettingsSwitch}" AutomationProperties.Name="Bố cục dọc bên cạnh màn hình" Grid.Column="1" IsChecked="{Binding SubtitleSide}" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid></StackPanel></Border><Button Content="Lưu tùy chỉnh" Command="{Binding SaveSubtitlePreferencesCommand}" HorizontalAlignment="Right"/></StackPanel></ScrollViewer></TabItem>
<TabItem Header="AI &amp; Kết nối" Tag="">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel>
            <ui:SettingsPageHeading Title="AI &amp; Kết nối" Description="Cấu hình dịch vụ AI và kết nối của bạn" Icon="&#xE734;" Margin="0,0,0,24"/>
            <Border Background="#FFFFFF" CornerRadius="12" Padding="20" Margin="0,0,0,16" BorderBrush="#C2DDD5" BorderThickness="1">
              <StackPanel>
                <TextBlock Text="Cấu hình AI" FontSize="15" FontWeight="Bold" Foreground="#243D35" Margin="0,0,0,12" />
                <TextBlock Text="API Key được bảo mật cục bộ theo tài khoản Windows của bạn, không gửi qua bất kỳ máy chủ trung gian nào." FontSize="12" Foreground="#65756F" Margin="0,0,0,16" />
                <TextBlock Text="Nhà cung cấp dùng cho các tính năng AI" Foreground="#65756F" />
                <ComboBox ItemsSource="{Binding Providers}" SelectedItem="{Binding ActiveProvider}" Margin="0,8"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource ProviderLabel}}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox>
                <WrapPanel Margin="0,0,0,12">
                  <Button Content="Lấy danh sách mô hình" Command="{Binding FetchModelsCommand}" Margin="0,0,8,0" Style="{StaticResource SecondaryButton}" />
                  <ComboBox ItemsSource="{Binding AvailableModels}" SelectedItem="{Binding CatalogModel}" Width="300" />
                </WrapPanel>
                <StackPanel><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding ActiveProvider}" Value="openai"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></StackPanel.Style><TextBlock Text="Khóa API" FontSize="13" Foreground="#334B43" Margin="0,0,0,4" />
                <PasswordBox ui:KeyBinding.Value="{Binding OpenAiKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Background="#F5F8F7" Foreground="#243D35" BorderBrush="#D8E5E1" Padding="8,6" Margin="0,0,0,12" />
                <TextBlock Text="Mô hình muốn sử dụng" Foreground="#65756F" />
                <TextBox Text="{Binding OpenAiModel, UpdateSourceTrigger=PropertyChanged}" Background="#F5F8F7" Foreground="#243D35" Padding="8,6" Margin="0,4,0,12" />
                </StackPanel><StackPanel><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding ActiveProvider}" Value="gemini"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></StackPanel.Style><TextBlock Text="Khóa API" FontSize="13" Foreground="#334B43" Margin="0,0,0,4" />
                <PasswordBox ui:KeyBinding.Value="{Binding GeminiKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Background="#F5F8F7" Foreground="#243D35" BorderBrush="#D8E5E1" Padding="8,6" Margin="0,0,0,12" />
                <TextBlock Text="Mô hình muốn sử dụng" Foreground="#65756F" />
                <TextBox Text="{Binding GeminiModel, UpdateSourceTrigger=PropertyChanged}" Background="#F5F8F7" Foreground="#243D35" Padding="8,6" Margin="0,4,0,12" />
                </StackPanel><StackPanel><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding ActiveProvider}" Value="claude"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></StackPanel.Style><TextBlock Text="Khóa API" FontSize="13" Foreground="#334B43" Margin="0,0,0,4" />
                <PasswordBox ui:KeyBinding.Value="{Binding ClaudeKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Background="#F5F8F7" Foreground="#243D35" BorderBrush="#D8E5E1" Padding="8,6" Margin="0,0,0,12" />
                <TextBlock Text="Mô hình muốn sử dụng" Foreground="#65756F" />
                <TextBox Text="{Binding ClaudeModel, UpdateSourceTrigger=PropertyChanged}" Background="#F5F8F7" Foreground="#243D35" Padding="8,6" Margin="0,4,0,12" />
                </StackPanel><StackPanel><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding ActiveProvider}" Value="deepseek"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></StackPanel.Style><TextBlock Text="Khóa API" FontSize="13" Foreground="#334B43" Margin="0,0,0,4" />
                <PasswordBox ui:KeyBinding.Value="{Binding DeepSeekKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Background="#F5F8F7" Foreground="#243D35" BorderBrush="#D8E5E1" Padding="8,6" Margin="0,0,0,16" />
                <TextBlock Text="Mô hình muốn sử dụng" Foreground="#65756F" />
                <TextBox Text="{Binding DeepSeekModel, UpdateSourceTrigger=PropertyChanged}" Background="#F5F8F7" Foreground="#243D35" Padding="8,6" Margin="0,4,0,12" />
                </StackPanel><Button Content="Lưu cấu hình AI" Command="{Binding SaveAllKeysCommand}" Background="#287568" Foreground="White" FontWeight="Bold" Padding="16,8" HorizontalAlignment="Right" Cursor="Hand" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
<TabItem Header="Mô hình AI" Tag="">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel>
            <DockPanel Margin="0,8,0,16"><Button DockPanel.Dock="Right" Content="Làm mới dung lượng" Command="{Binding RefreshStorageCommand}" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"/><Button DockPanel.Dock="Right" Content="{Binding CatalogUpdateLabel}" IsEnabled="{Binding CanManageModels}" Command="{Binding UpdateCatalogCommand}" Style="{StaticResource SecondaryButton}"/><ui:SettingsPageHeading Title="Mô hình AI" Description="Cài đặt, giọng đọc và dung lượng mô hình Offline" Icon="&#xE950;" Margin="0"/></DockPanel><TextBlock Text="{Binding CatalogStatus}" Foreground="#65756F" Margin="0,0,0,16" TextWrapping="Wrap"/>
<Border Background="White" BorderBrush="#C2DDD5" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,16"><DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center"><Button Content="Dừng cài gói" Command="{Binding CancelVoiceInstallCommand}" Style="{StaticResource SecondaryButton}" Visibility="{Binding InstallingSpeechPack,Converter={StaticResource BoolVisibility}}"/><Button Content="{Binding SpeechPackActionLabel}" Command="{Binding InstallSpeechPackCommand}" IsEnabled="{Binding CanInstallSpeechPack}"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}"><Style.Triggers><DataTrigger Binding="{Binding InstallingSpeechPack}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Button.Style></Button></StackPanel><StackPanel><TextBlock Text="Giọng đọc tiếng Việt" FontSize="12" FontWeight="Bold"/><TextBlock Text="Supertonic 3 · VieNeu v3 Turbo · chỉ tải tệp còn thiếu hoặc cần thay thế" FontSize="11" Foreground="#65756F" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel></DockPanel></Border><DockPanel Margin="0,0,0,16"><ComboBox DockPanel.Dock="Right" Width="165" ItemsSource="{Binding ModelVoiceLanguages}" ItemTemplate="{StaticResource LanguageItem}" SelectedItem="{Binding ModelVoiceLanguage}" IsEnabled="{Binding CanManageModels}"/><TextBlock Text="Chọn giọng mặc định cho ngôn ngữ" Foreground="#65756F" VerticalAlignment="Center"/></DockPanel><UniformGrid Columns="6" Margin="0,0,0,16"><RadioButton Content="Đề xuất" GroupName="ModelFilter" Style="{StaticResource SegmentedOption}" Margin="0,0,4,0" IsChecked="{Binding ModelFilter,Converter={StaticResource OptionSelection},ConverterParameter=recommended}"/><RadioButton Content="TTS" GroupName="ModelFilter" Style="{StaticResource SegmentedOption}" Margin="0,0,4,0" IsChecked="{Binding ModelFilter,Converter={StaticResource OptionSelection},ConverterParameter=tts}"/><RadioButton Content="STT" GroupName="ModelFilter" Style="{StaticResource SegmentedOption}" Margin="0,0,4,0" IsChecked="{Binding ModelFilter,Converter={StaticResource OptionSelection},ConverterParameter=stt}"/><RadioButton Content="Dịch" GroupName="ModelFilter" Style="{StaticResource SegmentedOption}" Margin="0,0,4,0" IsChecked="{Binding ModelFilter,Converter={StaticResource OptionSelection},ConverterParameter=translation}"/><RadioButton Content="Ngôn ngữ" GroupName="ModelFilter" Style="{StaticResource SegmentedOption}" Margin="0,0,4,0" IsChecked="{Binding ModelFilter,Converter={StaticResource OptionSelection},ConverterParameter=languageModel}"/><RadioButton Content="Đã cài" GroupName="ModelFilter" Style="{StaticResource SegmentedOption}" Margin="0,0,4,0" IsChecked="{Binding ModelFilter,Converter={StaticResource OptionSelection},ConverterParameter=installed}"/></UniformGrid><TextBlock Text="Chưa có mô hình đã tích hợp trong nhóm này." Visibility="{Binding ModelFilterEmpty,Converter={StaticResource BoolVisibility}}" Foreground="#65756F" Margin="0,0,0,18"/>
            <Border Visibility="{Binding ShowSupertonicCard,Converter={StaticResource BoolVisibility}}" Background="#FFFFFF" CornerRadius="12" Padding="20" Margin="0,0,0,16" BorderBrush="#C2DDD5" BorderThickness="1">
              <StackPanel>
                <TextBlock Text="Giọng tự nhiên · Supertonic 3" FontSize="18" FontWeight="SemiBold" Foreground="#243D35" />
                <TextBlock Text="{Binding SupertonicSummary}" Foreground="#65756F" Margin="0,8" />
                <TextBlock Text="{Binding LocalVoiceStatus}" Foreground="#287568" Margin="0,8" /><TextBlock Text="{Binding SupertonicStorageSize}" Foreground="#65756F" Margin="0,0,0,12"/>
                <WrapPanel>
                  <Button Content="Dùng giọng này" Command="{Binding UseSupertonicCommand}" IsEnabled="{Binding CanUseSupertonic}" Visibility="{Binding SupertonicInstalled,Converter={StaticResource BoolVisibility}}" Margin="0,0,8,0"/><Button Content="Giấy phép" Style="{StaticResource SecondaryButton}" Command="{Binding OpenVoiceLicenseCommand}" Margin="0,0,8,0" />
                  <Button Content="Tải mô hình" Visibility="{Binding ShowSupertonicInstall,Converter={StaticResource BoolVisibility}}" IsEnabled="{Binding CanManageModels}" Command="{Binding InstallVoiceCommand}" Margin="0,0,8,0" />
                  <Button Content="Hủy tải" Visibility="{Binding DownloadingSupertonic,Converter={StaticResource BoolVisibility}}" Style="{StaticResource SecondaryButton}" Command="{Binding CancelVoiceInstallCommand}" Margin="0,0,8,0" />
                  <Button Content="Gỡ mô hình" Visibility="{Binding SupertonicInstalled,Converter={StaticResource BoolVisibility}}" IsEnabled="{Binding CanManageModels}" Style="{StaticResource DestructiveButton}" Command="{Binding RemoveVoiceCommand}" Foreground="#EF4444" />
                </WrapPanel>
              </StackPanel>
            </Border>
            <Border Visibility="{Binding ShowVieNeuCard,Converter={StaticResource BoolVisibility}}" Background="#FFFFFF" CornerRadius="12" Padding="20" Margin="0,0,0,16" BorderBrush="#C2DDD5" BorderThickness="1">
              <StackPanel>
                <TextBlock Text="VieNeu v3 Turbo · Tiếng Việt" FontSize="18" FontWeight="SemiBold" Foreground="#243D35" />
                <TextBlock Text="{Binding VieNeuSummary}" Foreground="#65756F" TextWrapping="Wrap" Margin="0,8" />
                <TextBlock Text="{Binding VieNeuStorageSize}" Foreground="#65756F" Margin="0,0,0,8"/><TextBlock Text="{Binding VieNeuInstallationStatus}" Foreground="#287568" Margin="0,0,0,12"/><WrapPanel><Button Content="Dùng giọng này" Command="{Binding UseVieNeuCommand}" IsEnabled="{Binding CanUseVieNeu}" Visibility="{Binding VieNeuInstalled,Converter={StaticResource BoolVisibility}}" Margin="0,0,8,0"/><Button Content="Tải VieNeu" Visibility="{Binding ShowVieNeuInstall,Converter={StaticResource BoolVisibility}}" IsEnabled="{Binding CanInstallVieNeu}" Command="{Binding InstallVieNeuCommand}" Margin="0,0,8,0"/><Button Content="Hủy tải" Visibility="{Binding DownloadingVieNeu,Converter={StaticResource BoolVisibility}}" Style="{StaticResource SecondaryButton}" Command="{Binding CancelVoiceInstallCommand}" Margin="0,0,8,0"/><Button Content="Gỡ mô hình" Visibility="{Binding VieNeuInstalled,Converter={StaticResource BoolVisibility}}" IsEnabled="{Binding CanManageModels}" Command="{Binding RemoveVieNeuCommand}" Style="{StaticResource DestructiveButton}"/></WrapPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
<TabItem Header="Chip Chip &amp; Sức khỏe" Tag="">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel>
            <ui:SettingsPageHeading Title="Chip Chip &amp; Sức khỏe" Description="Hoạt cảnh và nhắc nhở giải lao" Icon="&#xE76E;" Margin="0,0,0,24"/>
            <Border Background="White" BorderBrush="#C2DDD5" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,16">
              <StackPanel>
                <TextBlock Text="Trợ lý của bạn" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="Tên trợ lý" VerticalAlignment="Center" />
                  <TextBox Grid.Column="1" Text="{Binding AssistantName}" MaxLength="40" MinHeight="40" ToolTip="Để trống để dùng Chip Chip" Margin="0,0,12,0" />
                  <Button Grid.Column="2" Content="Lưu" Command="{Binding SaveAssistantNameCommand}" />
                </Grid>
                <TextBlock Text="Tên này dùng trong trò chuyện, phụ đề và trợ lý trên màn hình." Foreground="#65756F" Margin="0,10,0,0" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
            <Border Background="#FFFFFF" CornerRadius="12" Padding="20" Margin="0,0,0,16" BorderBrush="#C2DDD5" BorderThickness="1">
              <StackPanel>
                <DockPanel>
                  <CheckBox Style="{StaticResource SettingsSwitch}" AutomationProperties.Name="Nhắc nghỉ giải lao" DockPanel.Dock="Right" IsChecked="{Binding BreakReminderEnabled}" VerticalAlignment="Center" />
                  <TextBlock Text="Chip Chip nhắc nghỉ" FontSize="18" FontWeight="SemiBold" Foreground="#243D35" />
