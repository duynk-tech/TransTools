<Window x:Class="TransTools.Views.ReadingLibraryWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Thư viện truyện" Width="760" Height="650" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
<Border Background="#F5F8F7" BorderBrush="#BDD9D2" BorderThickness="1" CornerRadius="16" Padding="24">
<Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<DockPanel Margin="0,0,0,16"><Button DockPanel.Dock="Right" Content="Đóng" Style="{StaticResource SecondaryButton}" Click="Close_Click"/><TextBlock Text="Thư viện truyện" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/></DockPanel>
<Grid Grid.Row="1" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="170"/></Grid.ColumnDefinitions><Grid Margin="0,0,12,0"><TextBox x:Name="QueryBox" Text="{Binding Query,UpdateSourceTrigger=PropertyChanged}" Height="40" MinHeight="40" Padding="34,6,12,6" KeyDown="Query_KeyDown" ToolTip="Tìm tên truyện…"/><TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#287568" VerticalAlignment="Center" Margin="12,0,0,0" HorizontalAlignment="Left" IsHitTestVisible="False"/><TextBlock Text="Tìm tên truyện…" Margin="34,0,12,0" VerticalAlignment="Center" IsHitTestVisible="False" Foreground="#93A19B"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Query}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid><ComboBox Grid.Column="1" Height="40" MinHeight="40" Margin="0" SelectedValuePath="Tag" SelectedValue="{Binding LanguageFilter}"><ComboBoxItem Content="Tất cả ngôn ngữ" Tag="all"/><ComboBoxItem Content="Tiếng Việt" Tag="vi" ContentTemplate="{StaticResource LanguageItem}"/><ComboBoxItem Content="Tiếng Anh" Tag="en" ContentTemplate="{StaticResource LanguageItem}"/></ComboBox></Grid>
<StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,12"><Button Content="Tìm trực tuyến" Command="{Binding SearchCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/><Button Content="Truyện gợi ý" Visibility="{Binding IsOnline,Converter={StaticResource BoolVisibility}}" Command="{Binding SuggestionsCommand}" Style="{StaticResource SecondaryButton}"/></StackPanel>
<ListBox Grid.Row="3" ItemsSource="{Binding StoriesView}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle><ListBox.ItemTemplate><DataTemplate><Border Style="{StaticResource TranscriptCard}" CornerRadius="12" Padding="16" Margin="0,0,0,12"><DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0"><Button Content="Xem nguồn" Click="Source_Click" Style="{StaticResource SecondaryButton}" Background="Transparent" BorderThickness="0" Margin="0,0,8,0"/><Button Content="Chọn truyện" Command="{Binding DataContext.LoadStoryCommand,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Style="{StaticResource SecondaryButton}"/></StackPanel><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Description}" TextWrapping="Wrap" FontSize="11" Foreground="#65756F" Margin="0,5,0,0"/></StackPanel></DockPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox>
<StackPanel Grid.Row="4" Margin="0,12,0,0"><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding CanUsePart}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style><DockPanel Margin="0,0,0,10"><ComboBox DockPanel.Dock="Right" Width="240" Height="40" MinHeight="40" Margin="0" ItemsSource="{Binding Parts}" SelectedItem="{Binding SelectedPart}" DisplayMemberPath="Label"/><TextBlock Text="{Binding SelectedStory.Title}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,12,0"/></DockPanel><TextBox Text="{Binding PreviewText,Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" Height="150" Padding="12" VerticalScrollBarVisibility="Auto"/><TextBlock Text="Nội dung được thay vào ô đọc khi bạn bấm Dùng phần này." FontSize="11" Foreground="#65756F" TextWrapping="Wrap" Margin="0,8,0,0"/><Button x:Name="UsePartButton" Content="Dùng phần này" HorizontalAlignment="Right" Margin="0,10,0,0" IsEnabled="{Binding CanUsePart}" Click="UsePart_Click"/></StackPanel>
<TextBlock Grid.Row="5" Text="{Binding Status}" Foreground="#65756F" FontSize="12" TextWrapping="Wrap" Margin="0,12,0,0"/>
</Grid></Border></Window>
