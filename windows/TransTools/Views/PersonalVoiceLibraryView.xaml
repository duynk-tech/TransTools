<UserControl x:Class="TransTools.Views.PersonalVoiceLibraryView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<StackPanel>
<Border Background="White" BorderBrush="#C2DDD5" BorderThickness="1" CornerRadius="14" Padding="18" Margin="0,0,0,16"><StackPanel>
<DockPanel><Button DockPanel.Dock="Right" Content="Thu giọng mới" Click="RecordVoice_Click" IsEnabled="{Binding CanConfigure}" Margin="16,0,0,0"/><TextBlock Text="Thư viện giọng cá nhân" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
<TextBlock Text="Một bản thu gốc, nhiều hồ sơ theo mô hình hỗ trợ. Dữ liệu giữ trên thiết bị." TextWrapping="Wrap" Foreground="#65756F" Margin="0,10,0,0"/>
</StackPanel></Border>
<Border Background="#E3F2ED" CornerRadius="12" Padding="16" Margin="0,0,0,16"><StackPanel><TextBlock Text="Mô hình tương thích" FontWeight="SemiBold"/><TextBlock Text="VieNeu-TTS v3 Turbo · Tiếng Việt · Mẫu 3–8 giây" Foreground="#287568" Margin="0,8,0,0"/><TextBlock Text="Cài mô hình trong Giọng đọc &amp; Phát âm → Nâng cao. Bản thu gốc có thể dùng lại khi cần tạo hồ sơ." TextWrapping="Wrap" Foreground="#65756F" Margin="0,8,0,0"/></StackPanel></Border>
<Border BorderBrush="#D8E5E1" BorderThickness="1" CornerRadius="14" Background="White" Padding="18" Margin="0,0,0,16"><StackPanel>
     <TextBlock Text="Bản thu đã lưu" FontSize="13" FontWeight="Bold"/>
     <TextBlock Text="Lưu âm thanh gốc trước, tạo hồ sơ VieNeu khi cần. Tạo hồ sơ giữ nguyên bản thu." FontSize="11" Foreground="#65756F" TextWrapping="Wrap" Margin="0,6,0,10"/>
     <TextBlock Text="Tìm bản thu theo tên" FontSize="12" Foreground="#65756F" Margin="0,0,0,6"/>
     <TextBox Text="{Binding RecordingQuery,UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanConfigure}" AutomationProperties.Name="Tìm bản thu theo tên" ToolTip="Tìm bản thu theo tên" Margin="0,0,0,8"/>
     <TextBlock Text="{Binding RecordingSearchStatus}" FontSize="11" Foreground="#65756F" Margin="0,0,0,8"/>
     <ComboBox ItemsSource="{Binding VisibleRecordings}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedRecording}" IsEnabled="{Binding CanConfigure}" AutomationProperties.Name="Bản thu đã lưu"/>
     <TextBlock Text="{Binding RecordingDetails}" FontSize="11" Foreground="#287568" Margin="0,8,0,0"/>
     <WrapPanel Margin="0,10,0,0"><Button Content="Nghe bản gốc" Command="{Binding PreviewOriginalRecordingCommand}" IsEnabled="{Binding CanManageRecording}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8"/><Button Content="Dừng" Command="{Binding StopPreviewCommand}" IsEnabled="{Binding IsPreviewing}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8"/><Button Content="Đổi tên" Click="RenameRecording_Click" IsEnabled="{Binding CanManageRecording}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8"/><Button Content="Thư mục" Command="{Binding OpenRecordingFolderCommand}" IsEnabled="{Binding CanManageRecording}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8"/><Button Content="Xóa bản thu" Click="DeleteRecording_Click" IsEnabled="{Binding CanManageRecording}" Style="{StaticResource DestructiveButton}" Margin="0,0,0,8"/></WrapPanel>
     <TextBlock Text="{Binding SelectedRecording.ReferenceText}" FontSize="12" Foreground="#65756F" TextWrapping="Wrap" Margin="0,8,0,0"/>
     <TextBlock Text="{Binding RecordingModelStatus}" FontSize="11" Foreground="#287568" Margin="0,12,0,0"/>
     <WrapPanel Margin="0,10,0,0" Visibility="{Binding HasSelectedModel,Converter={StaticResource BoolVisibility}}"><Button Content="Đọc thử câu mới" Command="{Binding TestRecordingVoiceCommand}" IsEnabled="{Binding CanUseRecordingVoice}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8"/><Button Content="Dùng tiếng Việt" Command="{Binding UseRecordingVoiceCommand}" IsEnabled="{Binding CanUseRecordingVoice}" Margin="0,0,8,8"/><Button Content="Gỡ hồ sơ" Click="RemoveRecordingModel_Click" IsEnabled="{Binding CanManageRecording}" Style="{StaticResource DestructiveButton}" Margin="0,0,0,8"/></WrapPanel>
     <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0"><Button Content="Hủy tạo giọng" Command="{Binding CancelRecordingVoiceCommand}" Visibility="{Binding IsBuildingVoice,Converter={StaticResource BoolVisibility}}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/><Button Content="Tạo hồ sơ VieNeu" Command="{Binding CreateRecordingVoiceCommand}" ToolTip="Cần cài VieNeu trước khi tạo hồ sơ"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}"><Style.Triggers><DataTrigger Binding="{Binding HasSelectedModel}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Button.Style></Button></StackPanel>
    </StackPanel></Border>
<TextBlock Text="{Binding Status}" TextWrapping="Wrap" Foreground="#65756F"/><TextBlock Text="Nghe bản thu để xác nhận tiếng ồn và lời đọc. Hồ sơ hiện dùng đặc trưng người nói; chưa sao chép đầy đủ phong cách và chưa có huấn luyện bổ sung." TextWrapping="Wrap" FontSize="11" Foreground="#65756F" Margin="0,14,0,0"/>
</StackPanel></UserControl>