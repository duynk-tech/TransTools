<Window x:Class="TransTools.Views.ConversationMiniWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Trò chuyện · Trans Tools" Width="460" Height="500" MinWidth="360" MinHeight="320" Topmost="True" ShowInTaskbar="False" Background="#F5F8F7">
 <Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,12"><DockPanel><Button DockPanel.Dock="Right" Content="Mở ứng dụng" Style="{StaticResource SecondaryButton}" Click="OpenMain_Click"/><TextBlock Text="Trò chuyện" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel><TextBlock Text="{Binding Status}" Foreground="#65756F" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel>
  <ListBox x:Name="MessagesList" Grid.Row="1" ItemsSource="{Binding Messages}" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate>
   <Border Style="{StaticResource TranscriptCard}" Margin="0,0,0,8"><StackPanel><TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="14"/><TextBlock Text="{Binding Translation}" TextWrapping="Wrap" Foreground="#287568" Margin="0,6,0,0"/></StackPanel></Border>
  </DataTemplate></ListBox.ItemTemplate></ListBox>
  <StackPanel Grid.Row="2" Margin="0,12,0,0"><TextBox Text="{Binding UserInput,UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" MaxHeight="90" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
   <WrapPanel Margin="0,8,0,0"><Button Content="{Binding MicrophoneLabel}" Command="{Binding ToggleMicrophoneCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/><Button Content="Gửi" Command="{Binding SendMessageCommand}" IsEnabled="{Binding CanSendMessage}" Margin="0,0,8,0"/><Button Content="{Binding ConversationActionLabel}" Command="{Binding ToggleConversationCommand}" Style="{StaticResource SecondaryButton}"/></WrapPanel>
  </StackPanel>
 </Grid>
</Window>
