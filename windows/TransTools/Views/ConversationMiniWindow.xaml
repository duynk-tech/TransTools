<Window x:Class="TransTools.Views.ConversationMiniWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:TransTools.Views" xmlns:experience="clr-namespace:TransTools.Services.Experience" Title="Trò chuyện · Trans Tools" Width="460" Height="500" MinWidth="360" MinHeight="320" Topmost="True" ShowInTaskbar="False" Background="#F5F8F7">
 <Window.Resources><DataTemplate x:Key="MiniConversationBubble">
  <Border Tag="ChatBubble" CornerRadius="14" Padding="11" MaxWidth="620" VerticalAlignment="Top">
   <Border.Style><Style TargetType="Border"><Setter Property="Margin" Value="0,0,36,10"/><Setter Property="Background" Value="#EBEFED"/><Setter Property="HorizontalAlignment" Value="Left"/><Style.Triggers><DataTrigger Binding="{Binding IsUser}" Value="True"><Setter Property="Background" Value="#DCEEE8"/><Setter Property="HorizontalAlignment" Value="Right"/><Setter Property="Margin" Value="36,0,0,10"/></DataTrigger></Style.Triggers></Style></Border.Style>
   <StackPanel>
    <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="#287568" Margin="0,0,0,6"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="{Binding DisplayName,Source={x:Static experience:AssistantIdentity.Shared}}"/><Style.Triggers><DataTrigger Binding="{Binding IsUser}" Value="True"><Setter Property="Text" Value="Bạn"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
    <TextBlock Text="{Binding Text}" FontSize="13" Foreground="#243D35" TextWrapping="Wrap" LineHeight="19"/>
    <StackPanel Margin="0,7,0,0"><StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers><DataTrigger Binding="{Binding Translation}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding DataContext.ShowVietnameseTranslation,RelativeSource={RelativeSource AncestorType=ListBox}}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding DataContext.CanShowTranslation,RelativeSource={RelativeSource AncestorType=ListBox}}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></StackPanel.Style><Border Height="1" Background="#CBDCD5" Margin="0,0,0,7"/><TextBlock Text="{Binding Translation}" FontSize="11" Foreground="#65756F" TextWrapping="Wrap" LineHeight="17"/></StackPanel>
   </StackPanel>
  </Border>
 </DataTemplate></Window.Resources><Grid Background="#ECF6F2"><Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,12"><Button DockPanel.Dock="Right" Width="32" Height="32" MinHeight="32" Padding="0" ToolTip="Mở đầy đủ" AutomationProperties.Name="Mở đầy đủ" Style="{StaticResource SecondaryButton}" Click="OpenMain_Click"><TextBlock Text="&#xE740;" FontFamily="Segoe MDL2 Assets"/></Button><Border Width="38" Height="38" CornerRadius="19" Background="#DCEEE8" DockPanel.Dock="Left" Margin="0,0,10,0"><Image Source="/TransTools;component/Resources/Mascot/MascotWalking.png" Width="28" Height="28"/></Border><StackPanel><TextBlock Text="{Binding DisplayName,Source={x:Static experience:AssistantIdentity.Shared}}" FontSize="14" FontWeight="SemiBold"/><TextBlock Text="{Binding Status}" Foreground="#65756F" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/></StackPanel></DockPanel>
  <ListBox x:Name="MessagesList" Grid.Row="1" ItemsSource="{Binding Messages}" ItemTemplate="{StaticResource MiniConversationBubble}" BorderThickness="0" Background="Transparent" Padding="0,8,0,0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.ScrollUnit="Pixel">
   <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Top"/></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
  </ListBox>
  <StackPanel Grid.Row="2" Margin="0,12,0,0"><TextBox Text="{Binding UserInput,UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding InputReadOnly}" TextWrapping="Wrap" MaxHeight="90" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
   <WrapPanel Margin="0,8,0,0"><Button Width="40" Padding="0" ToolTip="{Binding MicrophoneLabel}" AutomationProperties.Name="{Binding MicrophoneLabel}" Command="{Binding ToggleMicrophoneCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"><TextBlock Text="&#xE720;" FontFamily="Segoe MDL2 Assets" FontSize="17"/></Button><Button Content="Gửi" Command="{Binding SendMessageCommand}" IsEnabled="{Binding CanSendMessage}" Margin="0,0,8,0"/><Button Content="{Binding ConversationActionLabel}" Command="{Binding ToggleConversationCommand}" Style="{StaticResource SecondaryButton}"/></WrapPanel>
  </StackPanel>
 </Grid></Grid>
</Window>
