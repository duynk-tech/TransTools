<Window x:Class="TransTools.Views.ConversationMiniWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:TransTools.Views" Title="Trò chuyện · Trans Tools" Width="460" Height="500" MinWidth="360" MinHeight="320" Topmost="True" ShowInTaskbar="False" Background="#F5F8F7">
 <Grid><local:GardenBackground IsHitTestVisible="False"/><Border Background="#D9F5F8F7" IsHitTestVisible="False"/><Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,12"><DockPanel><Button DockPanel.Dock="Right" Content="Mở ứng dụng" Style="{StaticResource SecondaryButton}" Click="OpenMain_Click"/><TextBlock Text="Trò chuyện" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel><TextBlock Text="{Binding Status}" Foreground="#65756F" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel>
  <ListBox x:Name="MessagesList" Grid.Row="1" ItemsSource="{Binding Messages}" ItemTemplate="{StaticResource ConversationBubble}" BorderThickness="0" Background="Transparent" Padding="0,8,0,0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.ScrollUnit="Pixel">
   <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Top"/></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
  </ListBox>
  <StackPanel Grid.Row="2" Margin="0,12,0,0"><TextBox Text="{Binding UserInput,UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding InputReadOnly}" TextWrapping="Wrap" MaxHeight="90" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
   <WrapPanel Margin="0,8,0,0"><Button Width="40" Padding="0" ToolTip="{Binding MicrophoneLabel}" AutomationProperties.Name="{Binding MicrophoneLabel}" Command="{Binding ToggleMicrophoneCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"><TextBlock Text="&#xE720;" FontFamily="Segoe MDL2 Assets" FontSize="17"/></Button><Button Content="Gửi" Command="{Binding SendMessageCommand}" IsEnabled="{Binding CanSendMessage}" Margin="0,0,8,0"/><Button Content="{Binding ConversationActionLabel}" Command="{Binding ToggleConversationCommand}" Style="{StaticResource SecondaryButton}"/></WrapPanel>
  </StackPanel>
 </Grid></Grid>
</Window>
