<UserControl x:Class="TransTools.Views.MeetingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:TransTools.ViewModels">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Header & Audio Source Selection -->
        <Border Grid.Row="0" Background="#1E293B" CornerRadius="12" Padding="16" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Dịch cuộc họp thời gian thực" FontSize="18" FontWeight="Bold" Foreground="#F8FAFC"/>
                    <TextBlock Text="{Binding Status}" FontSize="12" Foreground="#94A3B8" Margin="0,4,0,0"/>

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <CheckBox Content="Bắt âm thanh máy tính (Loopback)" IsChecked="{Binding CaptureSystemAudio}" Foreground="#E2E8F0" Margin="0,0,16,0"/>
                        <CheckBox Content="Thu âm Micro" IsChecked="{Binding CaptureMicrophone}" Foreground="#E2E8F0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Start / Stop Button -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <Button Foreground="White" FontWeight="Bold"
                            FontSize="14" Padding="20,10" Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Content" Value="▶  Bắt đầu"/>
                                <Setter Property="Command" Value="{Binding StartRecordingCommand}"/>
                                <Setter Property="Background" Value="#2563EB"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRecording}" Value="True">
                                        <Setter Property="Content" Value="⏹  Dừng lại"/>
                                        <Setter Property="Background" Value="#DC2626"/>
                                        <Setter Property="Command" Value="{Binding StopRecordingCommand}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Live Caption Current Line -->
        <Border Grid.Row="1" Background="#1E293B" CornerRadius="10" Padding="16,12" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Đang nghe:" FontSize="11" FontWeight="Bold" Foreground="#64748B"/>
                <TextBlock Text="{Binding CurrentLiveOriginal}" FontSize="14" Foreground="#94A3B8" Margin="0,2,0,4"/>
                <TextBlock Text="{Binding CurrentLiveVietnamese}" FontSize="16" FontWeight="Bold" Foreground="#38BDF8"/>
            </StackPanel>
        </Border>

        <!-- Caption History List -->
        <Border Grid.Row="2" Background="#1E293B" CornerRadius="12" Padding="16">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                    <TextBlock Text="Biên bản phụ đề" FontSize="14" FontWeight="Bold" Foreground="#F8FAFC"/>
                    <Button Content="Xóa danh sách" Command="{Binding ClearCaptionsCommand}" HorizontalAlignment="Right" Background="Transparent" Foreground="#94A3B8" BorderThickness="0" Cursor="Hand"/>
                </Grid>

                <ListBox ItemsSource="{Binding Captions}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#0F172A" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="{Binding FormattedTimestamp}" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,2"/>
                                    <TextBlock Text="{Binding Original}" FontSize="13" Foreground="#E2E8F0" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Vietnamese}" FontSize="14" FontWeight="Medium" Foreground="#38BDF8" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
