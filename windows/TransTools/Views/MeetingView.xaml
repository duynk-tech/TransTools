<UserControl x:Class="TransTools.Views.MeetingView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:TransTools.Views">
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Background="White" BorderBrush="#C2DDD5" BorderThickness="1" CornerRadius="12" Padding="12">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0"><TextBlock MaxWidth="130" TextTrimming="CharacterEllipsis" Text="{Binding Status}" VerticalAlignment="Center" Foreground="#65756F" Margin="0,0,12,0"/>
    <Button FontWeight="SemiBold" IsEnabled="{Binding CanToggleRecording}"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Content" Value="▶ Bắt đầu"/><Setter Property="Command" Value="{Binding StartRecordingCommand}"/><Style.Triggers><DataTrigger Binding="{Binding IsPreparing}" Value="True"><Setter Property="Content" Value="Hủy chuẩn bị"/><Setter Property="Command" Value="{Binding CancelPreparationCommand}"/></DataTrigger><DataTrigger Binding="{Binding IsRecording}" Value="True"><Setter Property="Content" Value="Dừng cuộc họp"/><Setter Property="Background" Value="#FFF1F2"/><Setter Property="Foreground" Value="#DC2626"/><Setter Property="BorderBrush" Value="#FECDD3"/><Setter Property="Command" Value="{Binding StopRecordingCommand}"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
   </StackPanel>
   <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><StackPanel Orientation="Horizontal" VerticalAlignment="Center">
    <ComboBox IsEnabled="{Binding CanConfigureMeeting}" ItemsSource="{Binding CaptureSources}" SelectedItem="{Binding CaptureSource}" Width="190" Margin="0,0,8,0"/>
    <ComboBox IsEnabled="{Binding CanConfigureMeeting}" ItemsSource="{Binding Languages}" ItemTemplate="{StaticResource LanguageItem}" SelectedItem="{Binding SourceLanguage}" Width="125" Margin="0,0,8,0"/>
    <Button IsEnabled="{Binding CanConfigureMeeting}" Content="⇄" Command="{Binding SwapLanguagesCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>
    <ComboBox IsEnabled="{Binding CanConfigureMeeting}" ItemsSource="{Binding TargetLanguages}" ItemTemplate="{StaticResource LanguageItem}" SelectedItem="{Binding TargetLanguage}" Width="125" Margin="0,0,8,0"/>
    <ComboBox ItemsSource="{Binding DisplayModes}" SelectedItem="{Binding SelectedDisplayMode}" Width="125" ToolTip="Cách hiển thị phụ đề" Margin="0,0,8,0"/>
    <Button x:Name="EarphoneButton" Content="{Binding EarphoneLabel}" Style="{StaticResource SecondaryButton}" Click="ShowEarphones_Click" Margin="0,0,8,0"/>
    <Button x:Name="TranslationSettingsButton" Content="Công cụ dịch" Style="{StaticResource SecondaryButton}" Click="ShowTranslationSettings_Click"/>
   </StackPanel></ScrollViewer></Grid>
  </Border>
  <Popup x:Name="EarphonePopup" PlacementTarget="{Binding ElementName=EarphoneButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True"><Border Background="White" BorderBrush="#B5D2C9" BorderThickness="1" CornerRadius="12" Padding="16" Width="360"><StackPanel><TextBlock Text="Tai nghe &amp; Đọc tự động" FontWeight="SemiBold" Margin="0,0,0,12"/><CheckBox Content="Đọc câu mới trong cuộc họp" IsChecked="{Binding AutomaticReading}" Margin="0,0,0,12"/><DockPanel Margin="0,0,0,6"><Button DockPanel.Dock="Right" Content="Làm mới" Command="{Binding RefreshEarphonesCommand}" Style="{StaticResource SecondaryButton}" MinHeight="28" Padding="8,3" FontSize="12"/><TextBlock Text="Thiết bị nghe" Foreground="#65756F" VerticalAlignment="Center"/></DockPanel><ComboBox ItemsSource="{Binding PlaybackDevices}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedPlaybackDevice}"/><TextBlock Text="Nội dung đọc" Foreground="#65756F" Margin="0,12,0,6"/><ComboBox ItemsSource="{Binding ReadTargets}" SelectedItem="{Binding ReadTarget}"/><TextBlock Text="{Binding EarphoneStatus}" TextWrapping="Wrap" Foreground="#65756F" Margin="0,12,0,12"/><UniformGrid Columns="2"><Button Content="Giọng &amp; Tốc độ" Click="VoiceSettings_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/><Button Content="Dừng đọc" Command="{Binding StopEarphoneReadingCommand}" Style="{StaticResource SecondaryButton}"/></UniformGrid></StackPanel></Border></Popup>
  <Popup x:Name="TranslationSettingsPopup" PlacementTarget="{Binding ElementName=TranslationSettingsButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True"><Border Background="White" BorderBrush="#B5D2C9" BorderThickness="1" CornerRadius="12" Padding="16" Width="290"><StackPanel><TextBlock Text="Công cụ dịch cuộc họp" FontWeight="SemiBold" Margin="0,0,0,10"/><ComboBox ItemsSource="{Binding TranslationModes}" SelectedItem="{Binding TranslationMode}" IsEnabled="{Binding CanConfigureMeeting}"/><TextBlock Text="Chọn trước khi bắt đầu cuộc họp. AI dùng tài khoản đã cấu hình trong Cài đặt." Foreground="#65756F" TextWrapping="Wrap" Margin="0,10,0,0"/></StackPanel></Border></Popup>
  <Border Grid.Row="1" Background="#F9FCFA" BorderBrush="#D8E5E1" BorderThickness="1" CornerRadius="10" Padding="12,8" Margin="0,12,0,12"><TextBlock Foreground="#65756F" TextWrapping="Wrap"><Run Text="PHÍM NÓNG TIỆN ÍCH" FontWeight="SemiBold" Foreground="#287568"/><Run Text="    Ctrl + Alt + D" FontWeight="SemiBold"/><Run Text="  Dịch văn bản đã chọn     "/><Run Text="Ctrl + Alt + T" FontWeight="SemiBold"/><Run Text="  Mở dịch nhanh"/></TextBlock></Border>
  <Border Grid.Row="2" CornerRadius="16" BorderBrush="#C2DDD5" BorderThickness="1" ClipToBounds="True"><Grid>
   <Border Background="#40FFFFFF"/>
   <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Captions.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
    <Viewbox Width="68" Height="72" Margin="0,0,0,16"><Canvas Width="68" Height="72"><Path Stroke="#287568" StrokeThickness="5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M4,30 L4,42 M14,18 L14,54 M24,6 L24,66 M34,14 L34,58 M44,23 L44,46"/><Path Stroke="#287568" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent" Data="M52,35 Q52,30 57,30 Q62,30 62,35 L62,48 Q62,53 57,53 Q52,53 52,48 Z M48,46 L48,49 Q48,58 57,58 Q66,58 66,49 L66,46 M57,58 L57,66 M51,66 L63,66"/></Canvas></Viewbox>
    <TextBlock Text="Sẵn sàng nghe &amp; phiên dịch" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,6"/>
    <TextBlock Text="Chọn nguồn âm để bắt đầu" FontSize="14" Foreground="#65756F" HorizontalAlignment="Center"/>
   </StackPanel>
   <ListBox x:Name="CaptionList" ItemsSource="{Binding Captions}" Background="Transparent" BorderThickness="0" Margin="16" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
    <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
    <ListBox.Style><Style TargetType="ListBox"><Style.Triggers><DataTrigger Binding="{Binding Captions.Count}" Value="0"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></ListBox.Style>
    <ListBox.ItemTemplate><DataTemplate><Border Style="{StaticResource TranscriptCard}" Margin="0,0,0,10"><StackPanel><Border Background="#EDF1EF" CornerRadius="10" Padding="8,3" HorizontalAlignment="Left" Margin="0,0,0,10"><TextBlock Text="{Binding FormattedTimestamp}" Foreground="#73827C" FontFamily="Consolas" FontSize="11"/></Border><TextBlock TextWrapping="Wrap" FontSize="14"><TextBlock.Text><MultiBinding Converter="{StaticResource CaptionDisplayText}"><Binding Path="Original"/><Binding Path="Vietnamese"/><Binding Path="DataContext.DisplayModeKey" RelativeSource="{RelativeSource AncestorType=UserControl}"/></MultiBinding></TextBlock.Text><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding DataContext.DisplayModeKey,RelativeSource={RelativeSource AncestorType=UserControl}}" Value="translation"><Setter Property="Foreground" Value="#287568"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><TextBlock TextWrapping="Wrap" FontSize="14" Foreground="#287568" Margin="0,6,0,0"><TextBlock.Text><MultiBinding Converter="{StaticResource CaptionDisplayText}" ConverterParameter="secondary"><Binding Path="Original"/><Binding Path="Vietnamese"/><Binding Path="DataContext.DisplayModeKey" RelativeSource="{RelativeSource AncestorType=UserControl}"/></MultiBinding></TextBlock.Text><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding Text,RelativeSource={RelativeSource Self}}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel></Border></DataTemplate></ListBox.ItemTemplate>
   </ListBox>
  </Grid></Border>
  <Border Grid.Row="3" Background="#FCFEFD" CornerRadius="12" BorderBrush="#C2DDD5" BorderThickness="1" Padding="12,10" Margin="0,12,0,0">
   <DockPanel LastChildFill="True">
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,0,0,0">
     <Button x:Name="ClearMeetingButton" Content="Xóa bảng ghi" Command="{Binding ClearCaptionsCommand}" Style="{StaticResource DestructiveButton}" Margin="0,0,12,0"><Button.Visibility><Binding Path="CanClearMeeting" Converter="{StaticResource BoolVisibility}"/></Button.Visibility></Button>
     <Button x:Name="SaveMeetingButton" Command="{Binding SaveSessionCommand}" Style="{StaticResource SecondaryButton}" ToolTip="Lưu bản ghi hiện có; cuộc họp đang chạy vẫn tiếp tục" Margin="0,0,8,0"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8A4;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBlock Text="Lưu Sổ tay"/></StackPanel></Button>
     <Button x:Name="ExportWordButton" Content="Xuất Word" Command="{Binding ExportMeetingCommand}" CommandParameter="Word" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>
     <Button Content="Xuất TXT" Command="{Binding ExportMeetingCommand}" CommandParameter="TXT" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>
     <Button Content="Xuất SRT" Command="{Binding ExportMeetingCommand}" CommandParameter="SRT" Style="{StaticResource SecondaryButton}"/>
    </StackPanel>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Background="#E4ECE8" CornerRadius="10" Padding="6,3" Margin="0,0,6,0"><TextBlock Text="{Binding Captions.Count}" FontFamily="Consolas" FontSize="11" FontWeight="SemiBold"/></Border><TextBlock Text="{Binding FooterSummary}" FontSize="11" Foreground="#65756F" VerticalAlignment="Center"/></StackPanel>
   </DockPanel>
  </Border>
 </Grid>
</UserControl>
