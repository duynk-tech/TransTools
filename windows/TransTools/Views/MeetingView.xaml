<UserControl x:Class="TransTools.Views.MeetingView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:TransTools.Views">
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Background="White" BorderBrush="#C2DDD5" BorderThickness="1" CornerRadius="12" Padding="12">
   <DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,0,0,0"><TextBlock Text="{Binding Status}" VerticalAlignment="Center" Foreground="#65756F" Margin="0,0,12,0"/>
    <Button FontWeight="SemiBold" IsEnabled="{Binding CanToggleRecording}"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Content" Value="▶ Bắt đầu"/><Setter Property="Command" Value="{Binding StartRecordingCommand}"/><Style.Triggers><DataTrigger Binding="{Binding IsPreparing}" Value="True"><Setter Property="Content" Value="Hủy chuẩn bị"/><Setter Property="Command" Value="{Binding CancelPreparationCommand}"/></DataTrigger><DataTrigger Binding="{Binding IsRecording}" Value="True"><Setter Property="Content" Value="Dừng cuộc họp"/><Setter Property="Background" Value="#FFF1F2"/><Setter Property="Foreground" Value="#DC2626"/><Setter Property="BorderBrush" Value="#FECDD3"/><Setter Property="Command" Value="{Binding StopRecordingCommand}"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
   </StackPanel>
   <WrapPanel VerticalAlignment="Center" IsEnabled="{Binding CanConfigureMeeting}">
    <ComboBox ItemsSource="{Binding CaptureSources}" SelectedItem="{Binding CaptureSource}" Width="175" Margin="0,0,8,0"/>
    <ComboBox ItemsSource="{Binding Languages}" ItemTemplate="{StaticResource LanguageItem}" SelectedItem="{Binding SourceLanguage}" Width="110" Margin="0,0,8,0"/>
    <Button Content="⇄" Command="{Binding SwapLanguagesCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>
    <ComboBox ItemsSource="{Binding TargetLanguages}" ItemTemplate="{StaticResource LanguageItem}" SelectedItem="{Binding TargetLanguage}" Width="110" Margin="0,0,8,0"/>
    <ComboBox ItemsSource="{Binding TranslationModes}" SelectedItem="{Binding TranslationMode}" Width="120"/>
   </WrapPanel></DockPanel>
  </Border>
  <Border Grid.Row="1" Background="#F9FCFA" BorderBrush="#D8E5E1" BorderThickness="1" CornerRadius="10" Padding="12,8" Margin="0,12,0,12"><TextBlock Text="Ctrl + Alt + D · Dịch văn bản đã chọn       Ctrl + Alt + T · Mở dịch nhanh" Foreground="#65756F" TextWrapping="Wrap"/></Border>
  <Border Grid.Row="2" CornerRadius="16" BorderBrush="#C2DDD5" BorderThickness="1" ClipToBounds="True"><Grid>
   <local:GardenBackground/>
   <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Captions.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
    <Image Source="/TransTools;component/Resources/Mascot/MascotSprites/angles/angle_front.png" Width="110" Height="130" Stretch="Uniform"/>
    <TextBlock Text="Sẵn sàng nghe &amp; phiên dịch" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,6"/>
    <TextBlock Text="Chọn nguồn âm để bắt đầu" FontSize="14" Foreground="#65756F" HorizontalAlignment="Center"/>
   </StackPanel>
   <ListBox x:Name="CaptionList" ItemsSource="{Binding Captions}" Background="Transparent" BorderThickness="0" Margin="16" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
    <ListBox.Style><Style TargetType="ListBox"><Style.Triggers><DataTrigger Binding="{Binding Captions.Count}" Value="0"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></ListBox.Style>
    <ListBox.ItemTemplate><DataTemplate><Border Style="{StaticResource TranscriptCard}" Margin="0,0,0,10"><StackPanel><TextBlock Text="{Binding FormattedTimestamp}" Foreground="#73827C" FontSize="11" Margin="0,0,0,6"/><TextBlock Text="{Binding Original}" TextWrapping="Wrap" FontSize="14"/><TextBlock Text="{Binding Vietnamese}" TextWrapping="Wrap" FontSize="14" Foreground="#287568" Margin="0,6,0,0"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate>
   </ListBox>
  </Grid></Border>
  <DockPanel Grid.Row="3" Margin="0,12,0,0"><TextBlock Text="{Binding Captions.Count,StringFormat={}{0} đoạn phụ đề}" VerticalAlignment="Center" Foreground="#65756F"/>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Lưu Sổ tay" Command="{Binding SaveSessionCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/><Button Content="Xóa nội dung" Command="{Binding ClearCaptionsCommand}" Style="{StaticResource DestructiveButton}"/></StackPanel>
  </DockPanel>
 </Grid>
</UserControl>
