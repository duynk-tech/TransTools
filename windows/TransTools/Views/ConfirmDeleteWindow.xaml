<Window x:Class="TransTools.Views.ConfirmDeleteWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Xóa bản ghi" Width="480" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Background="#F2FAF7" ShowInTaskbar="False"><StackPanel Margin="24"><TextBlock x:Name="Question" Text="Xóa bản ghi này?" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12"/><TextBlock x:Name="RecordName" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,12"/><TextBlock x:Name="Detail" Text="Bản ghi và ghi chú của mục này sẽ bị xóa. Các bản ghi khác được giữ nguyên." TextWrapping="Wrap" Foreground="#65756F"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0"><Button Content="Hủy" IsCancel="True" Click="Cancel_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/><Button x:Name="ConfirmButton" Content="Xóa bản ghi" Click="Confirm_Click" Style="{StaticResource DestructiveButton}"/></StackPanel></StackPanel></Window>