<Window x:Class="TransTools.Views.ChipChipMascotWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:experience="clr-namespace:TransTools.Services.Experience" Title="Chip Chip" Height="220" Width="200" WindowStyle="None" AllowsTransparency="True" Background="Transparent" Topmost="True" ShowInTaskbar="False">
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
 <Border x:Name="SpeechBubble" Background="White" CornerRadius="16" BorderBrush="#79B8AA" BorderThickness="2" Padding="10" Visibility="Collapsed"><TextBlock x:Name="BubbleText" Text="Cùng học nhé!" TextWrapping="Wrap" FontSize="14" Foreground="#26776B"/></Border>
 <Image x:Name="MascotImage" Grid.Row="1" Source="/TransTools;component/Resources/Mascot/MascotSprites/angles/angle_front.png" Stretch="Uniform" Cursor="Hand" RenderTransformOrigin="0.5,0.7" MouseEnter="MascotEnter" MouseLeave="MascotLeave" MouseLeftButtonDown="MascotDown" MouseRightButtonUp="ShowMenu" ToolTip="Kéo để di chuyển · Nhấp đúp để học cùng trợ lý"><Image.RenderTransform><RotateTransform x:Name="MascotRotation"/></Image.RenderTransform></Image>

 <Popup x:Name="MascotMenu" PlacementTarget="{Binding ElementName=MascotImage}" Placement="Left" StaysOpen="False" AllowsTransparency="True" PopupAnimation="None">
  <Border Width="340" Background="#F2FAF7" BorderBrush="#A8CEC3" BorderThickness="1" CornerRadius="16" Padding="18" Margin="0,0,10,0">
   <StackPanel>
    <DockPanel Margin="0,0,0,16"><Button DockPanel.Dock="Right" Click="CloseMenu" Width="30" Height="30" MinHeight="30" VerticalAlignment="Center" Padding="0" Style="{StaticResource SecondaryButton}" AutomationProperties.Name="Đóng"><TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets"/></Button><Image DockPanel.Dock="Left" Source="/TransTools;component/Resources/AppIcon.png" Width="42" Height="42" Margin="0,0,10,0"/><TextBlock Text="{Binding DisplayName,Source={x:Static experience:AssistantIdentity.Shared}}" TextTrimming="CharacterEllipsis" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
    <TextBlock x:Name="MeetingStateLabel" Text="Hỗ trợ cuộc họp và học ngôn ngữ" Foreground="#65756F" TextWrapping="Wrap" Margin="0,0,0,16"/>
    <Border x:Name="QuickTranslationPanel" Visibility="Collapsed" Background="White" BorderBrush="#BDD9D2" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,0,16">
     <Border.InputBindings><KeyBinding Key="Enter" Modifiers="Control" Command="{Binding TranslateCommand}"/></Border.InputBindings>
     <StackPanel><DockPanel><Border DockPanel.Dock="Right" Background="#E1EEE6" CornerRadius="6" Padding="6,3"><TextBlock FontSize="11" Foreground="#287568"><Run Text="{Binding SourceLanguage,Mode=OneWay,Converter={StaticResource LanguageLabel},ConverterParameter=short}"/><Run Text=" → "/><Run Text="{Binding TargetLanguage,Mode=OneWay,Converter={StaticResource LanguageLabel},ConverterParameter=short}"/></TextBlock></Border><TextBlock Text="Dịch nhanh" FontWeight="SemiBold" Foreground="#287568" VerticalAlignment="Center"/></DockPanel><TextBlock Text="{Binding SelectedDomain}" Foreground="#65756F" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,8"/>
      <TextBox x:Name="MascotQuickInput" Text="{Binding SourceText,UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanConfigure}" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" Height="68" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Văn bản cần dịch"/>
      <DockPanel Margin="0,8,0,8"><Button DockPanel.Dock="Right" Command="{Binding TranslateCancelCommand}" Content="Hủy" MinHeight="30" Padding="8,4" Margin="6,0,0,0" Style="{StaticResource SecondaryButton}" Visibility="{Binding TranslateCommand.IsRunning,Converter={StaticResource BoolVisibility}}"/><Button DockPanel.Dock="Right" Command="{Binding TranslateCommand}" MinHeight="30" Padding="10,4" Content="Dịch"/><TextBlock Text="{Binding Status}" TextWrapping="Wrap" Foreground="#65756F" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/></DockPanel>
      <TextBox x:Name="MascotQuickResult" Text="{Binding TranslatedText,Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" VerticalContentAlignment="Top" MinHeight="40" MaxHeight="90" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Kết quả dịch"/>
      <Button Content="Sao chép" Click="CopyQuickTranslation" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right" MinHeight="26" Padding="8,4" Margin="0,8,0,0"/>
     </StackPanel>
    </Border>
    <Button x:Name="MeetingActionButton" Click="StartMeeting_Click" Style="{StaticResource SecondaryButton}" HorizontalContentAlignment="Left" Margin="0,0,0,10" AutomationProperties.Name="Bắt đầu cuộc họp"><StackPanel Orientation="Horizontal"><TextBlock x:Name="MeetingActionIcon" Text="&#xE768;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,10,0"/><TextBlock x:Name="MeetingActionLabel" Text="Bắt đầu cuộc họp"/></StackPanel></Button>
    <Button Click="OpenSubtitle_Click" Style="{StaticResource SecondaryButton}" HorizontalContentAlignment="Left" Margin="0,0,0,10" AutomationProperties.Name="Mở phụ đề nổi"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8F2;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,10,0"/><TextBlock Text="Mở phụ đề nổi"/></StackPanel></Button>
    <Button Click="OpenApplication_Click" Style="{StaticResource SecondaryButton}" HorizontalContentAlignment="Left" Margin="0,0,0,10" AutomationProperties.Name="Mở ứng dụng"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE737;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,10,0"/><TextBlock Text="Mở ứng dụng"/></StackPanel></Button>
    <Button Click="StartLearning_Click" Style="{StaticResource SecondaryButton}" HorizontalContentAlignment="Left" Margin="0,0,0,10" AutomationProperties.Name="Học cùng trợ lý"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8F1;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,10,0"/><TextBlock Text="Học cùng trợ lý"/></StackPanel></Button>
    <TextBlock Text="Trans Tools" Foreground="#73827C" FontSize="11" HorizontalAlignment="Right" Margin="0,4,0,0"/>
   </StackPanel>
  </Border>
 </Popup>
 </Grid>
</Window>
