<Window x:Class="TransTools.Views.ChipChipMascotWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:experience="clr-namespace:TransTools.Services.Experience" Title="Chip Chip" Height="220" Width="200" WindowStyle="None" AllowsTransparency="True" Background="Transparent" Topmost="True" ShowInTaskbar="False">
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
 <Border x:Name="SpeechBubble" Background="White" CornerRadius="16" BorderBrush="#79B8AA" BorderThickness="2" Padding="10" Visibility="Collapsed"><TextBlock x:Name="BubbleText" Text="Cùng học nhé!" TextWrapping="Wrap" FontSize="14" Foreground="#26776B"/></Border>
 <Image x:Name="MascotImage" Grid.Row="1" Source="/TransTools;component/Resources/Mascot/MascotSprites/angles/angle_front.png" Stretch="Uniform" Cursor="Hand" RenderTransformOrigin="0.5,0.7" MouseEnter="MascotEnter" MouseLeave="MascotLeave" MouseLeftButtonDown="MascotDown" MouseRightButtonUp="ShowMenu" ToolTip="Kéo để di chuyển · Nhấp đúp để học cùng trợ lý"><Image.RenderTransform><RotateTransform x:Name="MascotRotation"/></Image.RenderTransform></Image>

 <Popup x:Name="MascotMenu" PlacementTarget="{Binding ElementName=MascotImage}" Placement="Left" StaysOpen="False" AllowsTransparency="True" PopupAnimation="None">
  <Border Width="340" Background="#F2FAF7" BorderBrush="#A8CEC3" BorderThickness="1" CornerRadius="16" Padding="18" Margin="0,0,10,0">
   <StackPanel>
    <DockPanel Margin="0,0,0,16"><Button DockPanel.Dock="Right" Click="CloseMenu" Width="30" MinHeight="30" Padding="0" Style="{StaticResource SecondaryButton}" AutomationProperties.Name="Đóng"><TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets"/></Button><Image DockPanel.Dock="Left" Source="/TransTools;component/Resources/AppIcon.png" Width="42" Height="42" Margin="0,0,10,0"/><TextBlock Text="{Binding DisplayName,Source={x:Static experience:AssistantIdentity.Shared}}" TextTrimming="CharacterEllipsis" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
    <TextBlock Text="Hỗ trợ cuộc họp và học ngôn ngữ" Foreground="#65756F" TextWrapping="Wrap" Margin="0,0,0,16"/>
    <Button Click="StartMeeting_Click" Style="{StaticResource SecondaryButton}" HorizontalContentAlignment="Left" Margin="0,0,0,10" AutomationProperties.Name="Bắt đầu cuộc họp"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,10,0"/><TextBlock Text="Bắt đầu cuộc họp"/></StackPanel></Button>
    <Button Click="OpenSubtitle_Click" Style="{StaticResource SecondaryButton}" HorizontalContentAlignment="Left" Margin="0,0,0,10" AutomationProperties.Name="Mở phụ đề nổi"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8F2;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,10,0"/><TextBlock Text="Mở phụ đề nổi"/></StackPanel></Button>
    <Button Click="OpenApplication_Click" Style="{StaticResource SecondaryButton}" HorizontalContentAlignment="Left" Margin="0,0,0,10" AutomationProperties.Name="Mở ứng dụng"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE737;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,10,0"/><TextBlock Text="Mở ứng dụng"/></StackPanel></Button>
    <Button Click="StartLearning_Click" Style="{StaticResource SecondaryButton}" HorizontalContentAlignment="Left" Margin="0,0,0,10" AutomationProperties.Name="Học cùng trợ lý"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8F1;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,10,0"/><TextBlock Text="Học cùng trợ lý"/></StackPanel></Button>
    <TextBlock Text="Trans Tools" Foreground="#73827C" FontSize="11" HorizontalAlignment="Right" Margin="0,4,0,0"/>
   </StackPanel>
  </Border>
 </Popup>
 </Grid>
</Window>
