<Window x:Class="TransTools.Views.ChipChipMascotWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chip Chip Mascot"
        Height="130" Width="130"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Grid>
        <!-- Speech Bubble (Visible on hover/speech) -->
        <Border x:Name="SpeechBubble"
                Background="#EEFFFFFF"
                CornerRadius="8"
                BorderBrush="#22000000"
                BorderThickness="1"
                Padding="6,3"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,0,0,0">
            <TextBlock Text="Chào bạn! 🐣" FontSize="11" FontWeight="Medium" Foreground="#1F2937"/>
        </Border>

        <!-- Mascot Character Body -->
        <Border Width="80" Height="80"
                CornerRadius="40"
                Background="#FEF08A"
                BorderBrush="#F59E0B"
                BorderThickness="3"
                VerticalAlignment="Bottom"
                HorizontalAlignment="Center"
                Cursor="Hand"
                ToolTip="Kéo để di chuyển • Nhấp đúp để mở bảng học">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" ShadowDepth="4" Direction="270" Opacity="0.3" Color="#000000"/>
            </Border.Effect>

            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="🐣" FontSize="44" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
