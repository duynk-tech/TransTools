<Window x:Class="TransTools.Views.LearningBoardWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Cùng Chip Chip" Width="980" Height="720" MinWidth="760" MinHeight="540" WindowStyle="None" ResizeMode="CanResizeWithGrip" Background="#F4FAF8" WindowStartupLocation="CenterScreen">
 <Border BorderBrush="#79B8AA" BorderThickness="8" CornerRadius="20" Padding="20">
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <Grid MouseLeftButtonDown="DragHeader" Background="Transparent" Margin="0,0,0,16"><TextBlock Text="Cùng Chip Chip" FontSize="24" FontWeight="Bold" Foreground="#26776B"/><TextBlock x:Name="ProgressLabel" HorizontalAlignment="Center" Foreground="#26776B"/><Button Content="Kết thúc" HorizontalAlignment="Right" Click="CloseBoard"/></Grid>
 <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions>
 <Grid><Grid.Background><DrawingBrush TileMode="Tile" Viewport="0,0,32,32" ViewportUnits="Absolute"><DrawingBrush.Drawing><GeometryDrawing Brush="White"><GeometryDrawing.Pen><Pen Brush="#E3EFEB" Thickness="1"/></GeometryDrawing.Pen><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,32,32"/></GeometryDrawing.Geometry></GeometryDrawing></DrawingBrush.Drawing></DrawingBrush></Grid.Background>
 <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="130"/></Grid.RowDefinitions>
 <Grid><TextBlock x:Name="CharacterLabel" FontSize="120" Foreground="#26776B" Opacity="0.3" VerticalAlignment="Center" HorizontalAlignment="Center"/><InkCanvas x:Name="WritingCanvas" Background="Transparent"/></Grid>
 <TextBlock Grid.Row="1" x:Name="TranscriptionLabel" HorizontalAlignment="Center" FontSize="24" Foreground="#26776B" Margin="0,10"/>
 <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="16"><TextBlock x:Name="TipLabel" TextWrapping="Wrap" Foreground="#243D37" FontSize="17"/></ScrollViewer>
 </Grid>
 <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12"><Image Source="/Resources/Mascot/MascotSprites/angles/angle_front.png" Height="170" Stretch="Uniform"/><TextBlock Text="Nghe · Nhắc lại · Viết" TextWrapping="Wrap" TextAlignment="Center" Foreground="#26776B" FontSize="18" Margin="0,16"/><Button Content="Viết lại" Click="ClearWriting"/></StackPanel></Grid>
 <DockPanel Grid.Row="2" Margin="0,18,0,0"><TextBlock Text="{Binding Status}" Foreground="#26776B" DockPanel.Dock="Right" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="330"/><StackPanel Orientation="Horizontal"><Button x:Name="PreviousButton" Content="←" Click="Previous" Margin="0,0,8,0"/><Button Content="Nghe mẫu" Click="Read" Margin="0,0,8,0"/><Button Content="Dừng" Command="{Binding StopPronunciationCommand}" Margin="0,0,8,0"/><Button x:Name="NextButton" Content="→" Click="Next"/></StackPanel></DockPanel>
 </Grid></Border>
</Window>
