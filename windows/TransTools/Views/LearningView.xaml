<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="TransTools.Views.LearningView">

    <UserControl.Resources><Style x:Key="LearningTab" TargetType="RadioButton"><Setter Property="Cursor" Value="Hand" /><Setter Property="Foreground" Value="#65756F" /><Setter Property="FontWeight" Value="Medium" /><Setter Property="FontSize" Value="13" /><Setter Property="MinHeight" Value="36" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Border x:Name="Chrome" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="9" Padding="14,8"><ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" /></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#E5ECE8" /><Setter Property="Foreground" Value="#292F2D" /><Setter Property="FontWeight" Value="Bold" /></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#75BBAE" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></UserControl.Resources><Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#E8FFFFFF" BorderBrush="#BDD9D2" BorderThickness="0,0,0,1" CornerRadius="0" Padding="18,10" Margin="-18,-18,-18,16">
            <StackPanel>
                <DockPanel LastChildFill="True"><Border DockPanel.Dock="Right" Background="#E1EEE8" CornerRadius="14" Padding="9,5" Margin="12,0,0,0" VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE823;" FontFamily="Segoe MDL2 Assets" Foreground="#287568" VerticalAlignment="Center" Margin="0,0,5,0"/><TextBlock Text="{Binding DailyMinutes,StringFormat={}{0} phút/ngày}" FontSize="12" Foreground="#65756F"/></StackPanel></Border><Button x:Name="LearningGoalButton" DockPanel.Dock="Right" Content="Thêm ▾" Style="{StaticResource SecondaryButton}" Click="ShowMore_Click" Margin="12,0,0,0"><Button.ContextMenu><ContextMenu x:Name="LearningMoreMenu"><MenuItem Header="Tiến bộ" Click="Progress_Click"/><MenuItem Header="Mục tiêu" Click="ShowGoal_Click"/></ContextMenu></Button.ContextMenu></Button><ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><StackPanel Orientation="Horizontal">
                    <ComboBox SelectedValuePath="Tag" SelectedValue="{Binding SelectedLanguage}" Width="160" Height="40" MinHeight="40" Margin="0,0,12,0" SelectionChanged="Language_SelectionChanged">
                        <ComboBoxItem Content="Tiếng Anh" Tag="en"  ContentTemplate="{StaticResource LanguageItem}"/><ComboBoxItem Content="Tiếng Nhật" Tag="ja"  ContentTemplate="{StaticResource LanguageItem}"/><ComboBoxItem Content="Tiếng Trung" Tag="zh"  ContentTemplate="{StaticResource LanguageItem}"/><ComboBoxItem Content="Tiếng Hàn" Tag="ko"  ContentTemplate="{StaticResource LanguageItem}"/>
                    </ComboBox>
                    <RadioButton x:Name="TodayTab" Style="{StaticResource LearningTab}" IsChecked="True" Margin="4,0" Checked="TodayTab_Checked" GroupName="LearningSections"  AutomationProperties.Name="Hôm nay"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE706;" FontFamily="Segoe MDL2 Assets" Margin="0,0,7,0" VerticalAlignment="Center"/><TextBlock Text="Hôm nay" VerticalAlignment="Center"/></StackPanel></RadioButton>
                    <RadioButton x:Name="AlphabetTab" Style="{StaticResource LearningTab}" Margin="4,0" Checked="AlphabetTab_Checked" GroupName="LearningSections"  AutomationProperties.Name="Chữ &amp; Viết"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8D2;" FontFamily="Segoe MDL2 Assets" Margin="0,0,7,0" VerticalAlignment="Center"/><TextBlock Text="Chữ &amp; Viết" VerticalAlignment="Center"/></StackPanel></RadioButton>
                <RadioButton x:Name="VocabularyTab" Style="{StaticResource LearningTab}" Margin="4,0" Checked="VocabTab_Checked" GroupName="LearningSections"  AutomationProperties.Name="Từ vựng của tôi"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE82D;" FontFamily="Segoe MDL2 Assets" Margin="0,0,7,0" VerticalAlignment="Center"/><TextBlock Text="Từ vựng của tôi" VerticalAlignment="Center"/><Border Background="#E1EEE6" CornerRadius="10" Padding="5,2" Margin="7,0,0,0" VerticalAlignment="Center"><TextBlock Text="{Binding VocabularyCount,Mode=OneWay}" FontSize="11" Foreground="#287568"/></Border></StackPanel></RadioButton>
                    <RadioButton x:Name="PracticeTab" Style="{StaticResource LearningTab}" Margin="4,0" Checked="PracticeTab_Checked" GroupName="LearningSections"  AutomationProperties.Name="Luyện giao tiếp"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8F2;" FontFamily="Segoe MDL2 Assets" Margin="0,0,7,0" VerticalAlignment="Center"/><TextBlock Text="Luyện giao tiếp" VerticalAlignment="Center"/></StackPanel></RadioButton>
                    </StackPanel></ScrollViewer>
                </DockPanel>
                <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Foreground="#287568" Margin="0,8,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding Status}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
            </StackPanel>
        </Border>

        <ScrollViewer x:Name="ProgressPanel" Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
            <StackPanel>
                <TextBlock Text="Tiến bộ học tập" FontSize="20" FontWeight="SemiBold" Foreground="#243D35" Margin="0,0,0,16"/>
                <UniformGrid Columns="4" Margin="0,0,0,16"><Border Background="White" BorderBrush="#BDD9D2" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,8,0"><StackPanel><TextBlock Text="&#xE8F1;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#243D35" HorizontalAlignment="Center" Margin="0,0,0,8"/><TextBlock Text="{Binding VocabularyCount}" FontSize="26" FontWeight="SemiBold" Foreground="#287568" HorizontalAlignment="Center"/><TextBlock Text="Tổng từ vựng" Foreground="#65756F" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,0"/></StackPanel></Border><Border Background="White" BorderBrush="#BDD9D2" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,8,0"><StackPanel><TextBlock Text="&#xE823;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#D89035" HorizontalAlignment="Center" Margin="0,0,0,8"/><TextBlock Text="{Binding DueCount}" FontSize="26" FontWeight="SemiBold" Foreground="#287568" HorizontalAlignment="Center"/><TextBlock Text="Cần ôn hôm nay" Foreground="#65756F" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,0"/></StackPanel></Border><Border Background="White" BorderBrush="#BDD9D2" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,8,0"><StackPanel><TextBlock Text="&#xE916;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#4A86A0" HorizontalAlignment="Center" Margin="0,0,0,8"/><TextBlock Text="{Binding LearningCount}" FontSize="26" FontWeight="SemiBold" Foreground="#287568" HorizontalAlignment="Center"/><TextBlock Text="Đang củng cố" Foreground="#65756F" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,0"/></StackPanel></Border><Border Background="White" BorderBrush="#BDD9D2" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,8,0"><StackPanel><TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#438565" HorizontalAlignment="Center" Margin="0,0,0,8"/><TextBlock Text="{Binding MasteredCount}" FontSize="26" FontWeight="SemiBold" Foreground="#287568" HorizontalAlignment="Center"/><TextBlock Text="Đã nhớ vững" Foreground="#65756F" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,0"/></StackPanel></Border></UniformGrid><Border Background="White" BorderBrush="#BDD9D2" BorderThickness="1" CornerRadius="14" Padding="20"><StackPanel><TextBlock Text="Phân bổ trạng thái ghi nhớ" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,16"/><StackPanel><DockPanel Margin="0,8"><TextBlock DockPanel.Dock="Right" Foreground="#287568" FontWeight="SemiBold" Margin="16,0,0,0"><Run Text="{Binding DeepMemoryCount,Mode=OneWay,StringFormat='{}{0} từ'}"/><Run Text=" · "/><Run Text="{Binding DeepMemoryPercent,Mode=OneWay,StringFormat='{}{0:0}%'}"/></TextBlock><TextBlock Text="Từ đã nhớ sâu · Khoảng ôn từ 14 ngày" TextWrapping="Wrap" Foreground="#65756F"/></DockPanel><ProgressBar Value="{Binding DeepMemoryPercent,Mode=OneWay}" Minimum="0" Maximum="100" Height="6" Foreground="#438565" Background="#E5ECE8" Margin="0,0,0,8"><ProgressBar.Template><ControlTemplate TargetType="ProgressBar"><Grid x:Name="PART_Track"><Border Background="{TemplateBinding Background}" CornerRadius="3"/><Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" CornerRadius="3"/></Grid></ControlTemplate></ProgressBar.Template></ProgressBar></StackPanel><StackPanel><DockPanel Margin="0,8"><TextBlock DockPanel.Dock="Right" Foreground="#287568" FontWeight="SemiBold" Margin="16,0,0,0"><Run Text="{Binding ConsolidatingCount,Mode=OneWay,StringFormat='{}{0} từ'}"/><Run Text=" · "/><Run Text="{Binding ConsolidatingPercent,Mode=OneWay,StringFormat='{}{0:0}%'}"/></TextBlock><TextBlock Text="Từ đang củng cố · Khoảng ôn 3–13 ngày" TextWrapping="Wrap" Foreground="#65756F"/></DockPanel><ProgressBar Value="{Binding ConsolidatingPercent,Mode=OneWay}" Minimum="0" Maximum="100" Height="6" Foreground="#4A86A0" Background="#E5ECE8" Margin="0,0,0,8"><ProgressBar.Template><ControlTemplate TargetType="ProgressBar"><Grid x:Name="PART_Track"><Border Background="{TemplateBinding Background}" CornerRadius="3"/><Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" CornerRadius="3"/></Grid></ControlTemplate></ProgressBar.Template></ProgressBar></StackPanel><StackPanel><DockPanel Margin="0,8"><TextBlock DockPanel.Dock="Right" Foreground="#287568" FontWeight="SemiBold" Margin="16,0,0,0"><Run Text="{Binding NewMemoryCount,Mode=OneWay,StringFormat='{}{0} từ'}"/><Run Text=" · "/><Run Text="{Binding NewMemoryPercent,Mode=OneWay,StringFormat='{}{0:0}%'}"/></TextBlock><TextBlock Text="Từ mới · Khoảng ôn 1–2 ngày" TextWrapping="Wrap" Foreground="#65756F"/></DockPanel><ProgressBar Value="{Binding NewMemoryPercent,Mode=OneWay}" Minimum="0" Maximum="100" Height="6" Foreground="#D89035" Background="#E5ECE8" Margin="0,0,0,8"><ProgressBar.Template><ControlTemplate TargetType="ProgressBar"><Grid x:Name="PART_Track"><Border Background="{TemplateBinding Background}" CornerRadius="3"/><Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" CornerRadius="3"/></Grid></ControlTemplate></ProgressBar.Template></ProgressBar></StackPanel></StackPanel></Border><Border Background="#E7F3EE" BorderBrush="#BDD9D2" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,16,0,0"><TextBlock Text="Hãy thử nhớ nghĩa trước khi lật thẻ. Ôn đều mỗi ngày và chọn đúng mức ghi nhớ để lịch ôn phù hợp hơn." TextWrapping="Wrap" Foreground="#287568"/></Border></StackPanel>
        </ScrollViewer>
        <ScrollViewer x:Name="TodayPanel" Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Background="#E8FFFFFF" BorderBrush="#BDD9D2" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,16"><WrapPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding DailyStreak, StringFormat='Chuỗi học: {0} ngày'}" Foreground="#65756F" Margin="0,8,18,0" />
                    <TextBlock Text="{Binding WordsLearnedToday, StringFormat='Đã ôn hôm nay: {0}'}" Foreground="#287568" Margin="0,8,18,0" />
                    <TextBlock Text="{Binding DueCount, StringFormat='Đến hạn: {0} từ'}" Foreground="#65756F" Margin="0,8,18,0" />
                    </WrapPanel></Border>
                <Border Background="White" BorderBrush="#D8E5E1" BorderThickness="1" CornerRadius="16" Padding="24" Margin="0,0,0,16"><StackPanel>
                    <TextBlock Text="Vòng học hằng ngày" FontSize="18" FontWeight="Bold" Foreground="#243D35" />
                    <TextBlock Text="Ôn từ đến hạn, nghe câu mẫu và thực hành một tình huống." Foreground="#65756F" TextWrapping="Wrap" Margin="0,10" />
                    <WrapPanel><Button Content="Bắt đầu ôn tập" Click="StartReview_Click" Margin="0,0,8,0" /><Button Content="Thêm từ khởi đầu" Command="{Binding AddStarterWordsCommand}" Style="{StaticResource SecondaryButton}" /></WrapPanel>
                </StackPanel></Border>
                <Border Style="{StaticResource TranscriptCard}" Padding="24" Margin="0,0,0,16"><StackPanel>
                  <DockPanel><Button DockPanel.Dock="Right" Content="Tạo bài theo mục tiêu" Command="{Binding GenerateLessonsCommand}" Style="{StaticResource SecondaryButton}" Margin="12,0,0,0"/><TextBlock Text="Bài học theo tiến bộ của bạn" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel><TextBlock Text="{Binding LearningGoal}" Foreground="#287568" Margin="0,8"/><TextBlock Text="Không gửi bản thu hay nội dung Sổ tay khi tạo bài. AI chỉ nhận ngôn ngữ, trình độ và mục tiêu." TextWrapping="Wrap" Foreground="#65756F" FontSize="11"/><TextBlock Text="{Binding LessonGenerationStatus}" TextWrapping="Wrap" Foreground="#65756F" Margin="0,8"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding LessonGenerationStatus}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><Button Content="Hủy tạo bài" Command="{Binding GenerateLessonsCancelCommand}" Visibility="{Binding IsGeneratingLessons,Converter={StaticResource BoolVisibility}}" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left"/>
                  <TextBlock Text="{Binding LessonSourceText}" Foreground="#65756F" TextWrapping="Wrap" Margin="0,8,0,16"/>
                  <TextBlock Text="{Binding LessonStage}" Foreground="#287568" FontWeight="SemiBold"/>
                  <TextBlock Text="{Binding CurrentLesson.Original}" FontSize="18" TextWrapping="Wrap" Margin="0,12" Visibility="{Binding ShowLessonText,Converter={StaticResource BoolVisibility}}"/>
                  <Button Content="Nghe câu" Command="{Binding SpeakLessonCommand}" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,8,0,12"/>
                  <ItemsControl ItemsSource="{Binding LessonChoices}" IsEnabled="{Binding CanAnswerLesson}" Visibility="{Binding ShowLessonChoices,Converter={StaticResource BoolVisibility}}"><ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding}" Command="{Binding DataContext.AnswerLessonCommand,RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Style="{StaticResource SecondaryButton}" HorizontalContentAlignment="Left" Margin="0,0,0,8"><Button.ContentTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap"/></DataTemplate></Button.ContentTemplate></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                  <StackPanel Visibility="{Binding ShowLessonWriting,Converter={StaticResource BoolVisibility}}"><TextBox Text="{Binding LessonAnswer,UpdateSourceTrigger=PropertyChanged}" ToolTip="Viết lại câu đã nghe"/><Button Content="Kiểm tra câu mẫu" Command="{Binding CheckWrittenLessonCommand}" IsEnabled="{Binding CanAnswerLesson}" HorizontalAlignment="Left" Margin="0,8"/><TextBlock Text="Bài này kiểm tra khả năng nhớ câu mẫu, không chấm mọi cách diễn đạt đúng khác." Foreground="#65756F" TextWrapping="Wrap"/></StackPanel>
                  <Button Content="Xem gợi ý" Command="{Binding RevealLessonCommand}" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,8"/>
                  <StackPanel Visibility="{Binding HasLessonFeedback,Converter={StaticResource BoolVisibility}}"><TextBlock Text="{Binding LessonFeedback}" Foreground="#287568" FontWeight="SemiBold"/><TextBlock Text="{Binding CurrentLesson.Meaning}" TextWrapping="Wrap" Margin="0,8"/><TextBlock Text="{Binding CurrentLesson.Context}" TextWrapping="Wrap" Foreground="#65756F"/><Button Content="Câu tiếp theo" Command="{Binding NextLessonCommand}" HorizontalAlignment="Left" Margin="0,12,0,0"/></StackPanel>
                  <TextBlock Text="Đã hoàn thành các câu đến lượt ôn. Bạn có thể ôn từ vựng." TextWrapping="Wrap"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding CurrentLesson}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                </StackPanel></Border>
                <Border Style="{StaticResource TranscriptCard}" Padding="20" Margin="0,0,0,16"><StackPanel>
                    <TextBlock Text="Áp dụng vào tình huống thật" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="Luyện hội thoại theo mục tiêu hoặc ôn câu đã lưu trong Sổ tay." Foreground="#65756F" TextWrapping="Wrap" Margin="0,10"/>
                    <WrapPanel><Button Content="Luyện hội thoại theo mục tiêu" Click="PracticeConversation_Click" Margin="0,0,12,8"/><Button Content="Chọn câu từ Sổ tay" Click="ImportNotebook_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,0,8"/></WrapPanel>
                    <TextBlock Text="Hội thoại đang có được giữ nguyên. Bấm Bắt đầu trong màn hình hội thoại khi bạn sẵn sàng." Foreground="#65756F" FontSize="11" TextWrapping="Wrap"/>
                </StackPanel></Border>
                <Border Background="White" BorderBrush="#D8E5E1" BorderThickness="1" CornerRadius="16" Padding="24"><StackPanel>
                    <TextBlock Text="Câu mẫu hôm nay" Foreground="#287568" FontWeight="Bold" />
                    <TextBlock Text="{Binding DailySentence.OriginalText}" FontSize="18" Foreground="#243D35" TextWrapping="Wrap" Margin="0,12,0,6" />
                    <TextBlock Text="{Binding DailySentence.Reading}" Foreground="#65756F" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding DailySentence.VietnameseMeaning}" Foreground="#287568" TextWrapping="Wrap" Margin="0,12" />
                    <TextBlock Text="{Binding DailySentence.ContextNote}" Foreground="#65756F" TextWrapping="Wrap" />
                    <Button Content="Nghe câu mẫu" Command="{Binding SpeakDailyCommand}" HorizontalAlignment="Left" Margin="0,16,0,0" Style="{StaticResource SecondaryButton}" />
                </StackPanel></Border>
            </StackPanel>
        </ScrollViewer>
        <ScrollViewer x:Name="PracticePanel" Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
            <ItemsControl ItemsSource="{Binding Scenarios}"><ItemsControl.ItemTemplate><DataTemplate>
                <Border Background="White" BorderBrush="#D8E5E1" BorderThickness="1" CornerRadius="16" Padding="20" Margin="0,0,0,16"><StackPanel>
                    <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="Bold" Foreground="#243D35" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Description}" Foreground="#65756F" TextWrapping="Wrap" Margin="0,10" />
                    <ItemsControl ItemsSource="{Binding Dialogues}"><ItemsControl.ItemTemplate><DataTemplate>
                        <Border Background="#F5F8F7" CornerRadius="10" Padding="14" Margin="0,4"><DockPanel>
                            <Button DockPanel.Dock="Right" Content="Nghe" Margin="12,0,0,0" VerticalAlignment="Center" Command="{Binding DataContext.SpeakDialogueCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource SecondaryButton}" />
                            <StackPanel><TextBlock Text="{Binding Speaker}" Foreground="#287568" FontWeight="Bold" /><TextBlock Text="{Binding Original}" Foreground="#243D35" TextWrapping="Wrap" FontSize="16" Margin="0,6" /><TextBlock Text="{Binding Reading}" Foreground="#65756F" TextWrapping="Wrap" /><TextBlock Text="{Binding Translation}" Foreground="#287568" TextWrapping="Wrap" Margin="0,6,0,0" /></StackPanel>
                        </DockPanel></Border>
                    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                </StackPanel></Border>
            </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        </ScrollViewer>



        <Grid x:Name="VocabularyLibrary" Grid.Row="1" Visibility="Collapsed">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,12">
                <Button DockPanel.Dock="Right" Content="Ôn Flashcard" Click="StartReview_Click" Margin="16,0,0,0"/>
                <StackPanel><TextBlock Text="Kho từ vựng của bạn" FontSize="18" FontWeight="SemiBold" Foreground="#243D35"/><TextBlock Text="Lưu từ bản dịch, cuộc họp hoặc nhập thủ công kèm câu ví dụ." Foreground="#65756F" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel>
            </DockPanel>
            <Border Grid.Row="1" Background="White" BorderBrush="#BDD9D2" BorderThickness="1" CornerRadius="16"><ContentControl x:Name="VocabularyLibraryHost"/></Border>
        </Grid>
        <Grid x:Name="VocabTabGrid" Grid.Row="1" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>


            <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#BDD9D2" BorderThickness="1" CornerRadius="16" Padding="24" Margin="0,0,16,0" Cursor="Hand" MouseLeftButtonDown="Flashcard_Click">
                <DockPanel>
                    <Button DockPanel.Dock="Top" Content="← Kho từ vựng" Click="BackToVocabulary_Click" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,0,0,16"/><TextBlock DockPanel.Dock="Top" Text="THẺ TỪ VỰNG (NHẤP ĐỂ LẬT)" FontSize="11" FontWeight="Bold" Foreground="#73827C" HorizontalAlignment="Center" />


                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                        <Button Content="🔊 Phát âm" Command="{Binding SpeakCurrentWordCommand}" Background="#287568" Foreground="White" Padding="14,6" Margin="0,0,8,0" Cursor="Hand" />
                        <Button Content="Xóa từ" Style="{StaticResource DestructiveButton}" Command="{Binding DeleteWordCommand}" Foreground="#C84343" Background="#FFF1F1" BorderBrush="#F3BABA" Margin="0,0,8,0" />
                        <Button Content="🔄 Lật thẻ" Command="{Binding FlipFlashcardCommand}" Background="#D8E5E1" Foreground="#243D35" Padding="14,6" Cursor="Hand" />
                    </StackPanel>

                    <WrapPanel DockPanel.Dock="Bottom" HorizontalAlignment="Center" Margin="0,8" IsEnabled="{Binding IsFlashcardFlipped}">
                        <Button Content="Quên" Command="{Binding GradeReviewCommand}" CommandParameter="Again" Background="#FFF1F1" Foreground="#C84343" BorderBrush="#F3BABA" Margin="2" />
                        <Button Content="Khó" Command="{Binding GradeReviewCommand}" CommandParameter="Hard" Margin="2" />
                        <Button Content="Nhớ" Command="{Binding GradeReviewCommand}" CommandParameter="Good" Margin="2" />
                        <Button Content="Dễ" Command="{Binding GradeReviewCommand}" CommandParameter="Easy" Margin="2" />
                    </WrapPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Thêm từ mới hoặc chọn một từ để bắt đầu ôn tập." TextWrapping="Wrap" Foreground="#65756F" Margin="0,16">
                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding SelectedWord}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                    </TextBlock>

                    <Grid VerticalAlignment="Center" HorizontalAlignment="Center">

                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFlashcardFlipped}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="{Binding SelectedWord.Word}" FontSize="28" FontWeight="Bold" Foreground="#243D35" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding SelectedWord.Phonetic}" FontSize="15" Foreground="#65756F" HorizontalAlignment="Center" Margin="0,6,0,0" />
                        </StackPanel>


                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFlashcardFlipped}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="{Binding SelectedWord.Meaning}" FontSize="20" FontWeight="Bold" Foreground="#287568" HorizontalAlignment="Center" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding SelectedWord.ExampleSentence}" FontSize="13" Foreground="#334B43" HorizontalAlignment="Center" Margin="0,10,0,0" />
                        </StackPanel>
                    </Grid>
                </DockPanel>
            </Border>


            <Border Grid.Column="1" Background="#FFFFFF" BorderBrush="#BDD9D2" BorderThickness="1" CornerRadius="16" Padding="16">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                        <TextBlock Text="Danh sách từ vựng" FontSize="15" FontWeight="Bold" Foreground="#243D35" />
                    </Grid>

                    <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                        <TextBlock Text="Thêm từ vựng" FontWeight="Bold" Foreground="#243D35" />
                        <TextBlock Text="Từ hoặc cụm từ" Foreground="#65756F" FontSize="12" Margin="0,10,0,0" /><TextBox Text="{Binding NewWord, UpdateSourceTrigger=PropertyChanged}" ToolTip="Từ hoặc cụm từ" Margin="0,8,0,6" />
                        <TextBlock Text="Phiên âm · Không bắt buộc" Foreground="#65756F" FontSize="12" Margin="0,4,0,6" /><TextBox Text="{Binding NewPhonetic, UpdateSourceTrigger=PropertyChanged}" ToolTip="Phiên âm (không bắt buộc)" Margin="0,0,0,6" />
                        <TextBlock Text="Nghĩa tiếng Việt" Foreground="#65756F" FontSize="12" Margin="0,4,0,6" /><TextBox Text="{Binding NewMeaning, UpdateSourceTrigger=PropertyChanged}" ToolTip="Nghĩa tiếng Việt" Margin="0,0,0,8" />
                        <Button Content="Thêm từ" Command="{Binding AddWordCommand}" HorizontalAlignment="Left" />
                    </StackPanel>
                    <ListBox ItemsSource="{Binding VisibleVocabulary}" SelectedItem="{Binding SelectedWord}" Background="Transparent" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#F5F8F7" CornerRadius="8" Padding="12" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <WrapPanel>
                                                <TextBlock Text="{Binding Word}" TextWrapping="Wrap" FontSize="15" FontWeight="Bold" Foreground="#243D35" />
                                                <TextBlock Text="{Binding Phonetic}" FontSize="12" Foreground="#73827C" Margin="8,2,0,0" />
                                            </WrapPanel>
                                            <TextBlock Text="{Binding Meaning}" TextWrapping="Wrap" FontSize="13" Foreground="#287568" Margin="0,2,0,0" />
                                            <TextBlock Text="{Binding ExampleSentence}" TextWrapping="Wrap" FontSize="12" Foreground="#65756F" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>


        <Border x:Name="AlphabetTabBorder" Grid.Row="1" Background="#FFFFFF" CornerRadius="16" Padding="20" Visibility="Collapsed">
            <DockPanel>
                <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,12"><CheckBox Content="Katakana (tiếng Nhật)" IsChecked="{Binding IsKatakana}" Visibility="{Binding IsJapanese, Converter={StaticResource BoolVisibility}}" Foreground="#243D35" Margin="0,8,16,0" /><Button Content="Cùng Chip Chip" Command="{Binding LearnWithChipChipCommand}" /><Button Content="Dừng" Command="{Binding StopPronunciationCommand}" Margin="8,0" /></WrapPanel>
                <TextBlock DockPanel.Dock="Bottom" Text="{Binding Status}" Foreground="#9ED9C7" TextWrapping="Wrap" />
                <TextBlock DockPanel.Dock="Top" Text="Chữ &amp; Phát âm · Bấm để nghe bản ghi" FontSize="15" FontWeight="Bold" Foreground="#243D35" Margin="0,0,0,14" />

                <ListBox ItemsSource="{Binding AlphabetList}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Width="160" Height="100" Background="#F5F8F7" BorderBrush="#D8E5E1" BorderThickness="1" CornerRadius="10" Padding="10" Margin="6" Cursor="Hand" MouseLeftButtonDown="AlphabetItem_Click">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding Character}" FontSize="24" FontWeight="Bold" Foreground="#287568" HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding Transcription}" FontSize="12" Foreground="#65756F" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                    <TextBlock Text="{Binding Example}" FontSize="10" Foreground="#73827C" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>
    <Popup x:Name="LearningGoalPopup" PlacementTarget="{Binding ElementName=LearningGoalButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True"><Border Width="320" Background="White" BorderBrush="#75BBAE" BorderThickness="1" CornerRadius="12" Padding="20"><StackPanel><TextBlock Text="Mục tiêu học mỗi ngày" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,14" /><TextBlock Text="Mục tiêu" Margin="0,0,0,8"/><ComboBox ItemsSource="{Binding LearningGoals}" SelectedItem="{Binding LearningGoal}" Margin="0,0,0,12"/><TextBlock Text="Trình độ" Margin="0,0,0,8"/><ComboBox ItemsSource="{Binding LearningLevels}" SelectedItem="{Binding LearningLevel}" Margin="0,0,0,12"/><TextBlock Text="Thời gian học mỗi ngày" Foreground="#65756F" Margin="0,0,0,8"/><ComboBox ItemsSource="{Binding DailyMinuteOptions}" SelectedItem="{Binding DailyMinutes}" Margin="0,0,0,12"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding StringFormat={}{0} phút}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox><Button Content="Lưu mục tiêu" Command="{Binding SaveGoalCommand}" />
                </StackPanel></Border></Popup></Grid>
</UserControl>
