<UserControl x:Class="TransTools.Views.TextReaderView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <StackPanel><TextBlock Text="Đọc văn bản" FontSize="24" FontWeight="Bold" Foreground="#243D35"/><WrapPanel Margin="0,16"><ComboBox ItemsSource="{Binding Languages}" ItemTemplate="{StaticResource LanguageItem}" SelectedItem="{Binding Language}" Width="130" Margin="0,0,8,0"/><ComboBox ItemsSource="{Binding Engines}" SelectedItem="{Binding Engine}" Width="160"/><TextBlock Text="Tốc độ" Foreground="#65756F" Margin="16,8"/><Slider IsEnabled="{Binding CanChangeRate}" ToolTip="VieNeu dùng tốc độ gốc; chọn Edge hoặc Supertonic để thay đổi tốc độ." Minimum="0.7" Maximum="1.5" Value="{Binding Rate}" Width="160"/></WrapPanel></StackPanel>
 <TextBox Grid.Row="1" Text="{Binding Text,UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="18" FontSize="16" Background="#FFFFFF" Foreground="#172B36" BorderBrush="#75BBAE" BorderThickness="1.5"/>
 <StackPanel Grid.Row="2" Margin="0,12,0,0"><WrapPanel><Button Content="Đọc" Command="{Binding ReadCommand}" Margin="0,0,8,0"/><Button Content="Dừng" Command="{Binding StopCommand}" Margin="0,0,8,0"/><Button Content="Lưu audio" Command="{Binding ExportCommand}" IsEnabled="{Binding CanExport}"/></WrapPanel><TextBlock Text="{Binding Status}" Foreground="#65756F" Margin="0,8"/></StackPanel>
 </Grid>
</UserControl>
