<UserControl x:Class="TransTools.Views.TextReaderView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <StackPanel Margin="0,4,0,18">
  <TextBlock Text="Đọc văn bản" FontSize="22" FontWeight="SemiBold" Foreground="#243D35"/>
  <TextBlock Text="Nghe văn bản với giọng và tốc độ phù hợp với bạn" Foreground="#65756F" Margin="0,4,0,18"/>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBlock Text="Ngôn ngữ đọc" VerticalAlignment="Center" Margin="0,0,12,0"/>
   <ComboBox Grid.Column="1" IsEnabled="{Binding CanConfigureReader}" ItemsSource="{Binding Languages}" ItemTemplate="{StaticResource LanguageItem}" SelectedItem="{Binding Language}" Width="230"/>
   <Button Grid.Column="3" x:Name="ReadingOptionsButton" Content="Tùy chỉnh đọc" Style="{StaticResource SecondaryButton}" Click="ShowReadingOptions_Click"/>
  </Grid>
  <Popup x:Name="ReadingOptionsPopup" PlacementTarget="{Binding ElementName=ReadingOptionsButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
   <Border Background="White" BorderBrush="#B5D2C9" BorderThickness="1" CornerRadius="12" Padding="20" Width="420">
    <StackPanel><TextBlock Text="Tùy chỉnh đọc" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,18"/>
     <TextBlock Text="Bộ giọng" Margin="0,0,0,8"/>
     <ComboBox IsEnabled="{Binding CanConfigureReader}" ItemsSource="{Binding Engines}" SelectedItem="{Binding Engine}"/>
     <Grid Margin="0,18,0,8"><TextBlock Text="Tốc độ đọc"/><TextBlock Text="{Binding Rate,StringFormat={}{0:0.0}×}" HorizontalAlignment="Right" Foreground="#287568"/></Grid>
     <Slider IsEnabled="{Binding CanChangeRate}" ToolTip="VieNeu dùng tốc độ gốc; chọn Edge hoặc Supertonic để thay đổi tốc độ." Minimum="0.7" Maximum="1.5" Value="{Binding Rate}"/>
     <CheckBox IsEnabled="{Binding CanConfigureReader}" IsChecked="{Binding NormalizeReading}" Margin="0,18,0,8"><TextBlock Text="Chuẩn hóa cách đọc"/></CheckBox>
     <TextBlock Text="Chuẩn hóa số, ngày giờ và viết tắt; dùng AI khi đã cấu hình. Giữ nguyên văn bản gốc." TextWrapping="Wrap" Foreground="#65756F" FontSize="12"/>
    </StackPanel>
   </Border>
  </Popup>
 </StackPanel>
 <Border Grid.Row="1" Background="White" BorderBrush="#C2DDD5" BorderThickness="1" CornerRadius="14" Padding="18">
  <DockPanel><TextBlock DockPanel.Dock="Top" Text="Văn bản cần đọc" FontWeight="SemiBold" Margin="0,0,0,12"/>
   <TextBox Text="{Binding Text,UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="0" FontSize="16" Background="Transparent" Foreground="#243D35" BorderThickness="0"/>
  </DockPanel>
 </Border>
 <StackPanel Grid.Row="2" Margin="0,16,0,0"><WrapPanel><Button Content="Đọc văn bản" Command="{Binding ReadCommand}" Margin="0,0,8,0"/><Button Content="Dừng" Style="{StaticResource SecondaryButton}" Command="{Binding StopCommand}" Margin="0,0,8,0"/><Button Content="Lưu audio" Style="{StaticResource SecondaryButton}" Command="{Binding ExportCommand}" IsEnabled="{Binding CanExport}"/></WrapPanel><TextBlock Text="{Binding Status}" Foreground="#65756F" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel>
 </Grid>
</UserControl>
