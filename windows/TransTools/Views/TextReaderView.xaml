<UserControl x:Class="TransTools.Views.TextReaderView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <UserControl.Resources>
  <Style x:Key="ReaderCard" TargetType="Border" BasedOn="{StaticResource TranscriptCard}">
   <Setter Property="Padding" Value="20"/><Setter Property="CornerRadius" Value="18"/>
   <Style.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="#287568"/></Trigger></Style.Triggers>
  </Style>
 </UserControl.Resources>
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <StackPanel Margin="0,4,0,18"><TextBlock Text="Đọc văn bản" FontSize="17" FontWeight="Bold"/><TextBlock Text="Nghe văn bản hoặc chọn truyện từ thư viện" FontSize="11" Foreground="#65756F" Margin="0,8,0,16"/>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel Orientation="Horizontal"><TextBlock Text="Ngôn ngữ đọc" VerticalAlignment="Center" Margin="0,0,12,0"/><ComboBox IsEnabled="{Binding CanConfigureReader}" ItemsSource="{Binding Languages}" ItemTemplate="{StaticResource LanguageItem}" SelectedItem="{Binding Language}" Width="230" Height="40" MinHeight="40" Margin="0"/></StackPanel>
   <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="LibraryButton" Style="{StaticResource SecondaryButton}" IsEnabled="{Binding CanConfigureReader}" Click="ShowLibrary_Click" Margin="0,0,12,0" AutomationProperties.Name="Thư viện truyện"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8F1;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBlock Text="Thư viện truyện" VerticalAlignment="Center"/></StackPanel></Button><Button x:Name="ReadingOptionsButton" Style="{StaticResource SecondaryButton}" Click="ShowReadingOptions_Click" AutomationProperties.Name="Tùy chỉnh đọc"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE9E9;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBlock Text="Tùy chỉnh đọc" VerticalAlignment="Center"/></StackPanel></Button></StackPanel>
  </Grid>
  <DockPanel Margin="0,12,0,0" Visibility="{Binding HasStory,Converter={StaticResource BoolVisibility}}"><Button DockPanel.Dock="Right" Content="Xem nguồn" Click="ShowSource_Click" Style="{StaticResource SecondaryButton}" MinHeight="28" Padding="8,4"/><TextBlock Text="{Binding Story.Title}" FontWeight="SemiBold" Foreground="#65756F" VerticalAlignment="Center"/></DockPanel>
  <Popup x:Name="ReadingOptionsPopup" PlacementTarget="{Binding ElementName=ReadingOptionsButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
   <Border Background="White" BorderBrush="#B5D2C9" BorderThickness="1" CornerRadius="12" Padding="20" Width="420">
    <StackPanel><TextBlock Text="Tùy chỉnh đọc" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,18"/>
     <TextBlock Text="Bộ giọng" Margin="0,0,0,8"/>
     <ComboBox IsEnabled="{Binding CanConfigureReader}" ItemsSource="{Binding Engines}" SelectedItem="{Binding Engine}"/>
     <Grid Margin="0,18,0,8"><TextBlock Text="Tốc độ đọc"/><TextBlock Text="{Binding Rate,StringFormat={}{0:0.0}×}" HorizontalAlignment="Right" Foreground="#287568"/></Grid>
     <Slider IsEnabled="{Binding CanChangeRate}" ToolTip="VieNeu dùng tốc độ gốc; chọn Edge hoặc Supertonic để thay đổi tốc độ." Minimum="0.7" Maximum="1.5" Value="{Binding Rate}"/>
     <Grid Margin="0,18,0,8"><TextBlock Text="Nghỉ giữa câu"/><TextBlock Text="{Binding SentencePause,StringFormat={}{0:0.0} s}" HorizontalAlignment="Right" Foreground="#287568"/></Grid>
     <Slider x:Name="SentencePauseSlider" IsEnabled="{Binding CanConfigureReader}" Minimum="0" Maximum="2" TickFrequency=".1" IsSnapToTickEnabled="True" Value="{Binding SentencePause}"/>
     <Grid Margin="0,18,0,8"><TextBlock Text="Nghỉ giữa đoạn"/><TextBlock Text="{Binding ParagraphPause,StringFormat={}{0:0.0} s}" HorizontalAlignment="Right" Foreground="#287568"/></Grid>
     <Slider x:Name="ParagraphPauseSlider" IsEnabled="{Binding CanConfigureReader}" Minimum="0" Maximum="4" TickFrequency=".1" IsSnapToTickEnabled="True" Value="{Binding ParagraphPause}"/>
     <TextBlock Text="Thời gian nghỉ áp dụng khi nghe tại đây. File audio dùng nhịp nghỉ của bộ giọng." Foreground="#65756F" FontSize="12" TextWrapping="Wrap" Margin="0,14,0,0"/>
     <DockPanel Margin="0,18,0,8"><CheckBox DockPanel.Dock="Right" Style="{StaticResource SettingsSwitch}" AutomationProperties.Name="Chuẩn hóa cách đọc" IsEnabled="{Binding CanConfigureReader}" IsChecked="{Binding NormalizeReading}"/><TextBlock Text="Chuẩn hóa cách đọc" VerticalAlignment="Center"/></DockPanel>
     <TextBlock Text="Chuẩn hóa số, ngày giờ và viết tắt; dùng AI khi đã cấu hình. Giữ nguyên văn bản gốc." TextWrapping="Wrap" Foreground="#65756F" FontSize="12"/>
    </StackPanel>
   </Border>
  </Popup>
 </StackPanel>
 <Border Grid.Row="1" Style="{StaticResource ReaderCard}">
  <DockPanel><DockPanel DockPanel.Dock="Top" Margin="0,0,0,12"><Button DockPanel.Dock="Right" Content="Xóa" Command="{Binding ClearTextCommand}" Style="{StaticResource SecondaryButton}" MinHeight="28" Padding="8,4"/><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="&#xE8E4;" FontFamily="Segoe MDL2 Assets" Margin="0,0,8,0" VerticalAlignment="Center"/><TextBlock Text="Văn bản cần đọc" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel></DockPanel>
   <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0"><DockPanel LastChildFill="True"><TextBlock DockPanel.Dock="Right" Text="Chọn truyện hoặc nhập nội dung của bạn" FontSize="11" Foreground="#73827C" Margin="16,0,0,0"/><TextBlock Text="{Binding CharacterCountLabel}" FontSize="11"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#73827C"/><Style.Triggers><DataTrigger Binding="{Binding IsTooLong}" Value="True"><Setter Property="Foreground" Value="#DC2626"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></DockPanel><TextBlock Text="Chia văn bản thành phần không quá 5.000 ký tự để nghe hoặc lưu audio." Foreground="#DC2626" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0" Visibility="{Binding IsTooLong,Converter={StaticResource BoolVisibility}}"/></StackPanel>
   <Grid MinHeight="220"><TextBox x:Name="ReadingTextEditor" Text="{Binding Text,UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsBusy}" VerticalContentAlignment="Top" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="10" FontSize="17" Background="Transparent" Foreground="#243D35" BorderThickness="0" AutomationProperties.Name="Đoạn văn cần đọc thành audio"><TextBox.Template><ControlTemplate TargetType="TextBox"><ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/></ControlTemplate></TextBox.Template></TextBox>
<TextBlock Text="Nhập hoặc dán đoạn văn ở đây…&#x0a;Chọn ngôn ngữ đúng với nội dung để nghe phát âm." Margin="16" FontSize="17" Foreground="#8B9691" TextWrapping="Wrap" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text,ElementName=ReadingTextEditor}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
  </DockPanel>
 </Border>
 <StackPanel Grid.Row="2" Margin="0,16,0,0"><WrapPanel><Button Command="{Binding ReadCommand}" Margin="0,0,8,0" AutomationProperties.Name="Đọc văn bản"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBlock Text="Đọc văn bản" VerticalAlignment="Center"/></StackPanel></Button><Button Style="{StaticResource SecondaryButton}" IsEnabled="{Binding IsBusy}" Command="{Binding StopCommand}" Margin="0,0,8,0" AutomationProperties.Name="Dừng"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE71A;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBlock Text="Dừng" VerticalAlignment="Center"/></StackPanel></Button><Button Style="{StaticResource SecondaryButton}" Command="{Binding ExportCommand}" IsEnabled="{Binding CanExport}" AutomationProperties.Name="Lưu audio"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBlock Text="Lưu audio" VerticalAlignment="Center"/></StackPanel></Button></WrapPanel><TextBlock Text="{Binding Status}" Foreground="#65756F" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel>
 </Grid>
</UserControl>
